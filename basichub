-- Get HRP
local function GetHRP()
    local char = LocalPlayer.Character
    if char then return char:FindFirstChild("HumanoidRootPart") end
    return nil
end

-- Check if has ball
local function HasBall()
    local char = LocalPlayer.Character
    if not char then return false end
    return char:FindFirstChild("Basketball") ~= nil
end

-- Get Speed
local function GetSpeed()
    if HasBall() then
        return ScriptSettings.SpeedSteal
    else
        return ScriptSettings.SpeedNormal
    end
end

-- Create BodyVelocity
local function CreateVelocity()
    local hrp = GetHRP()
    if not hrp then return nil end
    
    if CurrentVel then CurrentVel:Destroy() end
    
    -- Clear old
    for _, v in pairs(hrp:GetChildren()) do
        if v:IsA("BodyVelocity") or v:IsA("BodyGyro") then
            v:Destroy()
        end
    end
    
    local vel = Instance.new("BodyVelocity")
    vel.MaxForce = Vector3.new(400000, 400000, 400000)
    vel.Velocity = Vector3.zero
    vel.P = 10000
    vel.Parent = hrp
    
    CurrentVel = vel
    return vel
end

local function RemoveVelocity()
    if CurrentVel then
        CurrentVel:Destroy()
        CurrentVel = nil
    end
end

-- Move with BodyVelocity
local function MoveToPoint(target)
    if not CurrentVel then return false end
    
    local hrp = GetHRP()
    if not hrp then return false end
    
    local distance = (target - hrp.Position).Magnitude
    if distance < 2 then
        CurrentVel.Velocity = Vector3.zero
        return true -- وصل
    end
    
    local direction = (target - hrp.Position).Unit
    local speed = GetSpeed()
    
    CurrentVel.Velocity = direction * speed
    return false -- لسه ما وصل
end

-- Steal
local function TrySteal()
    local ball = Workspace:FindFirstChild("Basketball")
    if not ball then return end
    local owner = ball:FindFirstChild("Owner")
    if not owner or owner.Value == LocalPlayer then return end
    
    for i = 1, 5 do
        pcall(function()
            ReplicatedStorage.Events.BallEvent:FireServer("Grab", ball)
        end)
        task.wait(0.02)
    end
end

-- Desync Functions
function FastRespawn()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    
    hrp.Velocity = Vector3.new(0, 5000, 0)
    hrp.RotVelocity = Vector3.new(99999, 99999, 99999)
    
    task.delay(0.05, function()
        if hum then hum:ChangeState(Enum.HumanoidStateType.Dead) end
    end)
end

local function SetDesync(state)
    if typeof(rnet) == "table" then
        pcall(function()
            if rnet.setdesync then rnet.setdesync(state) end
            if rnet.desync then rnet.desync(state) end
        end)
    end
    if typeof(delta) == "table" then
        pcall(function()
            if delta.raknet_desync then delta.raknet_desync(state) end
            if delta.desync then delta.desync(state) end
        end)
    end
end

local function SendFakePosition(pos)
    local cf = CFrame.new(pos)
    if typeof(rnet) == "table" then
        pcall(function()
            if rnet.sendphysics then rnet.sendphysics(cf) end
            if rnet.sendposition then rnet.sendposition(pos) end
        end)
    end
    if typeof(delta) == "table" then
        pcall(function()
            if delta.sendphysics then delta.sendphysics(cf) end
            if delta.sendposition then delta.sendposition(pos) end
        end)
    end
end

