--// FOHUB Smart Update
local function ShouldUpdateAnchor(realPos)
    if not LastAnchorPosition then return true end
    local now = tick()
    local timePassed = now - LastUpdateTime
    if timePassed >= FOHUB.UpdateInterval then return true, "time" end
    local distance = (realPos - LastAnchorPosition).Magnitude
    if distance >= FOHUB.MaxDistance then return true, "distance" end
    return false
end

local function GetUpdatedAnchor(realPos)
    local shouldUpdate, reason = ShouldUpdateAnchor(realPos)
    if shouldUpdate then
        LastAnchorPosition = realPos
        LastUpdateTime = tick()
        if reason == "time" then print("[FOHUB] Snap: 2s") elseif reason == "distance" then print("[FOHUB] Snap: 5st") end
    end
    return LastAnchorPosition
end

--// Insta Steal System
local function ToggleSteal()
    StealEnabled = not StealEnabled
    
    if StealEnabled then
        StealConnection = task.spawn(function()
            while StealEnabled do
                task.wait(0.15) -- 0.15s (سريع بس مش مريب)
                
                pcall(function()
                    -- سرقة الحيوانات
                    local plots = Workspace:FindFirstChild("Plots")
                    if plots then
                        for _, plot in pairs(plots:GetChildren()) do
                            local podiums = plot:FindFirstChild("AnimalPodiums")
                            if podiums then
                                for _, podium in pairs(podiums:GetChildren()) do
                                    local base = podium:FindFirstChild("Base")
                                    local spawn = base and base:FindFirstChild("Spawn")
                                    local att = spawn and spawn:FindFirstChild("PromptAttachment")
                                    if att then
                                        for _, prompt in pairs(att:GetChildren()) do
                                            if prompt:IsA("ProximityPrompt") then
                                                prompt.HoldDuration = 0.05 -- سريع
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                    
                    -- سرقة الكرة
                    local ball = Workspace:FindFirstChild("Basketball")
                    if ball then
                        local owner = ball:FindFirstChild("Owner")
                        if owner and owner.Value ~= LocalPlayer then
                            if ReplicatedStorage:FindFirstChild("Events") and ReplicatedStorage.Events:FindFirstChild("BallEvent") then
                                ReplicatedStorage.Events.BallEvent:FireServer("Grab", ball)
                            end
                        end
                    end
                end)
            end
        end)
        
        Notify("FR HUB", "Insta Steal ON", 2)
        print("[Steal] ON - 0.15s")
    else
        StealEnabled = false
        Notify("FR HUB", "Insta Steal OFF", 2)
        print("[Steal] OFF")
    end
    
    return StealEnabled
end

--// Toggle Desync
local function ToggleDesync()
    DesyncEnabled = not DesyncEnabled
    
    if DesyncEnabled then
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        
        if hrp then
            LastAnchorPosition = hrp.Position
            LastUpdateTime = tick()
            TargetServerPosition = LastAnchorPosition
        end
        
        SetDesync(true)
        Notify("FR HUB", "FOHUB Desync ON | 2s/5st", 2)
        
        if ServerPosPart and TargetServerPosition then
            ServerPosPart.CFrame = CFrame.new(TargetServerPosition)
        end
        
        local lastSend = 0
        Connection_RenderStepped = RunService.Heartbeat:Connect(function()
            local now = tick()
            
            pcall(function()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                
                local realPos = hrp.Position
                local anchor = GetUpdatedAnchor(realPos)
                TargetServerPosition = anchor
                
                if ServerPosPart then
                    ServerPosPart.CFrame = CFrame.new(TargetServerPosition)
                end
            end)
            
            if now - lastSend >= FOHUB.SendRate then
                lastSend = now
                if TargetServerPosition then
                    SendFakePosition(TargetServerPosition)
                end
            end
        end)
        
        CharacterAddedConnection = LocalPlayer.CharacterAdded:Connect(function(newChar)
            if not DesyncEnabled then return end
            local hrp = newChar:WaitForChild("HumanoidRootPart", 2)
            if not hrp then return end
            SetDesync(true)
            LastAnchorPosition = hrp.Position
            LastUpdateTime = tick()
            TargetServerPosition = LastAnchorPosition
            
            task.spawn(function()
                local last = 0
                while DesyncEnabled and newChar.Parent do
                    local now = tick()
                    if now - last >= FOHUB.SendRate then
                        last = now
                        if TargetServerPosition then
                            SendFakePosition(TargetServerPosition)
                        end
                    end
                    task.wait(0.01)
                end
            end)
        end)
        
    else
        SetDesync(false)
        if Connection_RenderStepped then Connection_RenderStepped:Disconnect() Connection_RenderStepped = nil end
        if CharacterAddedConnection then CharacterAddedConnection:Disconnect() CharacterAddedConnection = nil end
        LastAnchorPosition = nil
        TargetServerPosition = nil
        if ServerPosPart then ServerPosPart.CFrame = CFrame.new(0, -1000, 0) end
        Notify("FR HUB", "FOHUB Desync OFF", 2)
    end
end

