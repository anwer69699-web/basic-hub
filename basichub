-- Functions
local function getHrp()
    local c = LocalPlayer.Character
    if c then return c:FindFirstChild("HumanoidRootPart") end
    return nil
end

-- AsLinearVelocity - الأفضل للجوال
local function makeVel()
    local h = getHrp()
    if not h then return end
    
    -- حذف القديم
    if CurrentVel then
        CurrentVel:Destroy()
        CurrentVel = nil
    end
    
    -- حذف أي LinearVelocity موجود
    for _, v in pairs(h:GetChildren()) do
        if v:IsA("LinearVelocity") then
            v:Destroy()
        end
    end
    
    -- إنشاء AsLinearVelocity جديد
    local vel = Instance.new("LinearVelocity")
    vel.Attachment0 = h:FindFirstChild("RootAttachment") or h:FindFirstChild("Attachment")
    
    -- إذا ما فيه Attachment نسوي واحد
    if not vel.Attachment0 then
        local att = Instance.new("Attachment")
        att.Name = "RootAttachment"
        att.Parent = h
        vel.Attachment0 = att
    end
    
    vel.VectorVelocity = Vector3.zero
    vel.MaxForce = math.huge
    vel.LineDirection = Vector3.new(0, 0, 0)
    vel.LineVelocity = 0
    vel.Parent = h
    
    CurrentVel = vel
    return vel
end

local function delVel()
    if CurrentVel then
        CurrentVel:Destroy()
        CurrentVel = nil
    end
end

local function setVel(direction, speed)
    if not CurrentVel then return end
    CurrentVel.VectorVelocity = direction * speed
end

local function stopVel()
    if CurrentVel then
        CurrentVel.VectorVelocity = Vector3.zero
    end
end

local function steal()
    local ball = Workspace:FindFirstChild("Basketball")
    if not ball then return end
    local own = ball:FindFirstChild("Owner")
    if not own then return end
    if own.Value ~= LocalPlayer then
        for i = 1, 5 do
            pcall(function()
                ReplicatedStorage.Events.BallEvent:FireServer("Grab", ball)
            end)
        end
    end
end

