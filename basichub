local function SafeGetNumber(box, fallback, max)
    if not box or not box.Parent then return fallback end
    local txt = box.Text
    if type(txt) ~= "string" or txt == "" then return fallback end
    local num = tonumber(txt)
    if not num then return fallback end
    if num < 0 then num = 0 end
    if num > max then num = max end
    return num
end

