local function MakeFloatBtn(parent, text, x, y, w, h)
    local f = Instance.new("Frame") f.Name = text f.BackgroundColor3 = C.BG f.BackgroundTransparency = 0.5
    f.Size = UDim2.new(0, (w or 110)*SC, 0, (h or 42)*SC)
    f.Position = UDim2.new(1, -(x)*SC, 0, y*SC) f.Parent = parent
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 8)
    local st = Instance.new("UIStroke") st.Thickness = 2 st.Color = C.GRN st.Parent = f BorderGrad(st)
    local btn = Instance.new("TextButton") btn.Name = "Btn" btn.Text = text btn.TextColor3 = C.TXT btn.Font = Enum.Font.GothamBlack btn.TextSize = 13*SC btn.BackgroundTransparency = 1 btn.Size = UDim2.new(1, 0, 1, 0) btn.ZIndex = 5 btn.Parent = f TextGrad(btn)
    Hover(btn, Color3.fromRGB(20, 35, 20), C.BG) ClkFX(btn)
    local dragging, dragInput, dragStart, startPos = false, nil, nil, nil
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true dragStart = input.Position startPos = f.Position
            input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
        end
    end)
    btn.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
    end)
    S.UIS.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            f.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    task.spawn(function()
        while btn and btn.Parent and _G.ExtRunning and CoreActive do
            local isOn = btn:GetAttribute("On")
            if isOn then
                S.TS:Create(st, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Thickness = 3.5, Color = C.GRN}):Play()
                task.wait(0.8)
                S.TS:Create(st, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Thickness = 1.5, Color = C.GRN}):Play()
                task.wait(0.8)
            else
                S.TS:Create(st, TweenInfo.new(0.3), {Thickness = 2, Color = C.RED}):Play()
                task.wait(0.4)
            end
        end
    end)
    return btn, f, st
end

