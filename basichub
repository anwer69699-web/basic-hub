local function toggleLagger()
    if LAG_ST.LaggerOn then
        stopLagger()
        if ST.SpdMode ~= "NORMAL" then
            ST.SpdMode = "NORMAL"
            BX.J.Text = tostring(LIMITS.NORMAL_JUMP)
            UpdateMode()
        end
        Notify(L("lagger_title"), L("lagger_off"), 2, C.RED)
    else
        if ST.SpdMode ~= "LAGGER" then
            ST.SpdMode = "LAGGER"
            BX.J.Text = tostring(LIMITS.LAGGER_JUMP)
            UpdateMode()
        end
        startLagger()
        Notify(L("lagger_title"), L("lagger_on"), 2, C.MID_COL)
    end
    setToggleVisual(LAG_ST.LaggerOn)
end

