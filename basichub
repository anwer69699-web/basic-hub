local function IsStealing()
    return Player:GetAttribute("Stealing") == true
end

--// Auto System (Levix Exact)
local function StartAutoSystem()
    if Connections.Auto then return end
    
    Connections.Auto = RunService.Heartbeat:Connect(function()
        if not Settings.AutoLeft and not Settings.AutoRight then return end
        
        pcall(function()
            local hrp = GetHRP()
            local hum = GetHumanoid()
            if not hrp or not hum then return end
            
            local points = Settings.AutoLeft and LEFT_POINTS or RIGHT_POINTS
            
            if waitingForSteal then
                if IsStealing() or HasBall() then
                    waitingForSteal = false
                    autoPhase = "POINT_3"
                else
                    hum:Move(Vector3.zero, false)
                    hrp.AssemblyLinearVelocity = Vector3.new(0, hrp.AssemblyLinearVelocity.Y, 0)
                    return
                end
            end
            
            local currentPoint = points[autoPhase]
            if not currentPoint then
                autoPhase = "START"
                currentPoint = points.START
            end
            
            local targetPos = Vector3.new(currentPoint.X, hrp.Position.Y, currentPoint.Z)
            local dist = (targetPos - hrp.Position).Magnitude
            
            if dist < 2 then
                if autoPhase == "START" then
                    autoPhase = "POINT_2"
                elseif autoPhase == "POINT_2" then
                    waitingForSteal = true
                    hum:Move(Vector3.zero, false)
                    return
                elseif autoPhase == "POINT_3" then
                    autoPhase = "END"
                elseif autoPhase == "END" then
                    autoPhase = "START"
                    return
                end
            end
            
            local speed = IsStealing() and Settings.SpeedSteal or Settings.SpeedNormal
            local dir = (targetPos - hrp.Position).Unit
            dir = Vector3.new(dir.X, 0, dir.Z).Unit
            
            hrp.AssemblyLinearVelocity = Vector3.new(dir.X * speed, hrp.AssemblyLinearVelocity.Y, dir.Z * speed)
            hum:Move(dir, false)
        end)
    end)
end

local function StopAutoSystem()
    if Connections.Auto then
        Connections.Auto:Disconnect()
        Connections.Auto = nil
    end
    autoPhase = "START"
    waitingForSteal = false
    pcall(function()
        local hum = GetHumanoid()
        if hum then hum:Move(Vector3.zero, false) end
    end)
end

--// Insta Steal (FR HUB Exact)
task.spawn(function()
    while task.wait(0.1) do
        if not isInstaGrabActive then continue end
        
        pcall(function()
            local plots = Workspace:FindFirstChild("Plots")
            if plots then
                for _, plot in pairs(plots:GetChildren()) do
                    local podiums = plot:FindFirstChild("AnimalPodiums")
                    if podiums then
                        for _, podium in pairs(podiums:GetChildren()) do
                            local base = podium:FindFirstChild("Base")
                            local spawn = base and base:FindFirstChild("Spawn")
                            local att = spawn and spawn:FindFirstChild("PromptAttachment")
                            if att then
                                for _, prompt in pairs(att:GetChildren()) do
                                    if prompt:IsA("ProximityPrompt") then
                                        prompt.HoldDuration = 0.03
                                    end
                                end
                            end
                        end
                    end
                end
            end
            
            local ball = Workspace:FindFirstChild("Basketball")
            if ball then
                local owner = ball:FindFirstChild("Owner")
                if owner and owner.Value ~= Player then
                    if ReplicatedStorage:FindFirstChild("Events") and ReplicatedStorage.Events:FindFirstChild("BallEvent") then
                        ReplicatedStorage.Events.BallEvent:FireServer("Grab", ball)
                    end
                end
            end
        end)
    end
end)

--// Desync System (FR HUB Exact)
local function SetDesync(state)
    pcall(function()
        if typeof(rnet) == "table" then
            if rnet.setdesync then rnet.setdesync(state) end
            if rnet.desync then rnet.desync(state) end
        end
        if typeof(delta) == "table" then
            if delta.raknet_desync then delta.raknet_desync(state) end
            if delta.desync then delta.desync(state) end
        end
    end)
end

local function SendFakePosition(position)
    pcall(function()
        local cf = CFrame.new(position)
        if typeof(rnet) == "table" then
            if rnet.sendphysics then rnet.sendphysics(cf) end
            if rnet.sendposition then rnet.sendposition(position) end
        end
        if typeof(delta) == "table" then
            if delta.sendphysics then delta.sendphysics(cf) end
            if delta.sendposition then delta.sendposition(position) end
        end
    end)
end

local function FastRespawn()
    pcall(function()
        local char = Player.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then return end
        
        hrp.Velocity = Vector3.new(0, 5000, 0)
        hrp.RotVelocity = Vector3.new(99999, 99999, 99999)
        task.delay(0.05, function()
            if hum then hum:ChangeState(Enum.HumanoidStateType.Dead) end
        end)
    end)
end

