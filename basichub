--// ==================== [7] Insta Steal System ====================

local function StartInstaStealSystem()
    task.spawn(function()
        while task.wait(0.1) do
            if not Settings.InstaSteal then continue end
            
            pcall(function()
                local plots = Workspace:FindFirstChild("Plots")
                if not plots then return end
                
                for _, plot in pairs(plots:GetChildren()) do
                    local podiums = plot:FindFirstChild("AnimalPodiums")
                    if podiums then
                        for _, podium in pairs(podiums:GetChildren()) do
                            local base = podium:FindFirstChild("Base")
                            local spawn = base and base:FindFirstChild("Spawn")
                            local att = spawn and spawn:FindFirstChild("PromptAttachment")
                            
                            if att then
                                for _, prompt in pairs(att:GetChildren()) do
                                    if prompt:IsA("ProximityPrompt") then
                                        prompt.HoldDuration = 0.03
                                    end
                                end
                            end
                        end
                    end
                end
            end)
        end
    end)
end

StartInstaStealSystem()

--// ==================== [8] Galaxy Mode ====================

local galaxyVectorForce = nil
local galaxyAttachment = nil
local spaceHeld = false
local lastHopTime = 0
local originalJumpPower = 50

local function setupGalaxy()
    pcall(function()
        local c = LocalPlayer.Character
        if not c then return end
        local h = c:FindFirstChild("HumanoidRootPart")
        if not h then return end
        
        if galaxyVectorForce then galaxyVectorForce:Destroy() end
        if galaxyAttachment then galaxyAttachment:Destroy() end
        
        galaxyAttachment = Instance.new("Attachment")
        galaxyAttachment.Parent = h
        
        galaxyVectorForce = Instance.new("VectorForce")
        galaxyVectorForce.Attachment0 = galaxyAttachment
        galaxyVectorForce.ApplyAtCenterOfMass = true
        galaxyVectorForce.RelativeTo = Enum.ActuatorRelativeTo.World
        galaxyVectorForce.Force = Vector3.new(0, 0, 0)
        galaxyVectorForce.Parent = h
    end)
end

local function updateGalaxy()
    if not Settings.Galaxy or not galaxyVectorForce then return end
    local c = LocalPlayer.Character
    if not c then return end
    
    local mass = 0
    for _, p in ipairs(c:GetDescendants()) do
        if p:IsA("BasePart") then mass = mass + p:GetMass() end
    end
    
    local targetGravity = workspace.Gravity * (Settings.GalaxyGravityPercent / 100)
    galaxyVectorForce.Force = Vector3.new(0, mass * (workspace.Gravity - targetGravity) * 0.98, 0)
end

local function doMiniHop()
    if not Settings.Galaxy then return end
    pcall(function()
        local c = LocalPlayer.Character
        if not c then return end
        local h = c:FindFirstChild("HumanoidRootPart")
        local hum = c:FindFirstChildOfClass("Humanoid")
        if not h or not hum then return end
        
        if tick() - lastHopTime < Settings.GalaxyHopCooldown then return end
        lastHopTime = tick()
        
        if spaceHeld and hum.FloorMaterial == Enum.Material.Air then
            h.AssemblyLinearVelocity = Vector3.new(
                h.AssemblyLinearVelocity.X,
                Settings.GalaxyHopPower,
                h.AssemblyLinearVelocity.Z
            )
        end
    end)
end

--// ==================== [9] IMPROVED Invisibility System (Speed 35/20) ====================

local InvisibilityConnection = nil
local LastUpdateTime = 0
local UpdateInterval = 3
local TargetServerPosition = nil

local function SendFakePosition(position)
    local cf = CFrame.new(position)
    if typeof(rnet) == "table" then
        if rnet.sendphysics then pcall(function() rnet.sendphysics(cf) end) end
        if rnet.sendposition then pcall(function() rnet.sendposition(position) end) end
    end
    if typeof(delta) == "table" then
        if delta.sendphysics then pcall(function() delta.sendphysics(cf) end) end
        if delta.sendposition then pcall(function() delta.sendposition(position) end) end
    end
end

local function SetDesync(state)
    if state then
        if typeof(rnet) == "table" then
            if rnet.setdesync then pcall(function() rnet.setdesync(true) end) end
            if rnet.desync then pcall(function() rnet.desync(true) end) end
        end
        if typeof(delta) == "table" then
            if delta.raknet_desync then pcall(function() delta.raknet_desync(true) end) end
            if delta.desync then pcall(function() delta.desync(true) end) end
        end
    else
        if typeof(rnet) == "table" then
            if rnet.setdesync then pcall(function() rnet.setdesync(false) end) end
            if rnet.desync then pcall(function() rnet.desync(false) end) end
        end
        if typeof(delta) == "table" then
            if delta.raknet_desync then pcall(function() delta.raknet_desync(false) end) end
            if delta.desync then pcall(function() delta.desync(false) end) end
        end
    end
end

local function StartInvisibility()
    SetDesync(true)
    
    -- Get initial position
    pcall(function()
        local c = LocalPlayer.Character
        if c then
            local h = c:FindFirstChild("HumanoidRootPart")
            if h then
                TargetServerPosition = h.Position
                SendFakePosition(TargetServerPosition)
            end
        end
    end)
    
    InvisibilityConnection = RunService.RenderStepped:Connect(function()
        if not Settings.Invisibility then return end
        
        local currentTime = tick()
        
        pcall(function()
            local c = LocalPlayer.Character
            if not c then return end
            local h = c:FindFirstChild("HumanoidRootPart")
            if not h then return end
            
            -- Send fake position continuously
            if TargetServerPosition then
                SendFakePosition(TargetServerPosition)
            end
            
            -- Update position every 3 seconds
            if currentTime - LastUpdateTime >= UpdateInterval then
                LastUpdateTime = currentTime
                TargetServerPosition = h.Position
                SendFakePosition(TargetServerPosition)
            end
        end)
    end)
    
    Notify("FR HUB", "الاختفاء مفعل! تحديث كل 3 ثواني", 3)
end

local function StopInvisibility()
    if InvisibilityConnection then
        InvisibilityConnection:Disconnect()
        InvisibilityConnection = nil
    end
    SetDesync(false)
    TargetServerPosition = nil
    Notify("FR HUB", "الاختفاء متوقف", 2)
end

