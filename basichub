local function MakeMovingGradient(parent, speed)
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, C.GRN_DARK), ColorSequenceKeypoint.new(0.3, C.GRN),
        ColorSequenceKeypoint.new(0.5, C.GRN_BRIGHT), ColorSequenceKeypoint.new(0.7, C.GRN),
        ColorSequenceKeypoint.new(1, C.GRN_DARK)
    })
    g.Rotation = 0 g.Parent = parent
    task.spawn(function()
        local rot = 0
        while parent and parent.Parent and CoreActive do
            rot = rot + (speed or 40) * task.wait(0.03)
            if rot > 360 then rot = rot - 360 end
            pcall(function() g.Rotation = rot end)
        end
    end)
    return g
end

