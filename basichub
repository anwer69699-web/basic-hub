    textLabel.TextStrokeTransparency = 0
    textLabel.TextSize = 14
    textLabel.Font = Enum.Font.GothamBold
    textLabel.Parent = DesyncLabel
end

function StartDesyncBox()
    CreateDesyncBox()
    
    if DesyncConnection then DesyncConnection:Disconnect() end
    
    DesyncConnection = RunService.Heartbeat:Connect(function()
        if not Settings.ShowDesyncBox then
            if DesyncBox then DesyncBox.Visible = false end
            if DesyncLabel then DesyncLabel.Enabled = false end
            return
        end
        
        pcall(function()
            local c = LocalPlayer.Character
            if not c then return end
            local h = c:FindFirstChild("HumanoidRootPart")
            if not h then return end
            
            -- Get server position (updates every ~4 seconds naturally)
            local serverPos = h.Position
            
            -- Try to get actual server position from network
            pcall(function()
                if typeof(gethiddenproperty) == "function" then
                    local netPos = gethiddenproperty(h, "NetworkPosition")
                    if netPos then serverPos = netPos end
                end
            end)
            
            ServerPosition = serverPos
            
            -- Update box position continuously to follow real position
            if DesyncBox and DesyncBox.Parent then
                DesyncBox.CFrame = CFrame.new(serverPos)
                DesyncBox.Visible = true
            end
            
            if DesyncLabel and DesyncLabel.Parent then
                DesyncLabel.Adornee = DesyncBox
                DesyncLabel.Enabled = true
            end
        end)
    end)
end

function StopDesyncBox()
    if DesyncConnection then
        DesyncConnection:Disconnect()
        DesyncConnection = nil
    end
    if DesyncBox then
        DesyncBox:Destroy()
        DesyncBox = nil
    end
    if DesyncLabel then
        DesyncLabel:Destroy()
        DesyncLabel = nil
    end
end

