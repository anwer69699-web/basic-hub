    local function updateVisual(state, instant)
        isActive = state
        local info = instant and TweenInfo.new(0) or TweenInfo.new(0.2, Enum.EasingStyle.Quad)
        
        if state then
            TweenService:Create(btn, info, {BackgroundColor3 = Color3.fromRGB(40, 48, 65)}):Play()
            TweenService:Create(stroke, info, {Color = color, Transparency = 0.2}):Play()
            TweenService:Create(label, info, {TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
            TweenService:Create(switchFrame, info, {BackgroundColor3 = color}):Play()
            TweenService:Create(switchCircle, TweenInfo.new(0.2, Enum.EasingStyle.Back), {Position = UDim2.new(1, -16, 0.5, -7), BackgroundColor3 = Color3.fromRGB(255, 255, 255)}):Play()
            TweenService:Create(statusLine, info, {Size = UDim2.new(1, 0, 0, 2)}):Play()
        else
            TweenService:Create(btn, info, {BackgroundColor3 = Color3.fromRGB(30, 30, 38)}):Play()
            TweenService:Create(stroke, info, {Color = Color3.fromRGB(50, 55, 70), Transparency = 0.5}):Play()
            TweenService:Create(label, info, {TextColor3 = Color3.fromRGB(200, 200, 210)}):Play()
            TweenService:Create(switchFrame, info, {BackgroundColor3 = Color3.fromRGB(45, 45, 55)}):Play()
