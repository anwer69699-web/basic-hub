local WaitingForSteal = false
local HasBall = false

-- Get Character Parts
local function GetCharacter()
    return LocalPlayer.Character
end

local function GetHumanoid()
    local char = GetCharacter()
    if char then return char:FindFirstChildOfClass("Humanoid") end
    return nil
end

local function GetHRP()
    local char = GetCharacter()
    if char then return char:FindFirstChild("HumanoidRootPart") end
    return nil
end

-- Check if has ball
local function CheckHasBall()
    local char = GetCharacter()
    if not char then return false end
    HasBall = char:FindFirstChild("Basketball") ~= nil
    return HasBall
end

-- Get current speed
local function GetSpeed()
    return CheckHasBall() and Settings.SpeedSteal or Settings.SpeedNormal
end

-- Try Steal
local function TrySteal()
    local ball = workspace:FindFirstChild("Basketball")
    if not ball then return false end
    
    local owner = ball:FindFirstChild("Owner")
    if not owner or owner.Value == LocalPlayer then return false end
    
    -- محاولة سرقة
    for i = 1, 3 do
        pcall(function()
            local event = game.ReplicatedStorage:FindFirstChild("Events") and game.ReplicatedStorage.Events:FindFirstChild("BallEvent")
            if event then
                event:FireServer("Grab", ball)
            end
        end)
        task.wait(0.02)
    end
    
    return CheckHasBall()
end

