local function tLK()
    ST.LKA = not ST.LKA ST.LockOn = ST.LKA
    if ST.LKA then
        ST.lockCD = 0 local h = gH()
        if not h then ST.LKA = false ST.LockOn = false return end
        pcall(function()
            local at = h:FindFirstChild("LockBodyAtt") or Instance.new("Attachment", h) at.Name = "LockBodyAtt"
            local a = h:FindFirstChild("LockAngVel") or Instance.new("AngularVelocity") a.Name = "LockAngVel"
            a.Attachment0 = at a.AngularVelocity = Vector3.new(0, 0, 0) a.MaxTorque = 80000 a.ReactionTorqueEnabled = false a.Parent = h
        end)
        ST.LKC = Trk(RunService.Heartbeat:Connect(function(dt)
            if not ST.LKA or not _G.ExtRunning then return end
            local h = gH()
            if not h or not h.Parent then ST.LKA = false ST.LockOn = false return end
            local t = FindNearest()
            if t and t.Character then
                local e = t.Character:FindFirstChild("HumanoidRootPart")
                if e then
                    local d = e.Position - h.Position local yD = e.Position.Y - h.Position.Y local lS = gNS()
                    pcall(function() local lhm = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid") if lhm then lhm.WalkSpeed = lS end end)
                    local tfD = Vector3.new(0, 0, -1)
                    local hL = Vector3.new(e.CFrame.LookVector.X, 0, e.CFrame.LookVector.Z)
                    if hL.Magnitude > 0.01 then tfD = hL.Unit elseif d.Magnitude > 0.01 then tfD = Vector3.new(d.X, 0, d.Z).Unit end
                    local pIF = e.Position + (tfD * LOCK_DIST) local tF = pIF - h.Position
                    local dTF = Vector3.new(tF.X, 0, tF.Z).Magnitude local hV = Vector3.new(0, 0, 0)
                    if dTF > 2 then
                        if tF.Magnitude > 0.5 then local fT = Vector3.new(tF.X, 0, tF.Z) if fT.Magnitude > 0.5 then hV = fT.Unit * lS end end
                    elseif dTF > 0.5 then hV = Vector3.new(tF.X, 0, tF.Z) * 5
                    else hV = Vector3.new(0, 0, 0) end
                    local yV = 0
                    if math.abs(yD) > 3 then yV = yD > 0 and math.min(MAX_VS, yD * 10) or math.max(-MAX_VS, yD * 10)
                    elseif math.abs(yD) > 0.5 then yV = math.clamp(yD * 15, -MAX_VS, MAX_VS)
                    else yV = h.Velocity.Y end
                    h.Velocity = Vector3.new(hV.X, yV, hV.Z)
                    pcall(function()
                        local a = h:FindFirstChild("LockAngVel")
                        if a and d.Magnitude > 0.5 then
                            local dCF = CFrame.lookAt(h.Position, e.Position) local rCF = h.CFrame:ToObjectSpace(dCF)
                            local ax, an = rCF:ToAxisAngle()
                            if an > 0.01 then a.AngularVelocity = h.CFrame:VectorToWorldSpace(ax) * math.min(an * 20, 12) * Vector3.new(1, 1, 0.1)
                            else a.AngularVelocity = Vector3.new(0, 0, 0) end
                        end
                    end)
                    ST.lockCD = ST.lockCD - dt
                    if ST.lockCD <= 0 then local tl = FindBat() if tl then pcall(function() tl:Activate() end) end ST.lockCD = 0.08 end
                end
            else
                h.Velocity = Vector3.new(0, h.Velocity.Y, 0)
                pcall(function() local a = h:FindFirstChild("LockAngVel") if a then a.AngularVelocity = Vector3.new(0, 0, 0) end end)
            end
        end))
