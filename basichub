-- Desync Toggle
local function ToggleDesync()
    DesyncEnabled = not DesyncEnabled
    if DesyncEnabled then
        TweenService:Create(DesyncBtn, TweenInfo.new(0.3), {
            BackgroundColor3 = Color3.fromRGB(0, 170, 127),
            TextColor3 = Color3.fromRGB(255, 255, 255)
        }):Play()
        DesyncBtn.Text = "Desync: مفعل"
        StatusLabel.Text = "جاري المحاولة..."
        StatusLabel.TextColor3 = Color3.fromRGB(255, 255, 100)
        
        local hrp = GetHRP()
        if hrp then
            TargetServerPosition = hrp.Position
        end
        
        SetDesync(true)
        FastRespawn()
        
        -- إظهار المربع والكلام
        if ServerPosPart then
            ServerPosPart.Transparency = 0.7
            ServerPosPart.CFrame = CFrame.new(TargetServerPosition)
        end
        if FakePosHighlight then
            FakePosHighlight.Visible = true
        end
        
        Connection_RenderStepped = RunService.RenderStepped:Connect(function()
            local hrp = GetHRP()
            if hrp and TargetServerPosition then
                -- إرسال الموقع المزيف باستمرار
                SendFakePosition(TargetServerPosition)
                
                -- تحديث المربع الأحمر
                if ServerPosPart then
                    ServerPosPart.CFrame = CFrame.new(TargetServerPosition)
                end
                
                -- حساب الفرق
                local realPos = hrp.Position
                local distance = (realPos - TargetServerPosition).Magnitude
                
                -- تحديث الكلام فوق المربع
                if FakePosLabel and FakePosLabel:FindFirstChild("MainText") then
                    FakePosLabel.MainText.Text = "Server Pos\nDiff: " .. math.floor(distance) .. "m"
                    
                    if distance < 10 then
                        FakePosLabel.MainText.TextColor3 = Color3.fromRGB(0, 255, 0)
                        StatusLabel.Text = "ناجح! (" .. math.floor(distance) .. "m)"
                        StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
                    else
                        FakePosLabel.MainText.TextColor3 = Color3.fromRGB(255, 255, 255)
                        StatusLabel.Text = "شغال (" .. math.floor(distance) .. "m)"
                        StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
                    end
                end
                
                ServerInfoLabel.Text = "Server: " .. math.floor(TargetServerPosition.X) .. ", " .. math.floor(TargetServerPosition.Z) .. 
                                      " | Diff: " .. math.floor(distance) .. "m"
            end
        end)
        
        Notify("FR HUB", "Desync مفعل - تقدر تتحرك بسرعة!", 3)
    else
        TweenService:Create(DesyncBtn, TweenInfo.new(0.3), {
            BackgroundColor3 = Color3.fromRGB(45, 45, 45),
            TextColor3 = Color3.fromRGB(200, 200, 200)
        }):Play()
        DesyncBtn.Text = "تفعيل Desync"
        StatusLabel.Text = "الحالة: متوقف"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        ServerInfoLabel.Text = "Server: --- | Diff: ---"
        
        SetDesync(false)
        
        -- إخفاء المربع
        if ServerPosPart then ServerPosPart.Transparency = 1 end
        if FakePosHighlight then FakePosHighlight.Visible = false end
        
        if Connection_RenderStepped then
            Connection_RenderStepped:Disconnect()
            Connection_RenderStepped = nil
        end
        
        Notify("FR HUB", "Desync متوقف", 2)
    end
end

