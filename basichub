    end
end)

btnDesync.MouseButton1Click:Connect(function()
    local on = Toggle(btnDesync, "Desync", "Desync", cDesync)
    if on then
        local hrp = GetHRP()
        if hrp then
            TargetServerPos = hrp.Position
        end
        
        -- Show visual
        if ServerPart then
            ServerPart.Transparency = 0.7
            ServerPart.CFrame = CFrame.new(TargetServerPos)
        end
        
        DesyncConnection = RunService.RenderStepped:Connect(function()
            if TargetServerPos then
                SendFakePosition(TargetServerPos)
                
                -- Update visual
                if ServerPart then
                    ServerPart.CFrame = CFrame.new(TargetServerPos)
                end
                
                local hrp = GetHRP()
                if hrp and ServerLabel then
                    local diff = (hrp.Position - TargetServerPos).Magnitude
                    local label = ServerLabel:FindFirstChildOfClass("TextLabel")
                    if label then
                        label.Text = "Server Pos\nDiff: " .. math.floor(diff) .. "m"
                        label.TextColor3 = diff < 10 and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 255, 255)
                    end
                    Status.Text = "Desync - Diff: " .. math.floor(diff) .. "m"
                end
            end
        end)
        
        Notify("FR HUB", "Desync ON - Move freely!", 2)
    else
        if DesyncConnection then
            DesyncConnection:Disconnect()
            DesyncConnection = nil
        end
        if ServerPart then ServerPart.Transparency = 1 end
        TargetServerPos = nil
        Status.Text = "Ready"
    end
end)

