--// ==================== [DESYNC خفيف - تحديث سريع] ====================

local function ToggleDesync()
    DesyncEnabled = not DesyncEnabled
    
    if DesyncEnabled then
        local hrp = GetHRP()
        if hrp then 
            TargetServerPosition = hrp.Position 
        end
        
        SetDesync(true)
        
        -- يظهر البوكس الأخضر بالموقع المزيف
        if ServerPosPart and TargetServerPosition then
            ServerPosPart.CFrame = CFrame.new(TargetServerPosition)
            ServerPosPart.Parent = workspace
        end
        
        -- LOOP خفيف: 20Hz فقط (بدل 50Hz)
        local lastUpdate = 0
        local lastSent = 0
        
        Connections.Desync = RunService.Heartbeat:Connect(function()
            local now = tick()
            
            -- تحديث البوكس الأخضر: 30Hz (أسرع للعين)
            if now - lastUpdate >= 0.033 then
                lastUpdate = now
                
                pcall(function()
                    local hrp = GetHRP()
                    if not hrp or not TargetServerPosition then return end
                    
                    local realPos = hrp.Position
                    local diff = realPos - TargetServerPosition
                    
                    -- يتبع ببطء (rubber band)
                    if diff.Magnitude > 3 then
                        TargetServerPosition = TargetServerPosition + (diff.Unit * 1.5)
                    end
                    
                    -- يحدث البوكس الأخضر (السيرفر يشوفني هنا)
                    if ServerPosPart then
                        ServerPosPart.CFrame = CFrame.new(TargetServerPosition)
                    end
                end)
            end
            
            -- إرسال للسيرفر: 20Hz فقط (أقل ضغط)
            if now - lastSent >= 0.05 then
                lastSent = now
                
                if TargetServerPosition then
                    SendFakePosition(TargetServerPosition)
                end
            end
        end)
        
        print("[Desync] ON - 20Hz (Low Pressure)")
    else
        SetDesync(false)
        if Connections.Desync then
            Connections.Desync:Disconnect()
            Connections.Desync = nil
        end
        TargetServerPosition = nil
        
        if ServerPosPart then 
            ServerPosPart.CFrame = CFrame.new(0, -1000, 0) -- يخفي
        end
        
        print("[Desync] OFF")
    end
    
    return DesyncEnabled
end

--// ==================== [GALAXY - قفزة واحدة] ====================

local function EnableGalaxy()
    Workspace.Gravity = GalaxySettings.NormalGravity * (GalaxySettings.GravityPercent / 100)
    hasJumped = false
    
    galaxyConnection = UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.KeyCode == Enum.KeyCode.Space and not hasJumped then
            hasJumped = true
            
            local hrp = GetHRP()
            if hrp then
                hrp.AssemblyLinearVelocity = Vector3.new(
                    hrp.AssemblyLinearVelocity.X,
                    GalaxySettings.JumpBoost,
                    hrp.AssemblyLinearVelocity.Z
                )
            end
            
            -- يرجع الجاذبية بعد القفزة
            task.delay(0.6, function()
                Workspace.Gravity = GalaxySettings.NormalGravity
            end)
        end
    end)
end

local function DisableGalaxy()
    if galaxyConnection then
        galaxyConnection:Disconnect()
        galaxyConnection = nil
    end
    Workspace.Gravity = GalaxySettings.NormalGravity
    hasJumped = false
end

--// ==================== [AUTO SYSTEM] ====================

local function CreateBodyVelocity()
    if BodyVel then BodyVel:Destroy() end
    local hrp = GetHRP()
    if not hrp then return nil end
    
    BodyVel = Instance.new("BodyVelocity")
    BodyVel.MaxForce = Vector3.new(400000, 0, 400000)
    BodyVel.Velocity = Vector3.zero
    BodyVel.P = 10000
    BodyVel.Parent = hrp
    return BodyVel
end

local function RemoveBodyVelocity()
    if BodyVel then
        BodyVel:Destroy()
        BodyVel = nil
    end
end

local function StartAutoSystem()
    if Connections.Auto then return end
    
    CreateBodyVelocity()
    
    Connections.Auto = RunService.Heartbeat:Connect(function()
        if not Settings.AutoLeft and not Settings.AutoRight then return end
        
        pcall(function()
            local hrp = GetHRP()
            local hum = GetHumanoid()
            if not hrp or not hum then return end
            
            local points = Settings.AutoLeft and LEFT_POINTS or RIGHT_POINTS
            
            if waitingForSteal then
                if IsStealing() or HasBall() then
                    waitingForSteal = false
                    autoPhase = "POINT_3"
                elseif tick() - stealWaitStart > 2.5 then
                    waitingForSteal = false
                    autoPhase = "POINT_3"
                else
                    hum:Move(Vector3.zero, false)
                    if BodyVel then BodyVel.Velocity = Vector3.new(0, 0, 0) end
                    return
                end
            end
            
            local currentPoint = points[autoPhase]
            if not currentPoint then
                autoPhase = "START"
                currentPoint = points.START
            end
            
            local targetPos = Vector3.new(currentPoint.X, hrp.Position.Y, currentPoint.Z)
            local dist = (targetPos - hrp.Position).Magnitude
            
            if dist < 2.5 then
                if autoPhase == "START" then
                    autoPhase = "POINT_2"
                elseif autoPhase == "POINT_2" then
                    waitingForSteal = true
                    stealWaitStart = tick()
                    hum:Move(Vector3.zero, false)
                    return
                elseif autoPhase == "POINT_3" then
                    autoPhase = "END"
                elseif autoPhase == "END" then
                    autoPhase = "START"
                    waitingForSteal = false
                    return
                end
            end
            
            local baseSpeed = IsStealing() and Settings.SpeedSteal or Settings.SpeedNormal
            local speed = baseSpeed * (1 + (math.random(-10, 10) / 1000))
            
            local dir = (targetPos - hrp.Position).Unit
            dir = Vector3.new(dir.X, 0, dir.Z).Unit
            
            if BodyVel then
                BodyVel.Velocity = Vector3.new(dir.X * speed, 0, dir.Z * speed)
            end
            
            hrp.AssemblyLinearVelocity = Vector3.new(
                dir.X * speed * 0.3,
                hrp.AssemblyLinearVelocity.Y,
                dir.Z * speed * 0.3
            )
            
            hum:Move(dir, false)
        end)
    end)
end

local function StopAutoSystem()
    if Connections.Auto then
        Connections.Auto:Disconnect()
        Connections.Auto = nil
    end
    RemoveBodyVelocity()
    autoPhase = "START"
    waitingForSteal = false
    stealWaitStart = 0
    pcall(function()
        local hum = GetHumanoid()
        if hum then hum:Move(Vector3.zero, false) end
    end)
end

--// ==================== [INSTA STEAL] ====================

task.spawn(function()
    while task.wait(0.1) do -- أبطأ شوي (0.1 بدل 0.08)
        if not isInstaGrabActive then continue end
        
        pcall(function()
            local plots = Workspace:FindFirstChild("Plots")
            if plots then
                for _, plot in pairs(plots:GetChildren()) do
                    local podiums = plot:FindFirstChild("AnimalPodiums")
                    if podiums then
                        for _, podium in pairs(podiums:GetChildren()) do
                            local base = podium:FindFirstChild("Base")
                            local spawn = base and base:FindFirstChild("Spawn")
                            local att = spawn and spawn:FindFirstChild("PromptAttachment")
                            if att then
                                for _, prompt in pairs(att:GetChildren()) do
                                    if prompt:IsA("ProximityPrompt") then
                                        prompt.HoldDuration = 0.02 -- أبطأ شوي
                                    end
                                end
                            end
                        end
                    end
                end
            end
            
            local ball = Workspace:FindFirstChild("Basketball")
            if ball then
                local owner = ball:FindFirstChild("Owner")
                if owner and owner.Value ~= Player then
                    if ReplicatedStorage:FindFirstChild("Events") and ReplicatedStorage.Events:FindFirstChild("BallEvent") then
                        ReplicatedStorage.Events.BallEvent:FireServer("Grab", ball)
                    end
                end
            end
        end)
    end
end)

