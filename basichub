-- Points
local LEFT_POINTS = {
    START = Vector3.new(-473.43, -7.30, 95.59),
    POINT_2 = Vector3.new(-485.73, -5.15, 95.42),
    POINT_3 = Vector3.new(-473.43, -7.30, 95.59),
    END = Vector3.new(-473.96, -7.30, 19.63)
}

local RIGHT_POINTS = {
    START = Vector3.new(-474.13, -7.30, 24.17),
    POINT_2 = Vector3.new(-485.17, -5.15, 25.08),
    POINT_3 = Vector3.new(-474.13, -7.30, 24.17),
    END = Vector3.new(-474.55, -7.30, 23.52)
}

-- Variables
local AutoPhase = "START"
local CurrentPath = nil
local WaitingForSteal = false
local AutoConnection = nil

-- Helper Functions
local function GetCharacter()
    return LocalPlayer.Character
end

local function GetHumanoid()
    local char = GetCharacter()
    if char then return char:FindFirstChildOfClass("Humanoid") end
    return nil
end

local function GetHRP()
    local char = GetCharacter()
    if char then return char:FindFirstChild("HumanoidRootPart") end
    return nil
end

local function CheckHasBall()
    local char = GetCharacter()
    if not char then return false end
    return char:FindFirstChild("Basketball") ~= nil
end

local function TrySteal()
    local ball = Workspace:FindFirstChild("Basketball")
    if not ball then return false end
    
    local owner = ball:FindFirstChild("Owner")
    if not owner or owner.Value == LocalPlayer then return false end
    
    for i = 1, 3 do
        pcall(function()
            if ReplicatedStorage:FindFirstChild("Events") and ReplicatedStorage.Events:FindFirstChild("BallEvent") then
                ReplicatedStorage.Events.BallEvent:FireServer("Grab", ball)
            end
        end)
        task.wait(0.02)
    end
    
    return CheckHasBall()
end

-- نظام Auto (نفس كفاءة الـ Desync - Heartbeat)
local function StartAutoSystem()
    if AutoConnection then AutoConnection:Disconnect() end
    
    AutoConnection = RunService.Heartbeat:Connect(function()
        if not ScriptSettings.AutoLeft and not ScriptSettings.AutoRight then return end
        
        local hrp = GetHRP()
        local hum = GetHumanoid()
        if not hrp or not hum then return end
        
        local points = CurrentPath == "LEFT" and LEFT_POINTS or RIGHT_POINTS
        
        -- انتظار في الموقع 2
        if WaitingForSteal then
            hum:Move(Vector3.zero, false)
            
            local stolen = TrySteal()
            if stolen or CheckHasBall() then
                WaitingForSteal = false
                AutoPhase = "POINT_3"
            end
            return
        end
        
        -- التحرك للنقاط
        local currentPoint = points[AutoPhase]
        if not currentPoint then
            AutoPhase = "START"
            currentPoint = points.START
        end
        
        local targetPos = Vector3.new(currentPoint.X, hrp.Position.Y, currentPoint.Z)
        local distance = (targetPos - hrp.Position).Magnitude
        
        -- وصل للهدف
        if distance < 2 then
            if AutoPhase == "START" then
                AutoPhase = "POINT_2"
            elseif AutoPhase == "POINT_2" then
                WaitingForSteal = true
                hum:Move(Vector3.zero, false)
                return
            elseif AutoPhase == "POINT_3" then
                AutoPhase = "END"
            elseif AutoPhase == "END" then
                AutoPhase = "START"
                return
            end
        end
        
        -- التحرك (نفس نظام الـ Desync - سلس وسريع)
        local direction = (targetPos - hrp.Position).Unit
        direction = Vector3.new(direction.X, 0, direction.Z).Unit
        
        local speed = CheckHasBall() and 25 or 40
        
        -- Humanoid:Move (نفس الـ Desync)
        hum:Move(direction, false)
        
        -- Velocity للسرعة
        hrp.AssemblyLinearVelocity = Vector3.new(
            direction.X * speed,
            hrp.AssemblyLinearVelocity.Y,
            direction.Z * speed
        )
    end)
end

local function StopAutoSystem()
    if AutoConnection then
        AutoConnection:Disconnect()
        AutoConnection = nil
    end
    
    local hum = GetHumanoid()
    if hum then
        hum:Move(Vector3.zero, false)
    end
    
    CurrentPath = nil
    AutoPhase = "START"
    WaitingForSteal = false
end

