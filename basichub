    iconLabel.Parent = btn

    -- Text
    local textLabel = Instance.new("TextLabel")
    textLabel.Name = "Text"
    textLabel.Size = UDim2.new(1, -90, 1, 0)
    textLabel.Position = UDim2.new(0, 45, 0, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = name .. ": OFF"
    textLabel.TextColor3 = Color3.fromRGB(180, 180, 200)
    textLabel.TextSize = 13
    textLabel.Font = Enum.Font.GothamBold
    textLabel.TextXAlignment = Enum.TextXAlignment.Left
    textLabel.Parent = btn

    -- Status Circle
    local statusCircle = Instance.new("Frame")
    statusCircle.Name = "StatusCircle"
    statusCircle.Size = UDim2.new(0, 12, 0, 12)
    statusCircle.Position = UDim2.new(1, -22, 0.5, -6)
    statusCircle.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
    statusCircle.BorderSizePixel = 0
    statusCircle.Parent = btn

    local statusCorner = Instance.new("UICorner")
    statusCorner.CornerRadius = UDim.new(1, 0)
    statusCorner.Parent = statusCircle

    -- State tracking - FIXED: Proper connection handling
    local isActive = false
    local pulseThread = nil

    -- Hover Effects
    btn.MouseEnter:Connect(function()
        if not isActive then
            TweenService:Create(btn, TweenInfo.new(0.2), {
                BackgroundColor3 = Color3.fromRGB(45, 45, 65)
            }):Play()
            TweenService:Create(btnStroke, TweenInfo.new(0.2), {
                Transparency = 0.3,
                Color = color
            }):Play()
        end
    end)

    btn.MouseLeave:Connect(function()
        if not isActive then
            TweenService:Create(btn, TweenInfo.new(0.2), {
                BackgroundColor3 = Color3.fromRGB(35, 35, 50)
            }):Play()
            TweenService:Create(btnStroke, TweenInfo.new(0.2), {
                Transparency = 0.5,
                Color = Color3.fromRGB(60, 60, 80)
            }):Play()
        end
    end)

    -- Toggle Function - FIXED: No tweening of UIGradient.Color
    local function SetActive(active)
        isActive = active

        if active then
            -- ON State - FIXED: Only tween valid properties
            TweenService:Create(btn, TweenInfo.new(0.3), {
                BackgroundColor3 = Color3.fromRGB(50, 50, 80)
            }):Play()
            
            -- FIXED: Don't tween btnGradient.Color, just set it directly
            btnGradient.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromRGB(60, 60, 100)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(40, 40, 70))
            })
            
            TweenService:Create(btnStroke, TweenInfo.new(0.3), {
                Color = color,
                Transparency = 0
            }):Play()
            TweenService:Create(textLabel, TweenInfo.new(0.2), {
                TextColor3 = Color3.fromRGB(255, 255, 255)
            }):Play()
            TweenService:Create(statusCircle, TweenInfo.new(0.3), {
                BackgroundColor3 = color
            }):Play()
            textLabel.Text = name .. ": ON"

            -- Pulse Animation - FIXED: Proper thread handling
            if pulseThread then
                task.cancel(pulseThread)
                pulseThread = nil
            end
            
            pulseThread = task.spawn(function()
                while isActive and btn.Parent do
                    local success = pcall(function()
                        TweenService:Create(statusCircle, TweenInfo.new(0.5), {
                            Size = UDim2.new(0, 14, 0, 14),
                            Position = UDim2.new(1, -23, 0.5, -7)
                        }):Play()
                    end)
                    if not success then break end
                    
                    task.wait(0.5)
                    if not isActive then break end
                    
                    success = pcall(function()
                        TweenService:Create(statusCircle, TweenInfo.new(0.5), {
                            Size = UDim2.new(0, 12, 0, 12),
                            Position = UDim2.new(1, -22, 0.5, -6)
                        }):Play()
                    end)
                    if not success then break end
                    
                    task.wait(0.5)
                end
            end)
        else
            -- OFF State - FIXED: Cancel pulse thread properly
            if pulseThread then
                task.cancel(pulseThread)
                pulseThread = nil
            end
            
            TweenService:Create(btn, TweenInfo.new(0.3), {
                BackgroundColor3 = Color3.fromRGB(35, 35, 50)
            }):Play()
            
            -- FIXED: Don't tween btnGradient.Color, set it directly
            btnGradient.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromRGB(40, 40, 60)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(30, 30, 45))
            })
            
            TweenService:Create(btnStroke, TweenInfo.new(0.3), {
                Color = Color3.fromRGB(60, 60, 80),
                Transparency = 0.5
            }):Play()
            TweenService:Create(textLabel, TweenInfo.new(0.2), {
                TextColor3 = Color3.fromRGB(180, 180, 200)
            }):Play()
            TweenService:Create(statusCircle, TweenInfo.new(0.3), {
                BackgroundColor3 = Color3.fromRGB(100, 100, 100),
                Size = UDim2.new(0, 12, 0, 12),
                Position = UDim2.new(1, -22, 0.5, -6)
            }):Play()
            textLabel.Text = name .. ": OFF"
        end
    end

    -- Click Effect
    local function CreateRipple()
        local ripple = Instance.new("Frame")
        ripple.Name = "Ripple"
        ripple.Size = UDim2.new(0, 0, 0, 0)
        ripple.Position = UDim2.new(0.5, 0, 0.5, 0)
        ripple.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        ripple.BackgroundTransparency = 0.7
        ripple.BorderSizePixel = 0
        ripple.ZIndex = 10
        ripple.Parent = btn

        local rippleCorner = Instance.new("UICorner")
        rippleCorner.CornerRadius = UDim.new(1, 0)
        rippleCorner.Parent = ripple

        TweenService:Create(ripple, TweenInfo.new(0.6), {
            Size = UDim2.new(2, 0, 2, 0),
            Position = UDim2.new(-0.5, 0, -0.5, 0),
            BackgroundTransparency = 1
        }):Play()

        task.delay(0.6, function()
            if ripple and ripple.Parent then
                ripple:Destroy()
            end
        end)
    end

    return btn, SetActive, CreateRipple, textLabel
