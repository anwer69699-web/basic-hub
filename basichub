--[[ FR LITE - Delta Mobile ]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer

if _G.FRLITE then return end
_G.FRLITE = true

-- Settings
local AutoLeft = false
local AutoRight = false
local InstaSteal = false
local DesyncKill = false
local DesyncSafe = false
local Speed = 58

-- Points
local LEFT_POINTS = {
    Vector3.new(-473.43, -7.30, 95.59),
    Vector3.new(-485.73, -5.15, 95.42),
    Vector3.new(-473.43, -7.30, 95.59),
    Vector3.new(-473.96, -7.30, 19.63)
}

local RIGHT_POINTS = {
    Vector3.new(-474.13, -7.30, 24.17),
    Vector3.new(-485.17, -5.15, 25.08),
    Vector3.new(-474.13, -7.30, 24.17),
    Vector3.new(-474.55, -7.30, 23.52)
}

local CurrentVel = nil
local AutoIdx = 1
local LastTime = 0
local StealConn = nil

-- UI
local gui = Instance.new("ScreenGui")
gui.Name = "FRLITE"
gui.Parent = game.CoreGui

local main = Instance.new("Frame")
main.Size = UDim2.new(0, 160, 0, 220)
main.Position = UDim2.new(0, 10, 0, 100)
main.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
main.Parent = gui

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 30)
title.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
title.Text = "FR LITE"
title.TextColor3 = Color3.new(1, 1, 1)
title.Parent = main

local function makeBtn(txt, y, c)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(0.9, 0, 0, 30)
    b.Position = UDim2.new(0.05, 0, 0, y)
    b.BackgroundColor3 = Color3.fromRGB(65, 65, 65)
    b.Text = txt .. ": OFF"
    b.TextColor3 = Color3.new(1, 1, 1)
    b.Parent = main
    return b, c
end

local bL, cL = makeBtn("LEFT", 40, Color3.fromRGB(0, 200, 0))
local bR, cR = makeBtn("RIGHT", 75, Color3.fromRGB(0, 150, 255))
local bS, cS = makeBtn("STEAL", 110, Color3.fromRGB(255, 150, 0))
local bDK, cDK = makeBtn("D-KILL", 145, Color3.fromRGB(200, 0, 0))
local bDS, cDS = makeBtn("D-SAFE", 180, Color3.fromRGB(150, 0, 200))

-- Functions
local function getHrp()
    local c = LocalPlayer.Character
    if c then return c:FindFirstChild("HumanoidRootPart") end
    return nil
end

local function makeVel()
    local h = getHrp()
    if not h then return end
    if CurrentVel then CurrentVel:Destroy() end
    CurrentVel = Instance.new("BodyVelocity")
    CurrentVel.MaxForce = Vector3.new(999999, 999999, 999999)
    CurrentVel.Velocity = Vector3.zero
    CurrentVel.Parent = h
end

local function delVel()
    if CurrentVel then
        CurrentVel:Destroy()
        CurrentVel = nil
    end
end

local function steal()
    local ball = Workspace:FindFirstChild("Basketball")
    if not ball then return end
    local own = ball:FindFirstChild("Owner")
    if not own then return end
    if own.Value ~= LocalPlayer then
        for i = 1, 5 do
            pcall(function()
                ReplicatedStorage.Events.BallEvent:FireServer("Grab", ball)
            end)
        end
    end
end

-- Toggles
bL.MouseButton1Click:Connect(function()
    AutoLeft = not AutoLeft
    if AutoLeft then
        bL.BackgroundColor3 = cL
        bL.Text = "LEFT: ON"
        AutoRight = false
        bR.BackgroundColor3 = Color3.fromRGB(65, 65, 65)
        bR.Text = "RIGHT: OFF"
        makeVel()
    else
        bL.BackgroundColor3 = Color3.fromRGB(65, 65, 65)
        bL.Text = "LEFT: OFF"
        delVel()
    end
end)

bR.MouseButton1Click:Connect(function()
    AutoRight = not AutoRight
    if AutoRight then
        bR.BackgroundColor3 = cR
        bR.Text = "RIGHT: ON"
        AutoLeft = false
        bL.BackgroundColor3 = Color3.fromRGB(65, 65, 65)
        bL.Text = "LEFT: OFF"
        makeVel()
    else
        bR.BackgroundColor3 = Color3.fromRGB(65, 65, 65)
        bR.Text = "RIGHT: OFF"
        delVel()
    end
end)

bS.MouseButton1Click:Connect(function()
    InstaSteal = not InstaSteal
    if InstaSteal then
        bS.BackgroundColor3 = cS
        bS.Text = "STEAL: ON"
        StealConn = RunService.Heartbeat:Connect(function()
            if InstaSteal then steal() end
        end)
    else
        bS.BackgroundColor3 = Color3.fromRGB(65, 65, 65)
        bS.Text = "STEAL: OFF"
        if StealConn then StealConn:Disconnect() StealConn = nil end
    end
end)

bDK.MouseButton1Click:Connect(function()
    DesyncKill = not DesyncKill
    if DesyncKill then
        bDK.BackgroundColor3 = cDK
        bDK.Text = "D-KILL: ON"
        DesyncSafe = false
        bDS.BackgroundColor3 = Color3.fromRGB(65, 65, 65)
        bDS.Text = "D-SAFE: OFF"
    else
        bDK.BackgroundColor3 = Color3.fromRGB(65, 65, 65)
        bDK.Text = "D-KILL: OFF"
    end
end)

bDS.MouseButton1Click:Connect(function()
    DesyncSafe = not DesyncSafe
    if DesyncSafe then
        bDS.BackgroundColor3 = cDS
        bDS.Text = "D-SAFE: ON"
        DesyncKill = false
        bDK.BackgroundColor3 = Color3.fromRGB(65, 65, 65)
        bDK.Text = "D-KILL: OFF"
    else
        bDS.BackgroundColor3 = Color3.fromRGB(65, 65, 65)
        bDS.Text = "D-SAFE: OFF"
    end
end)

-- Main Loop
RunService.Heartbeat:Connect(function()
    local hrp = getHrp()
    if not hrp then delVel() return end
    
    if AutoLeft and tick() - LastTime > 0.12 then
        AutoIdx = AutoIdx + 1
        if AutoIdx > #LEFT_POINTS then AutoIdx = 1 end
        local t = LEFT_POINTS[AutoIdx]
        local d = (t - hrp.Position).Magnitude
        if d > 30 then
            hrp.CFrame = CFrame.new(t)
        elseif CurrentVel then
            CurrentVel.Velocity = (t - hrp.Position).Unit * Speed
        end
        LastTime = tick()
    end
    
    if AutoRight and tick() - LastTime > 0.12 then
        AutoIdx = AutoIdx + 1
        if AutoIdx > #RIGHT_POINTS then AutoIdx = 1 end
        local t = RIGHT_POINTS[AutoIdx]
        local d = (t - hrp.Position).Magnitude
        if d > 30 then
            hrp.CFrame = CFrame.new(t)
        elseif CurrentVel then
            CurrentVel.Velocity = (t - hrp.Position).Unit * Speed
        end
        LastTime = tick()
    end
    
    if not AutoLeft and not AutoRight and CurrentVel then
        CurrentVel.Velocity = Vector3.zero
    end
    
    if DesyncKill then
        hrp.CFrame = hrp.CFrame + Vector3.new(math.random(-20, 20), math.random(-5, 5), math.random(-20, 20))
    end
    
    if DesyncSafe then
        hrp.CFrame = hrp.CFrame + Vector3.new(math.random(-8, 8), 0, math.random(-8, 8))
    end
end)

-- Respawn
LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.5)
    if AutoLeft or AutoRight then makeVel() end
end)

-- Notify
pcall(function()
    StarterGui:SetCore("SendNotification", {
        Title = "FR LITE",
        Text = "Loaded!",
        Duration = 3
    })
end)
