    end
end)

-- Main Loop
RunService.Heartbeat:Connect(function()
    -- Auto Left
    if Settings.AutoLeft then
        local target = LEFT_POINTS[AutoIndex]
        local reached = MoveToPoint(target)
        
        if reached and tick() - LastAutoTime > 0.1 then
            AutoIndex = AutoIndex + 1
            if AutoIndex > #LEFT_POINTS then AutoIndex = 1 end
            LastAutoTime = tick()
            Status.Text = "Left Point " .. AutoIndex .. " - Speed: " .. GetSpeed()
        end
    end
    
    -- Auto Right
    if Settings.AutoRight then
        local target = RIGHT_POINTS[AutoIndex]
        local reached = MoveToPoint(target)
        
        if reached and tick() - LastAutoTime > 0.1 then
            AutoIndex = AutoIndex + 1
            if AutoIndex > #RIGHT_POINTS then AutoIndex = 1 end
            LastAutoTime = tick()
            Status.Text = "Right Point " .. AutoIndex .. " - Speed: " .. GetSpeed()
        end
    end
    
    -- Stop if not active
    if not Settings.AutoLeft and not Settings.AutoRight and CurrentVel then
        CurrentVel.Velocity = Vector3.zero
    end
end)

