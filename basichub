local function MakeSpdInput(lbl, default, y, maxLimit)
    local l = Instance.new("TextLabel") l.Name = "Lbl_"..lbl l.Text = lbl l.TextColor3 = C.TXT l.Font = Enum.Font.GothamBold l.TextSize = 11*SC l.BackgroundTransparency = 1 l.Size = UDim2.new(0.6, 0, 0, 20*SC) l.Position = UDim2.new(0, 8*SC, 0, y*SC) l.TextXAlignment = Enum.TextXAlignment.Left l.ZIndex = 10 l.Parent = P2
    local bx = Instance.new("TextBox") bx.Text = tostring(default) bx.TextColor3 = C.TXT bx.Font = Enum.Font.GothamBold bx.TextSize = 12*SC bx.BackgroundColor3 = C.DRK bx.Size = UDim2.new(0, 70*SC, 0, 20*SC) bx.Position = UDim2.new(1, -82*SC, 0, y*SC) bx.ZIndex = 10 bx.Parent = P2 bx.ClearTextOnFocus = false
    Instance.new("UICorner", bx).CornerRadius = UDim.new(0, 5)
    local bs = Instance.new("UIStroke") bs.Thickness = 1 bs.Color = C.GRN bs.Parent = bx BorderGrad(bs)
    bx.FocusLost:Connect(function()
        local num = tonumber(bx.Text)
        if not num then bx.Text = tostring(default)
        else
            if num > maxLimit then
                bx.Text = tostring(maxLimit)
                Notify("EXTERNAL", L("warn_max"), 2)
            else
                bx.Text = tostring(math.clamp(num, 0, maxLimit))
            end
        end
    end)
    return bx, l
end

