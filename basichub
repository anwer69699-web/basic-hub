Trk(UIS.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if LAG_ST.listening then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            LAG_ST.boundKey = input.KeyCode KeyBtn.Text = "[ " .. tostring(input.KeyCode):sub(14) .. " ]"
            LAG_ST.listening = false
            TweenService:Create(KeyBtn, TweenInfo.new(0.3), { TextColor3 = C.TXT }):Play()
            ST.justBound = true ST.justBoundKey = input.KeyCode
            task.delay(0.3, function() ST.justBound = false ST.justBoundKey = nil end)
        end
        return
    end
    if ST.justBound and ST.justBoundKey and input.KeyCode == ST.justBoundKey then return end
    if LAG_ST.boundKey and input.KeyCode == LAG_ST.boundKey then toggleLagger() return end
    for _, cfg in ipairs(HotkeyConfig) do
        if input.KeyCode == cfg.key then
            if cfg.btn == bLockF then tLK()
            elseif cfg.btn == bTPDF then DoTPDown()
            elseif cfg.btn == bDropF then DoDrop()
            elseif cfg.btn == bIRSF then IRS_ActivateReset()
            elseif cfg.btn == bModeF then
                if ST.SpdMode == "NORMAL" then ST.SpdMode = "LAGGER" BX.J.Text = tostring(LIMITS.LAGGER_JUMP)
                else ST.SpdMode = "NORMAL" BX.J.Text = tostring(LIMITS.NORMAL_JUMP) end
                UpdateMode() SyncToggles()
            elseif cfg.btn == LangBtn then Lang = Lang == "EN" and "AR" or "EN" UpdateLang() end
        end
    end
end))

