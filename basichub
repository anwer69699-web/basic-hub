-- Get Parts
local function GetHRP()
    local char = LocalPlayer.Character
    if char then return char:FindFirstChild("HumanoidRootPart") end
    return nil
end

local function GetHumanoid()
    local char = LocalPlayer.Character
    if char then return char:FindFirstChildOfClass("Humanoid") end
    return nil
end

local function HasBall()
    local char = LocalPlayer.Character
    if not char then return false end
    return char:FindFirstChild("Basketball") ~= nil
end

-- Create Velocity
local function CreateVelocity()
    local hrp = GetHRP()
    if not hrp then return nil end

    if CurrentVel then CurrentVel:Destroy() end

    for _, v in pairs(hrp:GetChildren()) do
        if v:IsA("BodyVelocity") then v:Destroy() end
    end

    local vel = Instance.new("BodyVelocity")
    vel.MaxForce = Vector3.new(400000, 400000, 400000)
    vel.Velocity = Vector3.zero
    vel.P = 10000
    vel.Parent = hrp

    CurrentVel = vel
    return vel
end

local function RemoveVelocity()
    if CurrentVel then
        CurrentVel:Destroy()
        CurrentVel = nil
    end
end

-- Try Steal
local function TrySteal()
    local ball = Workspace:FindFirstChild("Basketball")
    if not ball then return false end

    local owner = ball:FindFirstChild("Owner")
    if not owner or owner.Value == LocalPlayer then return false end

    for i = 1, 3 do
        pcall(function()
            if ReplicatedStorage:FindFirstChild("Events") and ReplicatedStorage.Events:FindFirstChild("BallEvent") then
                ReplicatedStorage.Events.BallEvent:FireServer("Grab", ball)
            end
        end)
        task.wait(0.02)
    end

    return HasBall()
end

-- Insta Steal System
local function StartInstaStealSystem()
    task.spawn(function()
        while task.wait(0.1) do
            if not isInstaStealActive then continue end

            local plots = Workspace:FindFirstChild("Plots")
            if plots then
                for _, plot in pairs(plots:GetChildren()) do
                    local podiums = plot:FindFirstChild("AnimalPodiums")
                    if podiums then
                        for _, podium in pairs(podiums:GetChildren()) do
                            local base = podium:FindFirstChild("Base")
                            local spawn = base and base:FindFirstChild("Spawn")
                            local att = spawn and spawn:FindFirstChild("PromptAttachment")

                            if att then
                                for _, prompt in pairs(att:GetChildren()) do
                                    if prompt:IsA("ProximityPrompt") then
                                        prompt.HoldDuration = 0.03
                                    end
                                end
                            end
                        end
                    end
                end
            end

            local ball = Workspace:FindFirstChild("Basketball")
            if ball then
                local owner = ball:FindFirstChild("Owner")
                if owner and owner.Value ~= LocalPlayer then
                    pcall(function()
                        if ReplicatedStorage:FindFirstChild("Events") and ReplicatedStorage.Events:FindFirstChild("BallEvent") then
                            ReplicatedStorage.Events.BallEvent:FireServer("Grab", ball)
                        end
                    end)
                end
            end
        end
    end)
end

