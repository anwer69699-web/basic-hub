local dragging = false
local dragStart = nil
local startPos = nil
local minimized = false
local fullSize = UDim2.new(0, 210, 0, 195)
local miniSize = UDim2.new(0, 210, 0, 42)

local function clampPos(pos)
    local vp = workspace.CurrentCamera.ViewportSize
    local sz = Frame.AbsoluteSize
    return UDim2.new(0, math.clamp(pos.X.Offset, 0, math.max(0, vp.X - sz.X)), 0, math.clamp(pos.Y.Offset, 0, math.max(0, vp.Y - sz.Y)))
end

Frame.InputBegan:Connect(function(input)
    if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and not minimized then
        dragging = true
        dragStart = input.Position
        startPos = Frame.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        if minimized then dragging = false return end
        local d = input.Position - dragStart
        Frame.Position = clampPos(UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y))
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

