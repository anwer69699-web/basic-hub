-- ═══════════════════════════════════════════════════════════════
-- INSTA STEAL BUTTON - BY AETHER
-- زر واحد انستا ستيل + تحريك بالشاشة
-- ═══════════════════════════════════════════════════════════════

repeat task.wait() until game:IsLoaded()

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Player = Players.LocalPlayer

-- ═══════════════════════════════════════════════════════════════
-- الإعدادات
-- ═══════════════════════════════════════════════════════════════

local Settings = {
    StealRadius = 11,        -- مسافة السرقة
    HoldDuration = 0.1,        -- زمن الضغط (0 = فوري)
    UpdateRate = 0.03       -- سرعة التحديث
}

-- ═══════════════════════════════════════════════════════════════
-- متغيرات
-- ═══════════════════════════════════════════════════════════════

local isActive = true
local dragObject = nil
local dragStart = nil
local buttonPosition = UDim2.new(0.85, 0, 0.75, 0)  -- الموقع الافتراضي
local isDragging = false

-- ═══════════════════════════════════════════════════════════════
-- دالة انستا ستيل (تعديل الـ ProximityPrompt)
-- ═══════════════════════════════════════════════════════════════

local function fixProximityPrompt(prompt)
    if not prompt then return end
    pcall(function()
        -- جعل السرقة فورية بدون زمن انتظار
        prompt.HoldDuration = Settings.HoldDuration
        prompt.RequiresLineOfSight = false
        prompt.MaxActivationDistance = Settings.StealRadius
    end)
end

local function applyToAllPrompts()
    pcall(function()
        local char = Player.Character
        if not char then return end
        
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        
        -- البحث عن جميع الـ Prompts حول اللاعب
        local searchRadius = Settings.StealRadius + 5
        local region = Region3.new(
            hrp.Position - Vector3.new(searchRadius, 20, searchRadius),
            hrp.Position + Vector3.new(searchRadius, 20, searchRadius)
        )
        
        local parts = workspace:FindPartsInRegion3(region, char, 100)
        
        for _, part in ipairs(parts) do
            for _, child in ipairs(part:GetDescendants()) do
                if child:IsA("ProximityPrompt") then
                    fixProximityPrompt(child)
                end
            end
        end
    end)
end

-- ═══════════════════════════════════════════════════════════════
-- تشغيل نظام الانستا ستيل (لوب مستمر)
-- ═══════════════════════════════════════════════════════════════

local stealLoop = nil

local function startStealLoop()
    if stealLoop then return end
    
    stealLoop = task.spawn(function()
        while isActive do
            task.wait(Settings.UpdateRate)
            applyToAllPrompts()
        end
    end)
end

local function stopStealLoop()
    isActive = false
    if stealLoop then
        task.cancel(stealLoop)
        stealLoop = nil
    end
end

-- ═══════════════════════════════════════════════════════════════
-- إنشاء الواجهة (زر واحد قابل للتحريك)
-- ═══════════════════════════════════════════════════════════════

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "InstaStealButton"
screenGui.ResetOnSpawn = false
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screenGui.Parent = Player:WaitForChild("PlayerGui")

-- الزر الرئيسي
local button = Instance.new("ImageButton")
button.Name = "StealButton"
button.Size = UDim2.new(0, 70, 0, 70)
button.Position = buttonPosition
button.BackgroundColor3 = Color3.fromRGB(25, 20, 40)
button.BackgroundTransparency = 0.15
button.Image = "rbxassetid://6031090999"  -- ايقونة سرقة
button.ImageColor3 = Color3.fromRGB(255, 85, 85)
button.ScaleType = Enum.ScaleType.Fit
button.AutoButtonColor = false
button.Parent = screenGui

-- تأثير الزوايا الدائرية
local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(1, 0)  -- دائري كامل
corner.Parent = button

-- حدود خارجية
local stroke = Instance.new("UIStroke")
stroke.Thickness = 2
stroke.Color = Color3.fromRGB(255, 85, 85)
stroke.Transparency = 0.3
stroke.Parent = button

-- نص داخلي
local buttonText = Instance.new("TextLabel")
buttonText.Size = UDim2.new(1, 0, 1, 0)
buttonText.BackgroundTransparency = 1
buttonText.Text = "INSTA\nSTEAL"
buttonText.TextColor3 = Color3.fromRGB(255, 255, 255)
buttonText.TextScaled = true
buttonText.Font = Enum.Font.GothamBlack
buttonText.TextWrapped = true
buttonText.Parent = button

-- تأثير الضوء (Glow)
local glow = Instance.new("ImageLabel")
glow.Size = UDim2.new(1.3, 0, 1.3, 0)
glow.Position = UDim2.new(-0.15, 0, -0.15, 0)
glow.BackgroundTransparency = 1
glow.Image = "rbxassetid://5554236676"
glow.ImageColor3 = Color3.fromRGB(255, 85, 85)
glow.ImageTransparency = 0.6
glow.Parent = button

-- ═══════════════════════════════════════════════════════════════
-- أنيميشن التنفس (breathing animation)
-- ═══════════════════════════════════════════════════════════════

local function startBreathingAnimation()
    local tweenInfo = TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
    local tween1 = TweenService:Create(button, tweenInfo, {BackgroundTransparency = 0.05})
    local tween2 = TweenService:Create(button, tweenInfo, {BackgroundTransparency = 0.25})
    
    tween1:Play()
    task.wait(0.6)
    tween2:Play()
    
    -- نبض للحدود
    local strokeTween = TweenService:Create(stroke, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), 
        {Transparency = 0.1, Color = Color3.fromRGB(255, 100, 100)})
    strokeTween:Play()
end

-- ═══════════════════════════════════════════════════════════════
-- نظام تحريك الزر (Drag System)
-- ═══════════════════════════════════════════════════════════════

button.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDragging = true
        dragStart = input.Position
        dragObject = button
        button.BackgroundTransparency = 0.3
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        if delta.Magnitude > 0 then
            local newPos = UDim2.new(
                button.Position.X.Scale,
                button.Position.X.Offset + delta.X,
                button.Position.Y.Scale,
                button.Position.Y.Offset + delta.Y
            )
            button.Position = newPos
            dragStart = input.Position
            buttonPosition = newPos
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDragging = false
        dragObject = nil
        button.BackgroundTransparency = 0.15
    end
end)

-- ═══════════════════════════════════════════════════════════════
-- تفعيل/تعطيل الانستا ستيل عند الضغط على الزر
-- ═══════════════════════════════════════════════════════════════

local function updateButtonState(active)
    if active then
        -- تفعيل
        button.ImageColor3 = Color3.fromRGB(85, 255, 85)
        stroke.Color = Color3.fromRGB(85, 255, 85)
        buttonText.Text = "ACTIVE"
        glow.ImageColor3 = Color3.fromRGB(85, 255, 85)
        startStealLoop()
        
        -- تأثير فتحة
        TweenService:Create(button, TweenInfo.new(0.2), {Size = UDim2.new(0, 75, 0, 75)}):Play()
        task.wait(0.1)
        TweenService:Create(button, TweenInfo.new(0.15), {Size = UDim2.new(0, 70, 0, 70)}):Play()
    else
        -- تعطيل
        button.ImageColor3 = Color3.fromRGB(255, 85, 85)
        stroke.Color = Color3.fromRGB(255, 85, 85)
        buttonText.Text = "INSTA\nSTEAL"
        glow.ImageColor3 = Color3.fromRGB(255, 85, 85)
        stopStealLoop()
        
        -- تأثير إغلاق
        TweenService:Create(button, TweenInfo.new(0.1), {Size = UDim2.new(0, 65, 0, 65)}):Play()
        task.wait(0.1)
        TweenService:Create(button, TweenInfo.new(0.15), {Size = UDim2.new(0, 70, 0, 70)}):Play()
    end
end

-- الضغط على الزر لتشغيل/إيقاف
button.MouseButton1Click:Connect(function()
    if isDragging then return end  -- إذا كان يسحب لا يضغط
    
    isActive = not isActive
    updateButtonState(isActive)
end)

-- ═══════════════════════════════════════════════════════════════
-- تهيئة السكربت
-- ═══════════════════════════════════════════════════════════════

-- بدء الأنيميشن
startBreathingAnimation()

-- تشغيل الانستا ستيل تلقائياً عند البدء
isActive = true
updateButtonState(true)

-- إعادة تطبيق عند دخول اللاعب (Character respawn)
Player.CharacterAdded:Connect(function()
    task.wait(0.5)
    if isActive then
        -- إعادة تفعيل اللوب بعد الـ respawn
        if stealLoop then task.cancel(stealLoop) stealLoop = nil end
        startStealLoop()
    end
end)

-- تنظيف عند إغلاق GUI
screenGui.AncestryChanged:Connect(function()
    if not screenGui.Parent then
        stopStealLoop()
    end
end)

