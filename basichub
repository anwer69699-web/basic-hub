--// ==================== [TOGGLE DESYNC - يحدث البوكس بالموقع المزيف] ====================

local function ToggleDesync()
    DesyncEnabled = not DesyncEnabled
    
    if DesyncEnabled then
        local hrp = GetHRP()
        if hrp then 
            TargetServerPosition = hrp.Position -- يبدأ من مكانك الحالي
        end
        
        SetDesync(true)
        FastRespawn()
        
        -- يعرض الموقع المزيف (الأحمر)
        if ServerPosPart and TargetServerPosition then
            ServerPosPart.CFrame = CFrame.new(TargetServerPosition)
            ServerPosPart.Transparency = 1
            ServerPosHighlight.Visible = true
            ServerPosHighlight.Color3 = Color3.fromRGB(255, 0, 0) -- أحمر = مزيف
            ServerPosBillboard.Enabled = true
        end
        
        -- FRHUB8 Loop
        local lastUpdate = 0
        Connections.Desync = RunService.RenderStepped:Connect(function()
            local now = tick()
            if now - lastUpdate < 0.02 then return end
            lastUpdate = now
            
            pcall(function()
                local hrp = GetHRP()
                if not hrp then return end
                
                local realPos = hrp.Position
                
                -- Smart follow: البوكس الأحمر (الموقع المزيف) يتحرك
                if TargetServerPosition then
                    local diff = realPos - TargetServerPosition
                    local dist = diff.Magnitude
                    
                    -- يتبع بذكاء
                    if dist > 15 then
                        TargetServerPosition = realPos + (diff.Unit * 10)
                    elseif dist > 5 then
                        TargetServerPosition = TargetServerPosition + (diff.Unit * 2)
                    elseif dist > 2 then
                        TargetServerPosition = TargetServerPosition + (diff.Unit * 0.5)
                    end
                    
                    -- يرسل الموقع المزيف للسيرفر
                    SendFakePosition(TargetServerPosition)
                    
                    -- يحدث البوكس الأحمر بالموقع المزيف (مو الحقيقي!)
                    if ServerPosPart then
                        ServerPosPart.CFrame = CFrame.new(TargetServerPosition)
                        
                        -- يتحقق من نجاح Desync
                        ActualServerPosition = GetActualServerPosition()
                        
                        if ServerPosBillboard then
                            local fakePos = TargetServerPosition
                            local posText = string.format("FAKE: X:%d Z:%d", math.floor(fakePos.X), math.floor(fakePos.Z))
                            
                            if ActualServerPosition then
                                local errorDist = (ActualServerPosition - fakePos).Magnitude
                                posText = posText .. string.format("\nError: %.1fm", errorDist)
                                
                                -- لون حسب النجاح
                                if errorDist < 5 then
                                    ServerPosHighlight.Color3 = Color3.fromRGB(0, 255, 0) -- أخضر = ناجح
                                    ServerPosBillboard.MainText.Text = "SERVER SEE YOU HERE (GOOD)"
                                    ServerPosBillboard.MainText.TextColor3 = Color3.fromRGB(0, 255, 0)
                                elseif errorDist < 15 then
                                    ServerPosHighlight.Color3 = Color3.fromRGB(255, 255, 0) -- أصفر = متوسط
                                    ServerPosBillboard.MainText.TextColor3 = Color3.fromRGB(255, 255, 0)
                                else
                                    ServerPosHighlight.Color3 = Color3.fromRGB(255, 0, 0) -- أحمر = فشل
                                    ServerPosBillboard.MainText.TextColor3 = Color3.fromRGB(255, 0, 0)
                                end
                            else
                                ServerPosBillboard.MainText.Text = "SERVER SEE YOU HERE"
                            end
                            
                            ServerPosBillboard.PosInfo.Text = posText
                        end
                    end
                end
            end)
        end)
        
        print("[LevixFR] Desync ON - Server sees FAKE position")
    else
        SetDesync(false)
        if Connections.Desync then
            Connections.Desync:Disconnect()
            Connections.Desync = nil
        end
        TargetServerPosition = nil
        ActualServerPosition = nil
        
        if ServerPosHighlight then 
            ServerPosHighlight.Visible = false 
        end
        if ServerPosBillboard then 
            ServerPosBillboard.Enabled = false 
        end
        
        print("[LevixFR] Desync OFF")
    end
    
    return DesyncEnabled
end

--// ==================== [GALAXY MODE - قفزة واحدة فقط] ====================

local function EnableGalaxy()
    -- جاذبية أضعف (65% = أعلى من العادي قليلاً)
    Workspace.Gravity = GalaxySettings.NormalGravity * (GalaxySettings.GravityPercent / 100)
    
    -- يمسك Space مرة واحدة فقط
    hasJumped = false
    
    galaxyConnection = UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.KeyCode == Enum.KeyCode.Space and not hasJumped then
            hasJumped = true
            
            local hrp = GetHRP()
            local hum = GetHumanoid()
            if hrp and hum then
                -- قفزة واحدة بقوة محددة
                hrp.AssemblyLinearVelocity = Vector3.new(
                    hrp.AssemblyLinearVelocity.X,
                    GalaxySettings.JumpBoost,
                    hrp.AssemblyLinearVelocity.Z
                )
            end
            
            -- يرجع الجاذبية الطبيعية بعد القفزة
            task.delay(0.5, function()
                Workspace.Gravity = GalaxySettings.NormalGravity
            end)
        end
    end)
    
    print("[Galaxy] Enabled - Single Jump Mode")
end

local function DisableGalaxy()
    if galaxyConnection then
        galaxyConnection:Disconnect()
        galaxyConnection = nil
    end
    Workspace.Gravity = GalaxySettings.NormalGravity
    hasJumped = false
    print("[Galaxy] Disabled")
end

--// ==================== [AUTO SYSTEM] ====================

local function CreateBodyVelocity()
    if BodyVel then BodyVel:Destroy() end
    local hrp = GetHRP()
    if not hrp then return nil end
    
    BodyVel = Instance.new("BodyVelocity")
    BodyVel.MaxForce = Vector3.new(400000, 0, 400000)
    BodyVel.Velocity = Vector3.zero
    BodyVel.P = 10000
    BodyVel.Parent = hrp
    return BodyVel
end

local function RemoveBodyVelocity()
    if BodyVel then
        BodyVel:Destroy()
        BodyVel = nil
    end
end

local function StartAutoSystem()
    if Connections.Auto then return end
    
    CreateBodyVelocity()
    
    Connections.Auto = RunService.Heartbeat:Connect(function()
        if not Settings.AutoLeft and not Settings.AutoRight then return end
        
        pcall(function()
            local hrp = GetHRP()
            local hum = GetHumanoid()
            if not hrp or not hum then return end
            
            local points = Settings.AutoLeft and LEFT_POINTS or RIGHT_POINTS
            
            if waitingForSteal then
                if IsStealing() or HasBall() then
                    waitingForSteal = false
                    autoPhase = "POINT_3"
                elseif tick() - stealWaitStart > 2.5 then
                    waitingForSteal = false
                    autoPhase = "POINT_3"
                else
                    hum:Move(Vector3.zero, false)
                    if BodyVel then BodyVel.Velocity = Vector3.new(0, 0, 0) end
                    return
                end
            end
            
            local currentPoint = points[autoPhase]
            if not currentPoint then
                autoPhase = "START"
                currentPoint = points.START
            end
            
            local targetPos = Vector3.new(currentPoint.X, hrp.Position.Y, currentPoint.Z)
            local dist = (targetPos - hrp.Position).Magnitude
            
            if dist < 2.5 then
                if autoPhase == "START" then
                    autoPhase = "POINT_2"
                elseif autoPhase == "POINT_2" then
                    waitingForSteal = true
                    stealWaitStart = tick()
                    hum:Move(Vector3.zero, false)
                    return
                elseif autoPhase == "POINT_3" then
                    autoPhase = "END"
                elseif autoPhase == "END" then
                    autoPhase = "START"
                    waitingForSteal = false
                    return
                end
            end
            
            local baseSpeed = IsStealing() and Settings.SpeedSteal or Settings.SpeedNormal
            local jitter = 1 + (math.random(-20, 20) / 1000)
            local speed = baseSpeed * jitter
            
            local dir = (targetPos - hrp.Position).Unit
            dir = Vector3.new(dir.X, 0, dir.Z).Unit
            
            if BodyVel then
                BodyVel.Velocity = Vector3.new(dir.X * speed, 0, dir.Z * speed)
            end
            
            hrp.AssemblyLinearVelocity = Vector3.new(
                dir.X * speed * 0.3,
                hrp.AssemblyLinearVelocity.Y,
                dir.Z * speed * 0.3
            )
            
            hum:Move(dir, false)
        end)
    end)
end

local function StopAutoSystem()
    if Connections.Auto then
        Connections.Auto:Disconnect()
        Connections.Auto = nil
    end
    RemoveBodyVelocity()
    autoPhase = "START"
    waitingForSteal = false
    stealWaitStart = 0
    pcall(function()
        local hum = GetHumanoid()
        if hum then hum:Move(Vector3.zero, false) end
    end)
end

--// ==================== [INSTA STEAL] ====================

task.spawn(function()
    while task.wait(0.08) do
        if not isInstaGrabActive then continue end
        
        pcall(function()
            local plots = Workspace:FindFirstChild("Plots")
            if plots then
                for _, plot in pairs(plots:GetChildren()) do
                    local podiums = plot:FindFirstChild("AnimalPodiums")
                    if podiums then
                        for _, podium in pairs(podiums:GetChildren()) do
                            local base = podium:FindFirstChild("Base")
                            local spawn = base and base:FindFirstChild("Spawn")
                            local att = spawn and spawn:FindFirstChild("PromptAttachment")
                            if att then
                                for _, prompt in pairs(att:GetChildren()) do
                                    if prompt:IsA("ProximityPrompt") then
                                        prompt.HoldDuration = 0.01
                                    end
                                end
                            end
                        end
                    end
                end
            end
            
            local ball = Workspace:FindFirstChild("Basketball")
            if ball then
                local owner = ball:FindFirstChild("Owner")
                if owner and owner.Value ~= Player then
                    if ReplicatedStorage:FindFirstChild("Events") and ReplicatedStorage.Events:FindFirstChild("BallEvent") then
                        ReplicatedStorage.Events.BallEvent:FireServer("Grab", ball)
                    end
                end
            end
        end)
    end
end)

