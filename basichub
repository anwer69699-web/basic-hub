local function DoTPDown()
    PS(SFX.Clk)
    pcall(function()
        local c = LP.Character local h = gH()
        if h and c and c.Parent then
            local origin = h.CFrame.Position
            local params = RaycastParams.new()
            params.FilterDescendantsInstances = {c}
            params.FilterType = Enum.RaycastFilterType.Exclude
            local result = workspace:Raycast(origin, Vector3.new(0, -1000, 0), params)
            local targetY = -50
            if result then targetY = result.Position.Y + 3 end
            local rot = h.CFrame.Rotation local l1 = h.Velocity
            c:PivotTo(CFrame.new(h.Position.X, targetY, h.Position.Z) * rot)
            h.Velocity = l1
        end
    end)
end

local AutoTPDPaused = false

local function ToggleAutoTPD(state)
    ST.AutoTPDOn = state
    if ST.AutoTPDOn then
        PS(SFX.Tgl)
        task.spawn(function()
            while ST.AutoTPDOn and _G.ExtRunning and CoreActive do
                task.wait(0.05)
                if ST.LKA then
                    local target = FindNearest()
                    if target and target.Character then
                        local eH = target.Character:FindFirstChild("HumanoidRootPart")
                        local h = gH()
                        if eH and h and eH.Position.Y > SafeGetNumber(BX.TPD, 6, LIMITS.MAX_TPD_H) then
                            AutoTPDPaused = true
                            continue
                        end
                    end
                end
                
                AutoTPDPaused = false
                
                local h = gH()
                if h and h.Position.Y > SafeGetNumber(BX.TPD, 6, LIMITS.MAX_TPD_H) then
                    DoTPDown()
                end
            end
        end)
    else
        PS(SFX.Tgl)
        ST.AutoTPDOn = false
    end
end
