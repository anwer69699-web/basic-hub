local function FindNearest()
    local h = gH() if not h then return nil end local n, md = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local o = p.Character:FindFirstChild("HumanoidRootPart")
            if o then local d = (h.Position - o.Position).Magnitude if d < md then md = d n = p end end
        end
    end return n
end

