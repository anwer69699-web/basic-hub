--// FOHUB Smart Update System
local function ShouldUpdateAnchor(realPos)
    if not LastAnchorPosition then return true end
    
    local now = tick()
    local timePassed = now - LastUpdateTime
    
    -- شرط 1: مرّت 2 ثانية
    if timePassed >= FOHUB.UpdateInterval then
        return true, "time"
    end
    
    -- شرط 2: بعدنا 5 studs عن المرساة
    local distance = (realPos - LastAnchorPosition).Magnitude
    if distance >= FOHUB.MaxDistance then
        return true, "distance"
    end
    
    return false
end

local function GetUpdatedAnchor(realPos)
    local shouldUpdate, reason = ShouldUpdateAnchor(realPos)
    
    if shouldUpdate then
        -- تحديث قفزي (snap) - بدون تذبذب
        LastAnchorPosition = realPos
        LastUpdateTime = tick()
        
        if reason == "time" then
            print("[FOHUB] Snap: 2s elapsed")
        elseif reason == "distance" then
            print("[FOHUB] Snap: 5 studs moved")
        end
    end
    
    -- يرجع المرساة الحالية (ثابتة لحد ما يتغير)
    return LastAnchorPosition
end

--// Toggle Desync - FOHUB Style
local function ToggleDesync()
    DesyncEnabled = not DesyncEnabled
    
    if DesyncEnabled then
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        
        if hrp then
            -- يبدأ من الموقع الحالي
            LastAnchorPosition = hrp.Position
            LastUpdateTime = tick()
            TargetServerPosition = LastAnchorPosition
        end
        
        SetDesync(true)
        -- ❌ NO FastRespawn (يسبب طرد)
        
        Notify("FR HUB", "FOHUB Desync ON | 2s/5st", 2)
        
        -- يظهر البوكس
        if ServerPosPart and TargetServerPosition then
            ServerPosPart.CFrame = CFrame.new(TargetServerPosition)
        end
        
        -- Loop: 8Hz إرسال + تحديث ذكي
        local lastSend = 0
        
        Connection_RenderStepped = RunService.Heartbeat:Connect(function()
            local now = tick()
            
            -- يتحقق من التحديث: 30Hz
            pcall(function()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                
                local realPos = hrp.Position
                
                -- يحصل على المرساة (تتحدث كل 2s أو 5st)
                local anchor = GetUpdatedAnchor(realPos)
                TargetServerPosition = anchor
                
                -- يحدث البوكس الأخضر (الموقع المزيف)
                if ServerPosPart then
                    ServerPosPart.CFrame = CFrame.new(TargetServerPosition)
                end
                
                -- يحدث النص
                if DistanceLabel then
                    local dist = (realPos - TargetServerPosition).Magnitude
                    DistanceLabel.Text = "Distance: " .. math.floor(dist) .. "st | Next: 2s or 5st"
                end
            end)
            
            -- إرسال للسيرفر: 8Hz فقط (الموقع الثابت/المحسّن)
            if now - lastSend >= FOHUB.SendRate then
                lastSend = now
                if TargetServerPosition then
                    SendFakePosition(TargetServerPosition)
                end
            end
        end)
        
        CharacterAddedConnection = LocalPlayer.CharacterAdded:Connect(function(newChar)
            if not DesyncEnabled then return end
            
            local hrp = newChar:WaitForChild("HumanoidRootPart", 2)
            if not hrp then return end
            
            SetDesync(true)
            
            -- يعيد ضبط المرساة
            LastAnchorPosition = hrp.Position
            LastUpdateTime = tick()
            TargetServerPosition = LastAnchorPosition
            
            -- Loop هادئ
            task.spawn(function()
                local last = 0
                while DesyncEnabled and newChar.Parent do
                    local now = tick()
                    if now - last >= FOHUB.SendRate then
                        last = now
                        if TargetServerPosition then
                            SendFakePosition(TargetServerPosition)
                        end
                    end
                    task.wait(0.01)
                end
            end)
        end)
        
    else
        SetDesync(false)
        if Connection_RenderStepped then
            Connection_RenderStepped:Disconnect()
            Connection_RenderStepped = nil
        end
        if CharacterAddedConnection then
            CharacterAddedConnection:Disconnect()
            CharacterAddedConnection = nil
        end
        
        LastAnchorPosition = nil
        TargetServerPosition = nil
        
        if ServerPosPart then
            ServerPosPart.CFrame = CFrame.new(0, -1000, 0)
        end
        
        Notify("FR HUB", "FOHUB Desync OFF", 2)
    end
end

