--// ==================== [3] Save/Load Settings ====================

local function SaveSettings()
    pcall(function()
        local jsonString = HttpService:JSONEncode(Settings)
        writefile("FRHUB_V11_Config.json", jsonString)
    end)
end

local function LoadSettings()
    pcall(function()
        if isfile("FRHUB_V11_Config.json") then
            local jsonString = readfile("FRHUB_V11_Config.json")
            local loaded = HttpService:JSONDecode(jsonString)
            for k, v in pairs(loaded) do
                if Settings[k] ~= nil then
                    Settings[k] = v
                end
            end
        end
    end)
end

