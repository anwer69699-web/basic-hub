local bL, cL = makeBtn("LEFT", 40, Color3.fromRGB(0, 200, 0))
local bR, cR = makeBtn("RIGHT", 75, Color3.fromRGB(0, 150, 255))
local bS, cS = makeBtn("STEAL", 110, Color3.fromRGB(255, 150, 0))
