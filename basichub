        ripple.BackgroundTransparency = 0.7
        ripple.ZIndex = 10
        ripple.Parent = btn
        Instance.new("UICorner", ripple).CornerRadius = UDim.new(1, 0)
        TweenService:Create(ripple, TweenInfo.new(0.5), {Size = UDim2.new(2, 0, 2, 0), Position = UDim2.new(-0.5, 0, -0.5, 0), BackgroundTransparency = 1}):Play()
        task.delay(0.5, function() ripple:Destroy() end)
    end)
    
    return SetVisual
end

