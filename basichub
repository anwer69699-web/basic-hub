end)

btnRight.MouseButton1Click:Connect(function()
    local state = Toggle(btnRight, "AutoRight", "Auto Right", colRight)
    if state then
        Settings.AutoLeft = false
        btnLeft.Text = "Auto Left: OFF"
        btnLeft.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        btnLeft.TextColor3 = Color3.fromRGB(200, 200, 200)
        CreateVelocity()
    else
        RemoveVelocity()
    end
end)

btnSteal.MouseButton1Click:Connect(function()
    local state = Toggle(btnSteal, "InstaSteal", "Insta Steal", colSteal)
    if state then
        StealConnection = RunService.Heartbeat:Connect(function()
            if Settings.InstaSteal then
                local ball = Workspace:FindFirstChild("Basketball")
                if ball and ball:FindFirstChild("Owner") and ball.Owner.Value ~= LocalPlayer then
                    pcall(function()
                        ReplicatedStorage.Events.BallEvent:FireServer("Grab", ball)
                    end)
                end
            end
        end)
    else
        if StealConnection then
            StealConnection:Disconnect()
            StealConnection = nil
        end
    end
end)

btnDesync.MouseButton1Click:Connect(function()
    Toggle(btnDesync, "Desync", "Desync", colDesync)
end)

btnFPS.MouseButton1Click:Connect(function()
    local state = Toggle(btnFPS, "FPSBoost", "FPS Boost", colFPS)
    if state then
        settings().Rendering.QualityLevel = 1
        Workspace.GlobalShadows = false
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj:IsA("ParticleEmitter") or obj:IsA("Trail") then
                obj.Enabled = false
            elseif obj:IsA("Decal") or obj:IsA("Texture") then
                obj:Destroy()
            elseif obj:IsA("BasePart") then
                obj.Material = Enum.Material.Plastic
                obj.Reflectance = 0
            end
        end
    else
        settings().Rendering.QualityLevel = 5
        Workspace.GlobalShadows = true
    end
end)

-- Main Loop
RunService.Heartbeat:Connect(function()
    if IsClosed then return end
    
    local char = LocalPlayer.Character
    if not char then 
        RemoveVelocity()
        return 
    end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then 
        RemoveVelocity()
        return 
    end
    
    -- Update Location Box
    local pos = hrp.Position
    LocationBox.Text = string.format("X: %.1f | Y: %.1f | Z: %.1f", pos.X, pos.Y, pos.Z)
    
    -- Auto Left
    if Settings.AutoLeft and tick() - LastAutoTime > 0.15 then
        AutoIndex = AutoIndex + 1
        if AutoIndex > #LEFT_POINTS then AutoIndex = 1 end
        
        local target = LEFT_POINTS[AutoIndex]
        local direction = (target - hrp.Position).Unit
        local speed = GetSpeed()
        
        if CurrentVel then
            CurrentVel.Velocity = direction * speed
        end
        
        LastAutoTime = tick()
    end
    
    -- Auto Right
    if Settings.AutoRight and tick() - LastAutoTime > 0.15 then
        AutoIndex = AutoIndex + 1
        if AutoIndex > #RIGHT_POINTS then AutoIndex = 1 end
        
        local target = RIGHT_POINTS[AutoIndex]
        local direction = (target - hrp.Position).Unit
        local speed = GetSpeed()
        
        if CurrentVel then
            CurrentVel.Velocity = direction * speed
        end
        
        LastAutoTime = tick()
    end
    
    -- Stop velocity when not in use
    if not Settings.AutoLeft and not Settings.AutoRight and CurrentVel then
        CurrentVel.Velocity = Vector3.zero
    end
    
    -- Desync
    if Settings.Desync then
        hrp.CFrame = hrp.CFrame + Vector3.new(math.random(-20, 20), math.random(-5, 5), math.random(-20, 20))
    end
end)

