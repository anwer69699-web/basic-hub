-- Save/Load
local function SaveSettings()
    pcall(function()
        writefile("FRHUB_Full_Config.json", HttpService:JSONEncode(ScriptSettings))
    end)
end

local function LoadSettings()
    pcall(function()
        if isfile("FRHUB_Full_Config.json") then
            local loaded = HttpService:JSONDecode(readfile("FRHUB_Full_Config.json"))
            for k, v in pairs(loaded) do
                ScriptSettings[k] = v
            end
        end
    end)
end

