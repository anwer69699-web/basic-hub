-- Main Loop - AsLinearVelocity Movement
RunService.Heartbeat:Connect(function()
    local hrp = getHrp()
    if not hrp then delVel() return end
    
    -- Auto Left - حركة سلسة بـ AsLinearVelocity
    if AutoLeft and tick() - LastTime > 0.08 then
        AutoIdx = AutoIdx + 1
        if AutoIdx > #LEFT_POINTS then AutoIdx = 1 end
        
        local target = LEFT_POINTS[AutoIdx]
        local distance = (target - hrp.Position).Magnitude
        
        if distance > 5 then
            -- حركة سلسة بـ AsLinearVelocity
            local direction = (target - hrp.Position).Unit
            setVel(direction, Speed)
        else
            -- وصل للهدف، روح للنقطة الجاية
            AutoIdx = AutoIdx + 1
            if AutoIdx > #LEFT_POINTS then AutoIdx = 1 end
            target = LEFT_POINTS[AutoIdx]
            local newDir = (target - hrp.Position).Unit
            setVel(newDir, Speed)
        end
        
        LastTime = tick()
    end
    
    -- Auto Right - حركة سلسة بـ AsLinearVelocity
    if AutoRight and tick() - LastTime > 0.08 then
        AutoIdx = AutoIdx + 1
        if AutoIdx > #RIGHT_POINTS then AutoIdx = 1 end
        
        local target = RIGHT_POINTS[AutoIdx]
        local distance = (target - hrp.Position).Magnitude
        
        if distance > 5 then
            local direction = (target - hrp.Position).Unit
            setVel(direction, Speed)
        else
            AutoIdx = AutoIdx + 1
            if AutoIdx > #RIGHT_POINTS then AutoIdx = 1 end
            target = RIGHT_POINTS[AutoIdx]
            local newDir = (target - hrp.Position).Unit
            setVel(newDir, Speed)
        end
        
        LastTime = tick()
    end
    
    -- إيقاف الحركة إذا ما فيه Auto
    if not AutoLeft and not AutoRight then
        stopVel()
    end
    
    -- Desync
    if DesyncKill then
        hrp.CFrame = hrp.CFrame + Vector3.new(math.random(-20, 20), math.random(-5, 5), math.random(-20, 20))
    end
    
    if DesyncSafe then
        hrp.CFrame = hrp.CFrame + Vector3.new(math.random(-8, 8), 0, math.random(-8, 8))
    end
end)

