-- Main Loop
RunService.Heartbeat:Connect(function()
    local hrp = GetHRP()
    if not hrp then 
        RemoveVelocity()
        return 
    end
    
    -- Desync Kill (نظام FR HUB الأصلي - تيليبورت عشوائي)
    if Settings.Desync then
        hrp.CFrame = hrp.CFrame + Vector3.new(
            math.random(-20, 20),
            math.random(-5, 5),
            math.random(-20, 20)
        )
    end
    
    -- Auto Left - Smart System with Point 2 Stop
    if Settings.AutoLeft and CurrentVel then
        local target = LEFT_POINTS[AutoIndex]
        
        -- الموقع 2 (موقع السرقة)
        if AutoIndex == 2 then
            if not HasReachedPoint2 then
                -- يتحرك للموقع 2 بسرعة 25
                Status.Text = "Left: To Point 2 (Steal) - " .. Settings.SpeedSteal
                local reached = MoveToPoint(target)
                
                if reached then
                    HasReachedPoint2 = true
                    IsWaitingAtPoint2 = true
                    CurrentVel.Velocity = Vector3.zero
                    StealAttempts = 0
                    Status.Text = "Left: AT Point 2 - Stealing..."
                end
                
            else
                -- وصل الموقع 2، يحاول يسرق
                StealAttempts = StealAttempts + 1
                Status.Text = "Left: Stealing... (" .. StealAttempts .. ")"
                
                local stolen = TrySteal()
                
                -- إذا سرق أو حاول كثير، يكمل
                if stolen or StealAttempts > 20 then
                    IsWaitingAtPoint2 = false
                    AutoIndex = 3 -- يروح للموقع 3
                    Status.Text = "Left: Got ball! Continue..."
                    task.wait(0.2)
                end
            end
            
        else
            -- المواقع 1, 3, 4 (عادية)
            local speed = GetSpeed()
            Status.Text = "Left: To Point " .. AutoIndex .. " - " .. speed
            
            local reached = MoveToPoint(target)
            
            if reached then
                -- وصل 100%، يروح للموقع الجاي
                AutoIndex = AutoIndex + 1
                if AutoIndex > #LEFT_POINTS then
                    AutoIndex = 1
                    HasReachedPoint2 = false -- إعادة الدورة
                end
                LastAutoTime = tick()
            end
        end
    end
    
    -- Auto Right - Smart System with Point 2 Stop (نفس المنطق)
    if Settings.AutoRight and CurrentVel then
        local target = RIGHT_POINTS[AutoIndex]
        
        if AutoIndex == 2 then
            if not HasReachedPoint2 then
                Status.Text = "Right: To Point 2 (Steal) - " .. Settings.SpeedSteal
                local reached = MoveToPoint(target)
                
                if reached then
                    HasReachedPoint2 = true
                    IsWaitingAtPoint2 = true
                    CurrentVel.Velocity = Vector3.zero
                    StealAttempts = 0
                    Status.Text = "Right: AT Point 2 - Stealing..."
                end
                
            else
                StealAttempts = StealAttempts + 1
                Status.Text = "Right: Stealing... (" .. StealAttempts .. ")"
                
                local stolen = TrySteal()
                
                if stolen or StealAttempts > 20 then
                    IsWaitingAtPoint2 = false
                    AutoIndex = 3
                    Status.Text = "Right: Got ball! Continue..."
                    task.wait(0.2)
                end
            end
            
        else
            local speed = GetSpeed()
            Status.Text = "Right: To Point " .. AutoIndex .. " - " .. speed
            
            local reached = MoveToPoint(target)
            
            if reached then
                AutoIndex = AutoIndex + 1
                if AutoIndex > #RIGHT_POINTS then
                    AutoIndex = 1
                    HasReachedPoint2 = false
                end
                LastAutoTime = tick()
            end
        end
    end
    
    -- Stop velocity if not active
    if not Settings.AutoLeft and not Settings.AutoRight and CurrentVel then
        CurrentVel.Velocity = Vector3.zero
    end
end)

