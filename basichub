        pcall(function()
            if Status and Status.Parent then
                local state = Settings.AutoLeft and "Left" or Settings.AutoRight and "Right" or "Ready"
                Status.Text = string.format("%s | N:%d | S:%d", state, Settings.SpeedNormal, Settings.SpeedSteal)
            end
        end)
    end
end)

