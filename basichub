local Settings = {
    AutoLeft = false,
    AutoRight = false,
    Desync = false,
    SpeedNormal = 40,
    SpeedSteal = 25,
    StopDistance = 2
}

-- Points
local LEFT_POINTS = {
    Vector3.new(-473.43, -7.30, 95.59),   -- 1: بداية
    Vector3.new(-485.73, -5.15, 95.42),   -- 2: موقع السرقة (يتوقف)
    Vector3.new(-473.43, -7.30, 95.59),   -- 3: رجوع
    Vector3.new(-473.96, -7.30, 19.63)    -- 4: نهاية
}

local RIGHT_POINTS = {
    Vector3.new(-474.13, -7.30, 24.17),   -- 1: بداية
    Vector3.new(-485.17, -5.15, 25.08),   -- 2: موقع السرقة (يتوقف)
    Vector3.new(-474.13, -7.30, 24.17),   -- 3: رجوع
    Vector3.new(-474.55, -7.30, 23.52)    -- 4: نهاية
}

-- Variables
local CurrentVel = nil
local AutoIndex = 1
local LastAutoTime = 0
local IsWaitingAtPoint2 = false
local HasReachedPoint2 = false
local StealAttempts = 0

-- Get HRP
local function GetHRP()
    local char = LocalPlayer.Character
    if char then return char:FindFirstChild("HumanoidRootPart") end
    return nil
end

-- Has Ball
local function HasBall()
    local char = LocalPlayer.Character
    if not char then return false end
    return char:FindFirstChild("Basketball") ~= nil
end

-- Get Speed
local function GetSpeed()
    -- سرعة 25 قبل الموقع 2 وإذا كان في وضع السرقة
    if AutoIndex == 2 or (AutoIndex == 1 and not HasReachedPoint2) then
        return Settings.SpeedSteal
    end
    return Settings.SpeedNormal
end

-- Create BodyVelocity
local function CreateVelocity()
    local hrp = GetHRP()
    if not hrp then return nil end
    
    if CurrentVel then CurrentVel:Destroy() end
    
    for _, v in pairs(hrp:GetChildren()) do
        if v:IsA("BodyVelocity") then v:Destroy() end
    end
    
    local vel = Instance.new("BodyVelocity")
    vel.MaxForce = Vector3.new(400000, 400000, 400000)
    vel.Velocity = Vector3.zero
    vel.P = 10000
    vel.Parent = hrp
    
    CurrentVel = vel
    return vel
end

local function RemoveVelocity()
    if CurrentVel then
        CurrentVel:Destroy()
        CurrentVel = nil
    end
end

-- Try Steal
local function TrySteal()
    local ball = Workspace:FindFirstChild("Basketball")
    if not ball then return false end
    
    local owner = ball:FindFirstChild("Owner")
    if not owner or owner.Value == LocalPlayer then return false end
    
    for i = 1, 3 do
        pcall(function()
            ReplicatedStorage.Events.BallEvent:FireServer("Grab", ball)
        end)
        task.wait(0.02)
    end
    
    return HasBall()
end

-- Move with BodyVelocity
local function MoveToPoint(target)
    if not CurrentVel then return false end
    
    local hrp = GetHRP()
    if not hrp then return false end
    
    local distance = (target - hrp.Position).Magnitude
    
    if distance < Settings.StopDistance then
        CurrentVel.Velocity = Vector3.zero
        return true -- وصل 100%
    end
    
    local direction = (target - hrp.Position).Unit
    local speed = GetSpeed()
    
    CurrentVel.Velocity = direction * speed
    return false
end

