            TweenService:Create(statusLine, info, {Size = UDim2.new(0, 0, 0, 2)}):Play()
        end
    end
    
    btn.MouseButton1Click:Connect(function()
        local newState = not isActive
        updateVisual(newState)
        callback(newState)
    end)
    
    return updateVisual
end

local function CreateSlider(name, min, max, default, color, parent, yPos, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -4, 0, 45)
    frame.Position = UDim2.new(0, 2, 0, yPos)
    frame.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
    frame.BorderSizePixel = 0
    frame.Parent = parent
    
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.5, 0, 0, 18)
    label.Position = UDim2.new(0, 8, 0, 4)
    label.BackgroundTransparency = 1
    label.Text = name
    label.TextColor3 = Color3.fromRGB(180, 180, 190)
    label.TextSize = 10
    label.Font = Enum.Font.GothamBold
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = frame
    
    local valueLabel = Instance.new("TextLabel")
    valueLabel.Size = UDim2.new(0.4, 0, 0, 18)
    valueLabel.Position = UDim2.new(0.5, 0, 0, 4)
    valueLabel.BackgroundTransparency = 1
    valueLabel.Text = tostring(default)
    valueLabel.TextColor3 = color
    valueLabel.TextSize = 10
    valueLabel.Font = Enum.Font.GothamBold
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right
    valueLabel.Parent = frame
    
    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, -16, 0, 6)
    track.Position = UDim2.new(0, 8, 0, 28)
    track.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    track.BorderSizePixel = 0
    track.Parent = frame
    
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)
    
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = color
    fill.BorderSizePixel = 0
    fill.Parent = track
    
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
    
    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 12, 0, 12)
    knob.Position = UDim2.new((default - min) / (max - min), -6, 0.5, -6)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.BorderSizePixel = 0
    knob.Parent = track
    
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)
    
    local dragging = false
    
    local function updateSlider(input)
        local pos = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local value = math.floor(min + (max - min) * pos)
        fill.Size = UDim2.new(pos, 0, 1, 0)
        knob.Position = UDim2.new(pos, -6, 0.5, -6)
        valueLabel.Text = tostring(value)
        callback(value)
    end
    
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            updateSlider(input)
        end
    end)
    
    track.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            updateSlider(input)
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
    return function(newValue)
        local pos = (newValue - min) / (max - min)
        fill.Size = UDim2.new(pos, 0, 1, 0)
        knob.Position = UDim2.new(pos, -6, 0.5, -6)
        valueLabel.Text = tostring(newValue)
    end
end

--// ==================== [8] ORIGINAL INSTA STEAL (ENHANCED) ====================

local InstaStealConnection = nil

local function StartInstaSteal()
    if InstaStealConnection then return end
    
    InstaStealConnection = task.spawn(function()
        while Settings.InstaSteal do
            SafeCall(function()
                local plots = Workspace:FindFirstChild("Plots")
                if not plots then return end
                
                for _, plot in pairs(plots:GetChildren()) do
                    if not Settings.InstaSteal then break end
                    
                    local podiums = plot:FindFirstChild("AnimalPodiums")
                    if podiums then
                        for _, podium in pairs(podiums:GetChildren()) do
                            if not Settings.InstaSteal then break end
                            
                            local base = podium:FindFirstChild("Base")
                            local spawn = base and base:FindFirstChild("Spawn")
                            local att = spawn and spawn:FindFirstChild("PromptAttachment")
                            
                            if att then
                                for _, prompt in pairs(att:GetChildren()) do
                                    if prompt:IsA("ProximityPrompt") then
                                        prompt.HoldDuration = 0.01
                                        prompt.MaxActivationDistance = 12
                                    end
                                end
                            end
                        end
                    end
                end
            end)
            task.wait(0.1)
        end
    end)
end

local function StopInstaSteal()
    Settings.InstaSteal = false
    InstaStealConnection = nil
end

--// ==================== [9] GALAXY SYSTEM ====================

local galaxyVectorForce = nil
local galaxyAttachment = nil
local spaceHeld = false
local lastHopTime = 0
local cachedMass = nil

local function CalculateMass()
    SafeCall(function()
        local c = LocalPlayer.Character
        if not c then return end
        
        cachedMass = 0
        for _, p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") then
                cachedMass = cachedMass + p:GetMass()
            end
        end
    end)
end

local function SetupGalaxy()
    SafeCall(function()
        local c = LocalPlayer.Character
        if not c then return end
        local h = c:FindFirstChild("HumanoidRootPart")
        if not h then return end
        
        if galaxyVectorForce then galaxyVectorForce:Destroy() end
        if galaxyAttachment then galaxyAttachment:Destroy() end
        
        galaxyAttachment = Instance.new("Attachment")
        galaxyAttachment.Parent = h
        
        galaxyVectorForce = Instance.new("VectorForce")
        galaxyVectorForce.Attachment0 = galaxyAttachment
        galaxyVectorForce.ApplyAtCenterOfMass = true
        galaxyVectorForce.RelativeTo = Enum.ActuatorRelativeTo.World
        galaxyVectorForce.Force = Vector3.new(0, 0, 0)
        galaxyVectorForce.Parent = h
        
        CalculateMass()
    end)
end

local function UpdateGalaxy()
    if not Settings.Galaxy or not galaxyVectorForce then return end
    if not cachedMass then CalculateMass() end
    if not cachedMass then return end
    
    local targetGravity = workspace.Gravity * (Settings.GalaxyGravityPercent / 100)
    galaxyVectorForce.Force = Vector3.new(0, cachedMass * (workspace.Gravity - targetGravity) * 0.98, 0)
end

local function DoMiniHop()
    if not Settings.Galaxy then return end
    
    SafeCall(function()
        local c = LocalPlayer.Character
        if not c then return end
        local h = c:FindFirstChild("HumanoidRootPart")
        local hum = c:FindFirstChildOfClass("Humanoid")
        if not h or not hum then return end
        
        if tick() - lastHopTime < Settings.GalaxyHopCooldown then return end
        lastHopTime = tick()
        
        if spaceHeld and hum.FloorMaterial == Enum.Material.Air then
            h.AssemblyLinearVelocity = Vector3.new(
                h.AssemblyLinearVelocity.X,
                Settings.GalaxyHopPower,
                h.AssemblyLinearVelocity.Z
            )
        end
    end)
end

--// ==================== [10] SPEED SYSTEM (FIXED) ====================

local SpeedConnection = nil

local function StartSpeedBoost()
    if SpeedConnection then return end
    
    SpeedConnection = RunService.Heartbeat:Connect(function()
        if not Settings.SpeedBoost then return end
        
        SafeCall(function()
            local c = LocalPlayer.Character
            if not c then return end
            local h = c:FindFirstChild("HumanoidRootPart")
            local hum = c:FindFirstChildOfClass("Humanoid")
            if not h or not hum then return end
            
            local isStealing = LocalPlayer:GetAttribute("Stealing")
            if isStealing then return end
            
            local md = hum.MoveDirection
            if md.Magnitude < 0.1 then return end
            
            h.AssemblyLinearVelocity = Vector3.new(
                md.X * Settings.NormalSpeed,
                h.AssemblyLinearVelocity.Y,
                md.Z * Settings.NormalSpeed
            )
        end)
    end)
end

local function StopSpeedBoost()
    if SpeedConnection then
        SpeedConnection:Disconnect()
        SpeedConnection = nil
    end
end

--// ==================== [11] ORIGINAL INVISIBILITY (ENHANCED) ====================

local InvisibilityConnection = nil
local LastUpdateTime = 0

local function SendFakePosition(position)
    SafeCall(function()
        local cf = CFrame.new(position)
        
        if typeof(rnet) == "table" then
            if rnet.sendphysics then rnet.sendphysics(cf) end
            if rnet.sendposition then rnet.sendposition(position) end
        end
        
        if typeof(delta) == "table" then
            if delta.sendphysics then delta.sendphysics(cf) end
            if delta.sendposition then delta.sendposition(position) end
        end
    end)
end

local function SetDesync(state)
    SafeCall(function()
        if typeof(rnet) == "table" then
            if rnet.setdesync then rnet.setdesync(state) end
            if rnet.desync then rnet.desync(state) end
        end
        if typeof(delta) == "table" then
            if delta.raknet_desync then delta.raknet_desync(state) end
            if delta.desync then delta.desync(state) end
        end
    end)
end

local function StartInvisibility()
    SetDesync(true)
    
    SafeCall(function()
        local c = LocalPlayer.Character
        if c then
            local h = c:FindFirstChild("HumanoidRootPart")
            if h then
                SendFakePosition(h.Position)
            end
        end
    end)
    
    InvisibilityConnection = task.spawn(function()
        while Settings.Invisibility do
            local currentTime = tick()
            if currentTime - LastUpdateTime >= 3 then
                LastUpdateTime = currentTime
                
                SafeCall(function()
                    local c = LocalPlayer.Character
                    if not c then return end
                    local h = c:FindFirstChild("HumanoidRootPart")
                    if not h then return end
                    
                    SendFakePosition(h.Position)
                end)
            end
            task.wait(0.1)
        end
    end)
    
    Notify("FR HUB", "الاختفاء مفعل! 👻", 3)
end

local function StopInvisibility()
    Settings.Invisibility = false
    SetDesync(false)
    Notify("FR HUB", "الاختفاء متوقف", 2)
end

