-- Auto System
local function StartAutoSystem()
    if AutoConnection then AutoConnection:Disconnect() end
    
    AutoConnection = RunService.Heartbeat:Connect(function()
        if not Settings.AutoLeft and not Settings.AutoRight then return end
        
        local hrp = GetHRP()
        local hum = GetHumanoid()
        if not hrp or not hum then return end
        
        local points = CurrentPath == "LEFT" and LEFT_POINTS or RIGHT_POINTS
        
        if WaitingForSteal then
            hum:Move(Vector3.zero, false)
            local stolen = TrySteal()
            if stolen or HasBall() then
                WaitingForSteal = false
                AutoPhase = "POINT_3"
            end
            return
        end
        
        local currentPoint = points[AutoPhase]
        if not currentPoint then
            AutoPhase = "START"
            currentPoint = points.START
        end
        
        local targetPos = Vector3.new(currentPoint.X, hrp.Position.Y, currentPoint.Z)
        local distance = (targetPos - hrp.Position).Magnitude
        
        if distance < 2 then
            if AutoPhase == "START" then
                AutoPhase = "POINT_2"
            elseif AutoPhase == "POINT_2" then
                WaitingForSteal = true
                hum:Move(Vector3.zero, false)
                return
            elseif AutoPhase == "POINT_3" then
                AutoPhase = "END"
            elseif AutoPhase == "END" then
                AutoPhase = "START"
                return
            end
        end
        
        local direction = (targetPos - hrp.Position).Unit
        direction = Vector3.new(direction.X, 0, direction.Z).Unit
        
        local speed = HasBall() and Settings.SpeedSteal or Settings.SpeedNormal
        
        hum:Move(direction, false)
        hrp.AssemblyLinearVelocity = Vector3.new(
            direction.X * speed,
            hrp.AssemblyLinearVelocity.Y,
            direction.Z * speed
        )
    end)
end

local function StopAutoSystem()
    if AutoConnection then
        AutoConnection:Disconnect()
        AutoConnection = nil
    end
    local hum = GetHumanoid()
    if hum then hum:Move(Vector3.zero, false) end
    CurrentPath = nil
    AutoPhase = "START"
    WaitingForSteal = false
end

