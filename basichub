    Settings.AutoLeft = false
    Settings.AutoRight = false
    Settings.InstaSteal = false
    Settings.Desync = false
    
    RemoveVelocity()
    
    if StealConnection then
        StealConnection:Disconnect()
        StealConnection = nil
    end
end)

-- Toggle Function
local function Toggle(btn, setting, onText, onColor)
    Settings[setting] = not Settings[setting]
    if Settings[setting] then
        btn.BackgroundColor3 = onColor
        btn.Text = onText .. ": ON"
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    else
        btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        btn.Text = onText .. ": OFF"
        btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    end
    return Settings[setting]
end

-- Click Events
btnLeft.MouseButton1Click:Connect(function()
    local state = Toggle(btnLeft, "AutoLeft", "Auto Left", colLeft)
    if state then
        Settings.AutoRight = false
        btnRight.Text = "Auto Right: OFF"
        btnRight.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        btnRight.TextColor3 = Color3.fromRGB(200, 200, 200)
