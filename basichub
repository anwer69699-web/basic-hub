        local IsRag = function() return BS[h:GetState()] == true end
        local StartRec = function()
            if ST.AntiRagRC then return end ST.AntiRagRC = true
            task.spawn(function()
                local eT = tick() + 0.5
                while tick() < eT do
                    if IsRag() or h:GetState() == Enum.HumanoidStateType.GettingUp then
                        CleanCon(c) pcall(function() h:ChangeState(Enum.HumanoidStateType.Running) end)
                        local v = r.Velocity if v.Magnitude > 30 then r.Velocity = Vector3.new(0, math.min(v.Y, 5), 0) end
