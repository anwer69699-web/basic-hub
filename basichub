local SpdGuis = {}

local function CreateSpdGui(ch)
    local hr = ch:WaitForChild("HumanoidRootPart", 5)
    if not hr then return end

    if SpdGuis[ch] then
        pcall(function()
            SpdGuis[ch]:Destroy()
        end)
    end

    local bb = Instance.new("BillboardGui")
    bb.Name = "ExtSpdUI"
    bb.Adornee = hr
    bb.Size = UDim2.new(0, 180, 0, 55)
    bb.StudsOffset = Vector3.new(0, 3, 0)
    bb.AlwaysOnTop = true
    bb.MaxDistance = 1000
    bb.Parent = ch

    local t = Instance.new("TextLabel")
    t.Name = "SpeedText"
    t.Text = "0"
    t.TextColor3 = C.GRN
    t.Font = Enum.Font.GothamBlack
    t.TextSize = 22
    t.BackgroundTransparency = 1
    t.Size = UDim2.new(1, 0, 0, 28)
    t.ZIndex = 2
    t.Parent = bb

    TextGrad(t)

    local dt = Instance.new("TextLabel")
    dt.Name = "DiscordText"
    dt.Text = "discord.gg/74uPHYN2s4" -- ضع النص هنا
    dt.TextColor3 = C.GRN_DARK
    dt.Font = Enum.Font.GothamBlack
    dt.TextSize = 12
    dt.BackgroundTransparency = 1
    dt.Size = UDim2.new(1, 0, 0, 18)
    dt.Position = UDim2.new(0, 0, 0, 28)
    dt.ZIndex = 2
    dt.Parent = bb

    TextGrad(dt)

    SpdGuis[ch] = bb
end

Players.PlayerRemoving:Connect(function(p)
    if p.Character and SpdGuis[p.Character] then
        pcall(function()
            SpdGuis[p.Character]:Destroy()
        end)

        SpdGuis[p.Character] = nil
    end
end)

RunService.RenderStepped:Connect(function()

    if not (_G.ExtRunning and CoreActive) then
        return
    end

    for _, p in ipairs(Players:GetPlayers()) do

        local ch = p.Character
        if not ch then
            continue
        end

        local hr = ch:FindFirstChild("HumanoidRootPart")
        if not hr then
            continue
        end

        if not SpdGuis[ch] or not SpdGuis[ch].Parent then
            CreateSpdGui(ch)
        end

        local bb = SpdGuis[ch]

        if bb then

            if bb.Adornee ~= hr then
                bb.Adornee = hr
            end

            local txt = bb:FindFirstChild("SpeedText")

            if txt then
                local velocity = hr.AssemblyLinearVelocity
                local speed = math.floor(Vector3.new(
                    velocity.X,
                    0,
                    velocity.Z
                ).Magnitude + 0.5)

                txt.Text = string.format("%d SPS", speed)
            end
        end
    end
end)

local function RestorePositions()
    if _LoadedSave.Positions then
        for name, pos in pairs(_LoadedSave.Positions) do
            local elem = UIElements[name]
            if elem and elem.Parent and pos.X and pos.Y then
                pcall(function() elem.Position = UDim2.new(pos.X.Scale, pos.X.Offset, pos.Y.Scale, pos.Y.Offset) end)
            end
        end
    end
end

