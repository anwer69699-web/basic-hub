--// ==================== [5] Galaxy/Anti-Ragdoll System ====================
local function SetupGalaxyForce()
    SafeCall(function()
        local hrp = GetHRP()
        if not hrp then return end

        if galaxyVectorForce then galaxyVectorForce:Destroy() end
        if galaxyAttachment then galaxyAttachment:Destroy() end

        galaxyAttachment = Instance.new("Attachment")
        galaxyAttachment.Parent = hrp

        galaxyVectorForce = Instance.new("VectorForce")
        galaxyVectorForce.Attachment0 = galaxyAttachment
        galaxyVectorForce.ApplyAtCenterOfMass = true
        galaxyVectorForce.RelativeTo = Enum.ActuatorRelativeTo.World
        galaxyVectorForce.Force = Vector3.new(0, 0, 0)
        galaxyVectorForce.Parent = hrp
    end)
end

local function UpdateGalaxyForce()
    if not galaxyVectorForce then return end
    SafeCall(function()
        local char = GetCharacter()
        if not char then return end

        local mass = 0
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then mass = mass + p:GetMass() end
        end

        local tg = Settings.DefaultGravity * (Settings.GalaxyGravity / 100)
        galaxyVectorForce.Force = Vector3.new(0, mass * (Settings.DefaultGravity - tg) * 0.95, 0)
    end)
end

local function DoMiniHop()
    SafeCall(function()
        local hrp = GetHRP()
        local hum = GetHumanoid()
        if not hrp or not hum then return end

        if tick() - lastHopTime < 0.08 then return end
        lastHopTime = tick()

        if hum.FloorMaterial == Enum.Material.Air then
            hrp.AssemblyLinearVelocity = Vector3.new(
                hrp.AssemblyLinearVelocity.X, 35, hrp.AssemblyLinearVelocity.Z
            )
        end
    end)
end

--// ==================== [6] Auto Movement System (FIXED) ====================
local function StartAutoSystem()
    if Connections.Movement then return end

    print("[LevixFR] Auto System Started")

    Connections.Movement = RunService.Heartbeat:Connect(function()
        if not Settings.AutoLeft and not Settings.AutoRight then return end

        SafeCall(function()
            local hrp = GetHRP()
            local hum = GetHumanoid()
            if not hrp or not hum then return end

            local points = Settings.AutoLeft and LEFT_POINTS or RIGHT_POINTS
            currentPath = Settings.AutoLeft and "LEFT" or "RIGHT"

            -- Handle waiting for steal
            if waitingForSteal then
                if IsStealing() or HasBall() then
                    waitingForSteal = false
                    autoPhase = "POINT_3"
                    print("[LevixFR] Steal successful, continuing to POINT_3")
                else
                    hum:Move(Vector3.zero, false)
                    hrp.AssemblyLinearVelocity = Vector3.new(0, hrp.AssemblyLinearVelocity.Y, 0)
                    return
                end
            end

            -- Get current target point
            local currentPoint = points[autoPhase]
            if not currentPoint then
                autoPhase = "START"
                currentPoint = points.START
            end

            local targetPos = Vector3.new(currentPoint.X, hrp.Position.Y, currentPoint.Z)
            local dist = (targetPos - hrp.Position).Magnitude

            -- Phase transition logic - FIXED
            if dist < 2 then
                if autoPhase == "START" then
                    autoPhase = "POINT_2"
                    print("[LevixFR] Reached START -> POINT_2")

                elseif autoPhase == "POINT_2" then
                    waitingForSteal = true
                    hum:Move(Vector3.zero, false)
                    print("[LevixFR] At POINT_2, waiting for steal...")
                    return

                elseif autoPhase == "POINT_3" then
                    autoPhase = "END"
                    print("[LevixFR] Reached POINT_3 -> END")

                elseif autoPhase == "END" then
                    autoPhase = "START"
                    waitingForSteal = false
                    print("[LevixFR] Loop complete, restarting")
                    return
                end
            end

            -- Calculate movement
            local isStealing = IsStealing()
            local speed = isStealing and Settings.SpeedSteal or Settings.SpeedNormal

            -- Ensure minimum speed
            if speed < Settings.MaxSpeed and not isStealing then
                speed = Settings.MaxSpeed
            end

            local dir = (targetPos - hrp.Position).Unit
            dir = Vector3.new(dir.X, 0, dir.Z).Unit

            -- Apply velocity with micro-jitter for anti-cheat
            local jitter = Vector3.new(
                math.random(-5, 5) * 0.01,
                0,
                math.random(-5, 5) * 0.01
            )

            local velocity = dir * speed
            hrp.AssemblyLinearVelocity = Vector3.new(
                velocity.X + jitter.X,
                hrp.AssemblyLinearVelocity.Y,
                velocity.Z + jitter.Z
            )

            hum:Move(dir, false)
        end)
    end)
end

local function StopAutoSystem()
    if Connections.Movement then
        Connections.Movement:Disconnect()
        Connections.Movement = nil
    end

    autoPhase = "START"
    waitingForSteal = false
    currentPath = nil

    SafeCall(function()
        local hum = GetHumanoid()
        if hum then hum:Move(Vector3.zero, false) end
    end)

    print("[LevixFR] Auto System Stopped")
end

--// ==================== [7] Insta Steal System (FR HUB) ====================
local function StartInstaStealSystem()
    task.spawn(function()
        while task.wait(0.1) do
            if not isInstaGrabActive then continue end

            SafeCall(function()
                -- Fast grab prompts
                local plots = Workspace:FindFirstChild("Plots")
                if plots then
                    for _, plot in pairs(plots:GetChildren()) do
                        local podiums = plot:FindFirstChild("AnimalPodiums")
                        if podiums then
                            for _, podium in pairs(podiums:GetChildren()) do
                                local base = podium:FindFirstChild("Base")
                                local spawn = base and base:FindFirstChild("Spawn")
                                local att = spawn and spawn:FindFirstChild("PromptAttachment")

                                if att then
                                    for _, prompt in pairs(att:GetChildren()) do
                                        if prompt:IsA("ProximityPrompt") then
                                            prompt.HoldDuration = 0.03
                                        end
                                    end
                                end
                            end
                        end
                    end
                end

                -- Auto grab ball
                local ball = Workspace:FindFirstChild("Basketball")
                if ball then
                    local owner = ball:FindFirstChild("Owner")
                    if owner and owner.Value ~= Player then
                        if ReplicatedStorage:FindFirstChild("Events") and 
                           ReplicatedStorage.Events:FindFirstChild("BallEvent") then
                            ReplicatedStorage.Events.BallEvent:FireServer("Grab", ball)
                        end
                    end
                end
            end)
        end
    end)
end

--// ==================== [8] Desync System (FR HUB - Fixed) ====================
local function SetDesync(state)
    SafeCall(function()
        if typeof(rnet) == "table" then
            if rnet.setdesync then rnet.setdesync(state) end
            if rnet.desync then rnet.desync(state) end
        end
        if typeof(delta) == "table" then
            if delta.raknet_desync then delta.raknet_desync(state) end
            if delta.desync then delta.desync(state) end
        end
    end)
end

local function SendFakePosition(position)
    SafeCall(function()
        local cf = CFrame.new(position)
        if typeof(rnet) == "table" then
            if rnet.sendphysics then rnet.sendphysics(cf) end
            if rnet.sendposition then rnet.sendposition(position) end
        end
        if typeof(delta) == "table" then
            if delta.sendphysics then delta.sendphysics(cf) end
            if delta.sendposition then delta.sendposition(position) end
        end
    end)
end

local function FastRespawn()
    SafeCall(function()
        local char = Player.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then return end

        hrp.Velocity = Vector3.new(0, 5000, 0)
        hrp.RotVelocity = Vector3.new(99999, 99999, 99999)

        task.delay(0.05, function()
            if hum then hum:ChangeState(Enum.HumanoidStateType.Dead) end
        end)
    end)
end

local function ToggleDesync()
    DesyncEnabled = not DesyncEnabled

    if DesyncEnabled then
        local hrp = GetHRP()
        if hrp then TargetServerPosition = hrp.Position end

        SetDesync(true)
        FastRespawn()

        Connections.Desync = RunService.RenderStepped:Connect(function()
            SafeCall(function()
                local hrp = GetHRP()
                if hrp and TargetServerPosition then
                    SendFakePosition(TargetServerPosition)
                end
            end)
        end)

        print("[LevixFR] Desync Enabled")
    else
        SetDesync(false)
        if Connections.Desync then
            Connections.Desync:Disconnect()
            Connections.Desync = nil
        end
        TargetServerPosition = nil
        print("[LevixFR] Desync Disabled")
    end

    return DesyncEnabled
end

