    }):Play()
    MinBtn.Text = minimized and "+" or "—"
end)

local function setToggle(state)
    laggerEnabled = state
    local goal = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
    TweenService:Create(SwitchKnob, TweenInfo.new(0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Position = goal}):Play()
    if state then
        startLagger()
    else
        stopLagger()
    end
end

ToggleBtn.MouseButton1Click:Connect(function()
    setToggle(not laggerEnabled)
end)

