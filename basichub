--// FR HUB V13 LITE (ULTRA STABLE)

repeat task.wait() until game:IsLoaded()

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

--// SETTINGS
local NormalSpeed = 40
local StealSpeed = 25

local SpeedOn = false
local StealMode = false

--// GUI
local gui = Instance.new("ScreenGui", LocalPlayer:WaitForChild("PlayerGui"))

local frame = Instance.new("Frame", gui)
frame.Size = UDim2.new(0,200,0,200)
frame.Position = UDim2.new(0.02,0,0.3,0)
frame.BackgroundColor3 = Color3.fromRGB(25,25,25)

--// NORMAL SPEED BOX
local normalBox = Instance.new("TextBox", frame)
normalBox.Size = UDim2.new(1,0,0,30)
normalBox.Position = UDim2.new(0,0,0,0)
normalBox.Text = tostring(NormalSpeed)
normalBox.PlaceholderText = "Normal Speed"

normalBox.FocusLost:Connect(function()
local v = tonumber(normalBox.Text)
if v then
NormalSpeed = math.clamp(v,16,100)
end
end)

--// STEAL SPEED BOX
local stealBox = Instance.new("TextBox", frame)
stealBox.Size = UDim2.new(1,0,0,30)
stealBox.Position = UDim2.new(0,0,0,35)
stealBox.Text = tostring(StealSpeed)
stealBox.PlaceholderText = "Steal Speed"

stealBox.FocusLost:Connect(function()
local v = tonumber(stealBox.Text)
if v then
StealSpeed = math.clamp(v,10,60)
end
end)

--// SPEED BUTTON
local speedBtn = Instance.new("TextButton", frame)
speedBtn.Size = UDim2.new(1,0,0,30)
speedBtn.Position = UDim2.new(0,0,0,80)
speedBtn.Text = "Speed OFF"

speedBtn.MouseButton1Click:Connect(function()
SpeedOn = not SpeedOn
speedBtn.Text = SpeedOn and "Speed ON" or "Speed OFF"
end)

--// STEAL BUTTON
local stealBtn = Instance.new("TextButton", frame)
stealBtn.Size = UDim2.new(1,0,0,30)
stealBtn.Position = UDim2.new(0,0,0,115)
stealBtn.Text = "Steal Mode OFF"

stealBtn.MouseButton1Click:Connect(function()
StealMode = not StealMode
stealBtn.Text = StealMode and "Steal Mode ON" or "Steal Mode OFF"
end)

--// MAIN LOOP (خفيف جداً)
task.spawn(function()
while task.wait(0.3) do
if not SpeedOn then continue end

