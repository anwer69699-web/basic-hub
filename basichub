-- ============================================
-- INSTANT STEAL SYSTEM
-- ============================================
local BreakLoop = nil
local BreakLoopActive = false

local function getPlotOwner(plot)
    local success, result = pcall(function()
        local sign = plot:FindFirstChild("Sign") or plot:FindFirstChild("PlotSign") or plot:FindFirstChild("OwnerSign")
        if sign then
            local surfaceGui = sign:FindFirstChildOfClass("SurfaceGui") or sign:FindFirstChild("SurfaceGui")
            if surfaceGui then
                local textLabel = surfaceGui:FindFirstChildOfClass("TextLabel") or surfaceGui:FindFirstChild("TextLabel")
                if textLabel and textLabel.Text then
                    return textLabel.Text:match("^%s*(.-)%s*$")
                end
            end
            local ownerVal = sign:FindFirstChild("Owner") or sign:FindFirstChild("OwnerName")
            if ownerVal and ownerVal:IsA("StringValue") then
                return ownerVal.Value
            end
        end
        if plot:GetAttribute("Owner") then
            return tostring(plot:GetAttribute("Owner"))
        end
        if plot:GetAttribute("OwnerName") then
            return tostring(plot:GetAttribute("OwnerName"))
        end
        local ownerObj = plot:FindFirstChild("Owner") or plot:FindFirstChild("PlotOwner")
        if ownerObj and ownerObj:IsA("ObjectValue") and ownerObj.Value then
            return ownerObj.Value.Name
        end
    end)
    return success and result or nil
end

local function isMyPlot(plot)
    local owner = getPlotOwner(plot)
    if not owner then return false end
    return owner:lower() == Player.Name:lower() or owner:lower() == Player.DisplayName:lower()
end

local function applyInstantFixed(prompt)
    if not prompt then return end
    prompt.HoldDuration = 0
    prompt.RequiresLineOfSight = false
end

local lastPromptCheck = 0

local function startInstantGrab()
    if BreakLoopActive then return end
    BreakLoopActive = true

    BreakLoop = task.spawn(function()
        while BreakLoopActive do
            task.wait(0.03)
            
            local now = tick()
            if now - lastPromptCheck < 0.03 then continue end
            lastPromptCheck = now
            
            pcall(function()
                local char = Player.Character
                if not char then return end
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                
                local searchRadius = 18
                local region = Region3.new(
                    hrp.Position - Vector3.new(searchRadius, 10, searchRadius), 
                    hrp.Position + Vector3.new(searchRadius, 10, searchRadius)
                )
                local parts = workspace:FindPartsInRegion3(region, char, 100)
                
                for _, part in ipairs(parts) do
                    local plot = part:FindFirstAncestorOfClass("Model") or part.Parent
                    if plot and isMyPlot(plot) then
                        continue
                    end
                    
                    for _, child in ipairs(part:GetDescendants()) do
                        if child:IsA("ProximityPrompt") then
                            applyInstantFixed(child)
                        end
                    end
                end
            end)
        end
    end)
end

local function stopInstantGrab()
    BreakLoopActive = false
    if BreakLoop then
        task.cancel(BreakLoop)
        BreakLoop = nil
    end
end

