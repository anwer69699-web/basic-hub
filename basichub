Player.CharacterAdded:Connect(function()
    task.wait(0.5)
    
    if Settings.AutoLeft or Settings.AutoRight then
        autoPhase = "START"
        waitingForSteal = false
        StartAutoSystem()
    end
    
    if Settings.Desync then
        task.wait(0.3)
        local hrp = GetHRP()
        if hrp then
            TargetServerPosition = hrp.Position
            SetDesync(true)
            if ServerPosPart then
                ServerPosPart.CFrame = CFrame.new(TargetServerPosition)
                ServerPosHighlight.Visible = true
            end
        end
    end
end)

