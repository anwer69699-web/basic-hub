-- Main Loop - BodyVelocity Movement
RunService.Heartbeat:Connect(function()
    -- Auto Left
    if ScriptSettings.AutoLeft then
        local target = LEFT_POINTS[AutoIndex]
        local reached = MoveToPoint(target)
        
        if reached and tick() - LastAutoTime > 0.1 then
            AutoIndex = AutoIndex + 1
            if AutoIndex > #LEFT_POINTS then AutoIndex = 1 end
            LastAutoTime = tick()
        end
    end
    
    -- Auto Right
    if ScriptSettings.AutoRight then
        local target = RIGHT_POINTS[AutoIndex]
        local reached = MoveToPoint(target)
        
        if reached and tick() - LastAutoTime > 0.1 then
            AutoIndex = AutoIndex + 1
            if AutoIndex > #RIGHT_POINTS then AutoIndex = 1 end
            LastAutoTime = tick()
        end
    end
    
    -- Stop velocity if not active
    if not ScriptSettings.AutoLeft and not ScriptSettings.AutoRight and CurrentVel then
        CurrentVel.Velocity = Vector3.zero
    end
end)

