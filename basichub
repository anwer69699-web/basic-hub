    local desyncStatus = DesyncEnabled and "✅" or "❌"
    local stealStatus = StealEnabled and "✅" or "❌"
    StatusLabel.Text = string.format("Desync: %s | Steal: %s", desyncStatus, stealStatus)
    
    if DesyncEnabled and StealEnabled then
        StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 100) -- أخضر (كل شي شغال)
    elseif DesyncEnabled or StealEnabled then
        StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 0) -- أصفر (واحد شغال)
    else
        StatusLabel.TextColor3 = Color3.fromRGB(150, 150, 150) -- رمادي (متوقف)
    end
end

