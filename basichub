local function FindNearestPrompt()
    local h = gH() if not h then return nil end
    local pl = workspace:FindFirstChild("Plots") if not pl then return nil end
    local np, npd = nil, math.huge
    for _, pl2 in ipairs(pl:GetChildren()) do
        if IsMyPlot(pl2.Name) then continue end
        local pod = pl2:FindFirstChild("AnimalPodiums") if not pod then continue end
        for _, p in ipairs(pod:GetChildren()) do
            pcall(function()
                local b = p:FindFirstChild("Base") local sp = b and b:FindFirstChild("Spawn") if not sp then return end
                local a = p:FindFirstChild("Animal") or p:FindFirstChildWhichIsA("Model") if not a then return end
                local d = (sp.Position - h.Position).Magnitude
                if d < npd and d <= STEAL_RANGE then
                    local at = sp:FindFirstChild("PromptAttachment") if at then
                        for _, c in ipairs(at:GetChildren()) do if c:IsA("ProximityPrompt") and c.Enabled then np = c npd = d break end end
                    end
                end
            end)
        end
    end
    return np
end

