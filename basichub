    h.InputChanged:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then di = i end end)
    UIS.InputChanged:Connect(function(i) if i == di and dr then local d = i.Position - ds f.Position = UDim2.new(dp.X.Scale, dp.X.Offset + d.X, dp.Y.Scale, dp.Y.Offset + d.Y) end end)
end

local function MakeFloatBtn(parent, text, xPos, yPos, elemKey)
    local sz = 72

    local f = Instance.new("Frame")
    f.Name = text
    f.BackgroundColor3 = C.BG
    f.BackgroundTransparency = 0.4
    f.Size = UDim2.new(0, sz * SC, 0, sz * SC)
    f.Position = UDim2.new(1, -(xPos + sz) * SC, 0.5, yPos * SC)
    f.Parent = parent

    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 10)

    AddGlow(f, C.GRN, 6)

    local st = Instance.new("UIStroke")
    st.Thickness = 2
    st.Color = C.GRN
    st.Parent = f

    BorderGrad(st)
    AddParticles(f, 5)

    if elemKey then
        UIElements[elemKey] = f
    end

    local btn = Instance.new("TextButton")
    btn.Name = "Btn"
    btn.Text = text
    btn.TextColor3 = C.TXT
    btn.Font = Enum.Font.GothamBlack
    btn.TextSize = 11 * SC
    btn.BackgroundTransparency = 1
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.ZIndex = 5
    btn.TextWrapped = true
    btn.Parent = f

    TextGrad(btn)

    local dr, di, ds, dp, wd = false, nil, nil, nil, false

    btn.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
            or i.UserInputType == Enum.UserInputType.Touch then

            dr = true
            ds = i.Position
            dp = f.Position
            wd = false

            i.Changed:Connect(function()
                if i.UserInputState == Enum.UserInputState.End then
                    dr = false
                end
            end)
        end
    end)

    btn.InputChanged:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseMovement
            or i.UserInputType == Enum.UserInputType.Touch then

            di = i

            if dr and ds then
                if (i.Position - ds).Magnitude > 5 then
                    wd = true
                end
            end
        end
    end)

    UIS.InputChanged:Connect(function(i)
        if i == di and dr then
            local d = i.Position - ds

            f.Position = UDim2.new(
                dp.X.Scale,
                dp.X.Offset + d.X,
                dp.Y.Scale,
                dp.Y.Offset + d.Y
            )
        end
    end)

    Hover(btn, C.HVR, C.BG)

    local os_ = btn.Size

    btn.MouseButton1Click:Connect(function()
        if wd then
            wd = false
            return
        end

        TweenService:Create(
            btn,
            TweenInfo.new(0.06),
            {
                Size = UDim2.new(
                    os_.X.Scale,
                    os_.X.Offset * 0.93,
                    os_.Y.Scale,
                    os_.Y.Offset * 0.93
                )
            }
        ):Play()

        task.delay(0.06, function()
            if btn and btn.Parent then
                TweenService:Create(
                    btn,
                    TweenInfo.new(0.15, Enum.EasingStyle.Back),
                    { Size = os_ }
                ):Play()
            end
        end)
    end)

    task.spawn(function()
        while btn and btn.Parent and CoreActive do
            local isOn = btn:GetAttribute("On")

            if isOn then
                TweenService:Create(
                    st,
                    TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
                    {
                        Thickness = 3.5,
                        Color = C.GRN_BRIGHT
                    }
                ):Play()

                task.wait(0.6)

                TweenService:Create(
                    st,
                    TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
                    {
                        Thickness = 2,
                        Color = C.GRN
                    }
                ):Play()

                task.wait(0.6)
            else
                TweenService:Create(
                    st,
                    TweenInfo.new(0.3),
                    {
                        Thickness = 1.5,
                        Color = C.RED
                    }
                ):Play()

                task.wait(0.4)
            end
        end
    end)

    return btn, f, st
end

