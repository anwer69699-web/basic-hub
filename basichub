local function updateSlider(value)
    currentIntensity = math.clamp(math.round(value), 0, 100)
    local pct = currentIntensity / 100
    SliderFill.Size = UDim2.new(pct, 0, 1, 0)
    SliderKnob.Position = UDim2.new(pct, -7, 0.5, -7)
    SliderValLabel.Text = currentIntensity .. "%"
end

