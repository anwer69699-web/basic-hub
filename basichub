-- Main Loop for Auto Left/Right
RunService.Heartbeat:Connect(function()
    local hrp = GetHRP()
    if not hrp then return end
    
    -- Auto Left
    if ScriptSettings.AutoLeft and tick() - LastAutoTime > 0.15 then
        AutoIndex = AutoIndex + 1
        if AutoIndex > #LEFT_POINTS then AutoIndex = 1 end
        
        local target = LEFT_POINTS[AutoIndex]
        hrp.CFrame = CFrame.new(target)
        LastAutoTime = tick()
    end
    
    -- Auto Right
    if ScriptSettings.AutoRight and tick() - LastAutoTime > 0.15 then
        AutoIndex = AutoIndex + 1
        if AutoIndex > #RIGHT_POINTS then AutoIndex = 1 end
        
        local target = RIGHT_POINTS[AutoIndex]
        hrp.CFrame = CFrame.new(target)
        LastAutoTime = tick()
    end
end)

