-- ==================== MAIN LOOP (Humanoid:Move System) ====================

RunService.Heartbeat:Connect(function()
    local hrp = GetHRP()
    local hum = GetHumanoid()
    if not hrp or not hum then return end
    
    -- Desync Kill (نظام FR HUB الأصلي)
    if Settings.Desync then
        hrp.CFrame = hrp.CFrame + Vector3.new(
            math.random(-20, 20),
            math.random(-5, 5),
            math.random(-20, 20)
        )
    end
    
    -- Auto Left/Right System (مثل VelocityUltraV8)
    if not CurrentPath then return end
    
    local points = CurrentPath == "LEFT" and LEFT_POINTS or RIGHT_POINTS
    
    -- إذا كان ينتظر في الموقع 2
    if WaitingForSteal then
        hum:Move(Vector3.zero, false)
        
        -- يحاول يسرق
        local stolen = TrySteal()
        
        if stolen or CheckHasBall() then
            WaitingForSteal = false
            AutoPhase = "POINT_3"
            Status.Text = CurrentPath .. ": Got ball! Continue..."
        else
            Status.Text = CurrentPath .. ": Stealing at Point 2..."
        end
        
        return
    end
    
    -- تحديد الهدف الحالي
    local currentPoint = points[AutoPhase]
    if not currentPoint then
        AutoPhase = "START"
        currentPoint = points.START
    end
    
    -- حساب المسافة
    local targetPos = Vector3.new(currentPoint.X, hrp.Position.Y, currentPoint.Z)
    local distance = (targetPos - hrp.Position).Magnitude
    
    -- التحقق من الوصول
    if distance < Settings.StopDistance then
        -- وصل للهدف
        if AutoPhase == "START" then
            AutoPhase = "POINT_2"
            Status.Text = CurrentPath .. ": To Point 2 (Steal)"
            
        elseif AutoPhase == "POINT_2" then
            -- وصل الموقع 2 - يتوقف ويحاول يسرق
            WaitingForSteal = true
            hum:Move(Vector3.zero, false)
            Status.Text = CurrentPath .. ": At Point 2 - Stealing..."
            return
            
        elseif AutoPhase == "POINT_3" then
            AutoPhase = "END"
            Status.Text = CurrentPath .. ": To End"
            
        elseif AutoPhase == "END" then
            -- إعادة الدورة
            AutoPhase = "START"
            Status.Text = CurrentPath .. ": Loop - To Point 1"
            return
        end
    end
    
    -- التحرك للهدف (نظام Humanoid:Move)
    local direction = (targetPos - hrp.Position).Unit
    direction = Vector3.new(direction.X, 0, direction.Z).Unit
    
    local speed = GetSpeed()
    
    -- تحريك اللاعب (مثل VelocityUltraV8)
    hum:Move(direction, false)
    
    -- تطبيق السرعة على Velocity
    hrp.AssemblyLinearVelocity = Vector3.new(
        direction.X * speed,
        hrp.AssemblyLinearVelocity.Y,
        direction.Z * speed
    )
    
    -- تحديث الحالة
    if AutoPhase ~= "POINT_2" or not WaitingForSteal then
        local phaseName = AutoPhase == "START" and "1" or 
                         AutoPhase == "POINT_2" and "2 (Steal)" or
                         AutoPhase == "POINT_3" and "3" or "4"
        Status.Text = CurrentPath .. ": To Point " .. phaseName .. " - " .. speed
    end
end)

