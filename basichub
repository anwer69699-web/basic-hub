    Settings.AutoLeft = not Settings.AutoLeft
    setLeftActive(Settings.AutoLeft)
    
    if Settings.AutoLeft then
        Settings.AutoRight = false
        setRightActive(false)
        AutoPhase = "START"
        CurrentPath = "LEFT"
        WaitingForSteal = false
        CreateVelocity()
        StartAutoSystem()
    else
        RemoveVelocity()
        if not Settings.AutoRight then StopAutoSystem() end
    end
    UpdateStatus()
end)

btnRight.MouseButton1Click:Connect(function()
    Settings.AutoRight = not Settings.AutoRight
    setRightActive(Settings.AutoRight)
    
    if Settings.AutoRight then
        Settings.AutoLeft = false
        setLeftActive(false)
        AutoPhase = "START"
        CurrentPath = "RIGHT"
        WaitingForSteal = false
        CreateVelocity()
        StartAutoSystem()
    else
        RemoveVelocity()
        if not Settings.AutoLeft then StopAutoSystem() end
    end
    UpdateStatus()
end)

btnDesync.MouseButton1Click:Connect(function()
    Settings.Desync = not Settings.Desync
    setDesyncActive(Settings.Desync)
    
    if Settings.Desync then
        local hrp = GetHRP()
        if hrp then TargetServerPos = hrp.Position end
        
        DesyncConnection = RunService.RenderStepped:Connect(function()
            if TargetServerPos then
                SendFakePosition(TargetServerPos)
            end
            local hrp = GetHRP()
            if hrp then
                hrp.CFrame = hrp.CFrame + Vector3.new(
                    math.random(-20, 20),
                    math.random(-5, 5),
                    math.random(-20, 20)
                )
            end
        end)
    else
        if DesyncConnection then
            DesyncConnection:Disconnect()
            DesyncConnection = nil
        end
        TargetServerPos = nil
    end
    UpdateStatus()
end)

btnSteal.MouseButton1Click:Connect(function()
    Settings.InstaSteal = not Settings.InstaSteal
    setStealActive(Settings.InstaSteal)
    isInstaStealActive = Settings.InstaSteal
    UpdateStatus()
end)

-- Settings Button Toggle
SettingsBtn.MouseButton1Click:Connect(function()
    Settings.SettingsVisible = not Settings.SettingsVisible
    SettingsPanel.Visible = Settings.SettingsVisible
    
    -- Rotate icon
    TweenService:Create(SettingsBtn, TweenInfo.new(0.3), {
        Rotation = Settings.SettingsVisible and 45 or 0
    }):Play()
    
    -- Animate panel
    if Settings.SettingsVisible then
        SettingsPanel.Size = UDim2.new(1, 0, 0, 0)
        TweenService:Create(SettingsPanel, TweenInfo.new(0.3, Enum.EasingStyle.Back), {
            Size = UDim2.new(1, 0, 0, 90)
        }):Play()
    end
    
    UpdateStatus()
end)

-- Minimize
local isMinimized = false
MinBtn.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    Content.Visible = not isMinimized
    Main.Size = isMinimized and UDim2.new(0, 240, 0, 40) or UDim2.new(0, 240, 0, 280)
    MinBtn.Text = isMinimized and "+" or "−"
end)

-- Dragging
local dragging, dragStart, startPos
TitleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = Main.Position
    end
end)

TitleBar.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

TitleBar.InputEnded:Connect(function() dragging = false end)

-- Start Systems
StartInstaStealSystem()

