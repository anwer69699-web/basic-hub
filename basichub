            if char and Players:GetPlayerFromCharacter(char) == LP then ST.RealSpeed = value return OriginalNewIndex(self, key, ST.SpeedPool[ST.CurrentIndex] or 16) end
        end
        return OriginalNewIndex(self, key, value)
    end)
    setreadonly(mt, true)
    _G.ExtOriginalIndex = OriginalIndex
    _G.ExtOriginalNewIndex = OriginalNewIndex
end
