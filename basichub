local function InstallHooks()
    local mt = getrawmetatable(game) setreadonly(mt, false)
    ST.OriginalIndex = hookfunction(mt.__index, function(self, key)
        if ST.SpoofActive and typeof(self) == "Instance" and self:IsA("Humanoid") and key == "WalkSpeed" then return ST.SpeedPool[ST.CurrentIndex] or 16 end
        return ST.OriginalIndex(self, key)
    end)
    ST.OriginalNewIndex = hookfunction(mt.__newindex, function(self, key, value)
        if ST.SpoofActive and typeof(self) == "Instance" and self:IsA("Humanoid") and key == "WalkSpeed" then ST.RealSpeed = value; return ST.OriginalNewIndex(self, key, ST.SpeedPool[ST.CurrentIndex] or 16) end
        return ST.OriginalNewIndex(self, key, value)
    end)
    setreadonly(mt, true)
end
pcall(InstallHooks)

local function IRS_ActivateReset()
    if ST.IRS_isExecuting then return end
    local char = LP.Character if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid") if not hum or hum.Health <= 0 then return end
    ST.IRS_isExecuting = true PS(SFX.Tgl) ST.CurrentIndex = ST.CurrentIndex + 1
    if ST.CurrentIndex > #ST.SpeedPool then ST.CurrentIndex = 1 end
    ST.RealSpeed = hum.WalkSpeed ST.SpoofActive = true
    task.delay(0.9, function() ST.SpoofActive = false; if hum and hum.Parent then hum.WalkSpeed = ST.RealSpeed end; task.delay(0.2, function() ST.IRS_isExecuting = false end) end)
end

