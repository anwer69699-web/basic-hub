-- Get HRP
local function GetHRP()
    local char = LocalPlayer.Character
    if char then return char:FindFirstChild("HumanoidRootPart") end
    return nil
end

-- Has Ball
local function HasBall()
    local char = LocalPlayer.Character
    if not char then return false end
    return char:FindFirstChild("Basketball") ~= nil
end

-- Get Speed
local function GetSpeed()
    return HasBall() and Settings.SpeedSteal or Settings.SpeedNormal
end

-- Create BodyVelocity
local function CreateVelocity()
    local hrp = GetHRP()
    if not hrp then return nil end
    
    if CurrentVel then CurrentVel:Destroy() end
    
    for _, v in pairs(hrp:GetChildren()) do
        if v:IsA("BodyVelocity") then v:Destroy() end
    end
    
    local vel = Instance.new("BodyVelocity")
    vel.MaxForce = Vector3.new(400000, 400000, 400000)
    vel.Velocity = Vector3.zero
    vel.P = 10000
    vel.Parent = hrp
    
    CurrentVel = vel
    return vel
end

local function RemoveVelocity()
    if CurrentVel then
        CurrentVel:Destroy()
        CurrentVel = nil
    end
end

-- Move with BodyVelocity
local function MoveToPoint(target)
    if not CurrentVel then return false end
    
    local hrp = GetHRP()
    if not hrp then return false end
    
    local distance = (target - hrp.Position).Magnitude
    if distance < 2 then
        CurrentVel.Velocity = Vector3.zero
        return true
    end
    
    local direction = (target - hrp.Position).Unit
    CurrentVel.Velocity = direction * GetSpeed()
    return false
end

-- Desync Functions
local function SendFakePosition(pos)
    if typeof(rnet) == "table" then
        pcall(function()
            if rnet.sendposition then rnet.sendposition(pos) end
            if rnet.sendphysics then rnet.sendphysics(CFrame.new(pos)) end
        end)
    end
    if typeof(delta) == "table" then
        pcall(function()
            if delta.sendposition then delta.sendposition(pos) end
            if delta.sendphysics then delta.sendphysics(CFrame.new(pos)) end
        end)
    end
end

