statusLbl.Size = UDim2.new(1, 0, 0, 50 * guiScale)
statusLbl.Position = UDim2.new(0, 0, 0, y * guiScale)
statusLbl.BackgroundTransparency = 1
statusLbl.Text = "Keys: P=Execute | L=Mode\nSettings: 140 Tables | 0.12s Delay"
statusLbl.TextColor3 = C.textDim
statusLbl.Font = Enum.Font.GothamMedium
statusLbl.TextSize = 11 * guiScale
statusLbl.TextYAlignment = Enum.TextYAlignment.Top

-- Keybinds
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.P then
        executeExternalScript()
        execBtn.BackgroundColor3 = C.success
        execBtn.Text = "✓ EXECUTED!"
        task.delay(2, function()
            execBtn.BackgroundColor3 = C.info
            execBtn.Text = "▶ EXECUTE SCRIPT [P]"
        end)
    elseif input.KeyCode == Enum.KeyCode.L then
        toggleMode()
    end
end)

-- Respawn Handler
Player.CharacterAdded:Connect(function()
    task.wait(1)
    if Enabled.SpeedBoost then stopSpeedBoost() task.wait(0.1) startSpeedBoost() end
    if Enabled.AntiRagdoll then stopAntiRagdoll() task.wait(0.1) startAntiRagdoll() end
    if Enabled.InstantSteal then stopInstantGrab() task.wait(0.1) startInstantGrab() end
    if Enabled.Optimizer then 
        stopOptimizer()
        task.wait(0.1)
        startOptimizer()
    end
end)

