local function sP()
    ST.LKA = false
    ST.LockOn = false
    local h = gH()
    if h then
        pcall(function()
            h.Velocity = Vector3.new(0, h.Velocity.Y, 0)
            local a = h:FindFirstChild("LockAngVel") if a then a:Destroy() end
            local t = h:FindFirstChild("LockBodyAtt") if t then t:Destroy() end
        end)
    end
end

local function tLK()
    ST.LKA = not ST.LKA
    ST.LockOn = ST.LKA
    if ST.LKA then
        PS(SFX.Tgl)
        ST.lockCD = 0
        local h = gH()
        if not h then ST.LKA = false ST.LockOn = false return end
        pcall(function()
            local at = h:FindFirstChild("LockBodyAtt") or Instance.new("Attachment", h)
            at.Name = "LockBodyAtt"
            local a = h:FindFirstChild("LockAngVel") or Instance.new("AngularVelocity")
            a.Name = "LockAngVel"
            a.Attachment0 = at
            a.AngularVelocity = Vector3.new(0,0,0)
            a.MaxTorque = 80000
            a.ReactionTorqueEnabled = false
            a.Parent = h
        end)
        ST.LKC = Trk(S.RS.Heartbeat:Connect(function(dt)
            if not ST.LKA or not _G.ExtRunning then return end
            local h = gH()
            if not h or not h.Parent then ST.LKA = false ST.LockOn = false return end
            local t = FindNearest()
            if t and t.Character then
                local e = t.Character:FindFirstChild("HumanoidRootPart")
                if e then
                    local d = (e.Position - h.Position)
                    local yDiff = e.Position.Y - h.Position.Y
                    local lockSpeed = gNS()
                    local targetFrontDir = Vector3.new(0,0,-1)
                    local hrpLook = Vector3.new(e.CFrame.LookVector.X, 0, e.CFrame.LookVector.Z)
                    if hrpLook.Magnitude > 0.01 then
                        targetFrontDir = hrpLook.Unit
                    elseif d.Magnitude > 0.01 then
                        targetFrontDir = Vector3.new(d.X, 0, d.Z).Unit
                    end
                    local positionInFront = e.Position + (targetFrontDir * ST.LOCK_DIST)
                    local toFront = positionInFront - h.Position
                    local distToFront = Vector3.new(toFront.X, 0, toFront.Z).Magnitude
                    local hVel = Vector3.new(0,0,0)
                    if distToFront > 2 then
                        if toFront.Magnitude > 0.5 then
                            local flatTo = Vector3.new(toFront.X, 0, toFront.Z)
                            if flatTo.Magnitude > 0.5 then hVel = flatTo.Unit * lockSpeed end
                        end
                    elseif distToFront > 0.5 then
                        hVel = Vector3.new(toFront.X, 0, toFront.Z) * 5
                    else
                        hVel = Vector3.new(0,0,0)
                    end
                    local yVel = 0
                    if math.abs(yDiff) > 3 then
                        yVel = yDiff > 0 and ST.maxVS or -ST.maxVS
                    elseif math.abs(yDiff) > 0.5 then
                        yVel = math.clamp(yDiff * 15, -ST.maxVS, ST.maxVS)
                    else
                        yVel = 0
                    end
                    h.Velocity = Vector3.new(hVel.X, yVel, hVel.Z)
                    pcall(function()
                        local a = h:FindFirstChild("LockAngVel")
                        if a and d.Magnitude > 0.5 then
                            local desiredCF = CFrame.lookAt(h.Position, e.Position)
                            local relCF = h.CFrame:ToObjectSpace(desiredCF)
                            local axis, angle = relCF:ToAxisAngle()
                            if angle > 0.01 then
                                local worldAxis = h.CFrame:VectorToWorldSpace(axis)
                                a.AngularVelocity = worldAxis * math.min(angle * 20, 12) * Vector3.new(1, 1, 0.1)
                            else
                                a.AngularVelocity = Vector3.new(0,0,0)
                            end
                        end
                    end)
                    ST.lockCD = ST.lockCD - dt
                    if ST.lockCD <= 0 then
                        local tl = FindBat()
                        if tl then pcall(function() tl:Activate() end) end
                        ST.lockCD = 0.08
                    end
                end
            else
                h.Velocity = h.Velocity * 0.9
                pcall(function()
                    local a = h:FindFirstChild("LockAngVel")
                    if a then a.AngularVelocity = a.AngularVelocity * 0.9 end
                end)
            end
        end))
        _G.ExtLockC = ST.LKC
    else
        PS(SFX.Tgl)
        if ST.LKC then ST.LKC:Disconnect() ST.LKC = nil end
        sP()
    end
end
