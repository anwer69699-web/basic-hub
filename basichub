local function StopSpeed() if ST.SpdC then ST.SpdC:Disconnect() ST.SpdC = nil end end
local function StartSpeed()
    if ST.SpdC then return end
    -- استخدام Heartbeat لضمان الحركة كل فريم بشكل مستقر
    ST.SpdC = Trk(S.RS.Heartbeat:Connect(function()
        if not ST.SpeedBoostOn or not _G.ExtRunning or ST.LockOn then return end
        local c = LP.Character if not c then return end
        local hm = c:FindFirstChildOfClass("Humanoid") local hr = c:FindFirstChild("HumanoidRootPart")
        if not hm or not hr or not hr.Parent then return end
        
        local md = hm.MoveDirection 
        local tSpd = iS() and gSS() or gNS()
        
        -- تطبيق السرعة كل فريم بدقة
        if md.Magnitude > 0.01 then 
            hr.Velocity = Vector3.new(md.X * tSpd, hr.Velocity.Y, md.Z * tSpd)
        else
            -- إيقاف الحركة الأفقية فوراً عند التوقف لمنع الانزلاق
            hr.Velocity = Vector3.new(0, hr.Velocity.Y, 0)
        end
    end))
    _G.ExtSpdC = ST.SpdC
end

