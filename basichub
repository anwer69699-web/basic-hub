--// ==================== [7] Auto Walk System - FIXED ====================

local autoPhase = "START"
local currentPath = nil
local waitingForSteal = false
local MovementConnection = nil

-- CORRECTED PATHS - Must reach Point 4 (END)
local LEFT_POINTS = {
    START = Vector3.new(-473.43, -7.30, 95.59),
    POINT_2 = Vector3.new(-485.73, -5.15, 95.42),
    POINT_3 = Vector3.new(-473.43, -7.30, 95.59),
    END = Vector3.new(-473.96, -7.30, 19.63),  -- Point 4 - MUST REACH THIS
}

local RIGHT_POINTS = {
    START = Vector3.new(-474.13, -7.30, 24.17),
    POINT_2 = Vector3.new(-485.17, -5.15, 25.08),
    POINT_3 = Vector3.new(-474.13, -7.30, 24.17),
    END = Vector3.new(-474.55, -7.30, 23.52),  -- Point 4 - MUST REACH THIS
}

local function stopMovement()
    if MovementConnection then
        MovementConnection:Disconnect()
        MovementConnection = nil
    end
    autoPhase = "START"
    waitingForSteal = false
    currentPath = nil
    pcall(function()
        local c = LocalPlayer.Character
        if c then
            local hum = c:FindFirstChildOfClass("Humanoid")
            if hum then hum:Move(Vector3.zero, false) end
        end
    end)
end

local function startMovement()
    if MovementConnection then MovementConnection:Disconnect() end
    
    MovementConnection = RunService.Heartbeat:Connect(function()
        if not Settings.AutoLeft and not Settings.AutoRight then return end
        
        pcall(function()
            local c = LocalPlayer.Character
            if not c then return end
            local h = c:FindFirstChild("HumanoidRootPart")
            local hum = c:FindFirstChildOfClass("Humanoid")
            if not h or not hum then return end
            
            local points = Settings.AutoLeft and LEFT_POINTS or RIGHT_POINTS
            currentPath = Settings.AutoLeft and "LEFT" or "RIGHT"
            
            -- Handle waiting for steal at Point 2
            if waitingForSteal then
                if LocalPlayer:GetAttribute("Stealing") then
                    waitingForSteal = false
                    autoPhase = "POINT_3"
                else
                    hum:Move(Vector3.zero, false)
                    h.AssemblyLinearVelocity = Vector3.new(0, h.AssemblyLinearVelocity.Y, 0)
                    return
                end
            end
            
            local currentPoint = points[autoPhase]
            if not currentPoint then
                autoPhase = "START"
                currentPoint = points.START
            end
            
            local targetPos = Vector3.new(currentPoint.X, h.Position.Y, currentPoint.Z)
            local dist = (targetPos - h.Position).Magnitude
            
            -- FIXED: Proper phase progression to reach END (Point 4)
            if dist < 2 then
                if autoPhase == "START" then
                    autoPhase = "POINT_2"
                    print("Reached START -> Going to POINT_2")
                elseif autoPhase == "POINT_2" then
                    waitingForSteal = true
                    hum:Move(Vector3.zero, false)
                    print("Reached POINT_2 -> Waiting for steal")
                    return
                elseif autoPhase == "POINT_3" then
                    autoPhase = "END"
                    print("Reached POINT_3 -> Going to END (Point 4)")
                elseif autoPhase == "END" then
                    -- CRITICAL FIX: Loop back to START after reaching END
                    autoPhase = "START"
                    print("Reached END (Point 4) -> Looping to START")
                    task.wait(0.5) -- Small delay at end point
                    return
                end
            end
            
            local isStealing = LocalPlayer:GetAttribute("Stealing")
            local speed = isStealing and Settings.StealSpeed or Settings.NormalSpeed
            
            local dir = (targetPos - h.Position).Unit
            dir = Vector3.new(dir.X, 0, dir.Z).Unit
            
            local velocity = dir * speed
            h.AssemblyLinearVelocity = Vector3.new(velocity.X, h.AssemblyLinearVelocity.Y, velocity.Z)
            hum:Move(dir, false)
        end)
    end)
end

--// ==================== [8] Galaxy Mode - FIXED ====================

local galaxyVectorForce = nil
local galaxyAttachment = nil
local spaceHeld = false
local lastHopTime = 0
local originalJumpPower = 50

local function setupGalaxy()
    pcall(function()
        local c = LocalPlayer.Character
        if not c then return end
        local h = c:FindFirstChild("HumanoidRootPart")
        if not h then return end
        
        if galaxyVectorForce then galaxyVectorForce:Destroy() end
        if galaxyAttachment then galaxyAttachment:Destroy() end
        
        galaxyAttachment = Instance.new("Attachment")
        galaxyAttachment.Parent = h
        
        galaxyVectorForce = Instance.new("VectorForce")
        galaxyVectorForce.Attachment0 = galaxyAttachment
        galaxyVectorForce.ApplyAtCenterOfMass = true
        galaxyVectorForce.RelativeTo = Enum.ActuatorRelativeTo.World
        galaxyVectorForce.Force = Vector3.new(0, 0, 0)
        galaxyVectorForce.Parent = h
    end)
end

local function updateGalaxy()
    if not Settings.Galaxy or not galaxyVectorForce then return end
    local c = LocalPlayer.Character
    if not c then return end
    
    local mass = 0
    for _, p in ipairs(c:GetDescendants()) do
        if p:IsA("BasePart") then mass = mass + p:GetMass() end
    end
    
    local targetGravity = workspace.Gravity * (Settings.GalaxyGravityPercent / 100)
    galaxyVectorForce.Force = Vector3.new(0, mass * (workspace.Gravity - targetGravity) * 0.98, 0)
end

local function doMiniHop()
    if not Settings.Galaxy then return end
    pcall(function()
        local c = LocalPlayer.Character
        if not c then return end
        local h = c:FindFirstChild("HumanoidRootPart")
        local hum = c:FindFirstChildOfClass("Humanoid")
        if not h or not hum then return end
        
        if tick() - lastHopTime < Settings.GalaxyHopCooldown then return end
        lastHopTime = tick()
        
        -- FIXED: Only hop when space is held AND in air
        if spaceHeld and hum.FloorMaterial == Enum.Material.Air then
            h.AssemblyLinearVelocity = Vector3.new(
                h.AssemblyLinearVelocity.X,
                Settings.GalaxyHopPower,
                h.AssemblyLinearVelocity.Z
            )
        end
    end)
end

