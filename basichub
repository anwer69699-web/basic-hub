-- == تحديثات الواجهة والسبييد جي يو آي ==
local SpdGuis = {}
local function CreateSpdGui(char) local hr = char:WaitForChild("HumanoidRootPart", 5) if not hr then return end if SpdGuis[char] then pcall(function() SpdGuis[char]:Destroy() end) end local bb = Instance.new("BillboardGui") bb.Name = "ExtSpdUI" bb.Adornee = hr bb.Size = UDim2.new(0, 100, 0, 30) bb.StudsOffset = Vector3.new(0, 4, 0) bb.AlwaysOnTop = true bb.MaxDistance = 1000 bb.Parent = char local t = Instance.new("TextLabel") t.Text = "0.0" t.TextColor3 = C.GRN t.Font = Enum.Font.GothamBlack t.TextSize = 16 t.BackgroundTransparency = 1 t.Size = UDim2.new(1, 0, 1, 0) t.ZIndex = 2 t.Parent = bb TextGrad(t) SpdGuis[char] = bb end
task.spawn(function() while _G.ExtRunning and CoreActive do for _, p in ipairs(Players:GetPlayers()) do if p.Character then local hr = p.Character:FindFirstChild("HumanoidRootPart") if hr then if not SpdGuis[p.Character] or not SpdGuis[p.Character].Parent then CreateSpdGui(p.Character) else local bb = SpdGuis[p.Character] bb.Adornee = hr local txt = bb:FindFirstChildOfClass("TextLabel") if txt then local v = hr.Velocity txt.Text = string.format("%.1f", Vector3.new(v.X, 0, v.Z).Magnitude) end end end end end task.wait(0.1) end end)

