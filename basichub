local function DisableAntiRag()
    ST.AntiRagOn = false
    ST.AntiRagRC = false
    for _, con in pairs(ST.AntiRagC) do pcall(function() con:Disconnect() end) end
    ST.AntiRagC = {}
end

local function CleanConstraints(char)
    for _, o in pairs(char:GetDescendants()) do
        if o:IsA("BallSocketConstraint") or o:IsA("NoCollisionConstraint") or o:IsA("HingeConstraint") then o:Destroy()
        elseif o:IsA("Attachment") and (o.Name == "A" or o.Name == "B") then o:Destroy()
        elseif o:IsA("BodyVelocity") or o:IsA("BodyPosition") or o:IsA("BodyGyro") or o:IsA("AlignOrientation") then o:Destroy()
        elseif o:IsA("Motor6D") then o.Enabled = true end
    end
end

local function ReEnableControls()
    pcall(function() require(LP:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule")):GetControls():Enable() end)
end

local function EnableAntiRag()
    if ST.AntiRagOn then DisableAntiRag() return end
    ST.AntiRagOn = true
    ST.AntiRagRC = false
    ST.AntiRagLastV = Vector3.zero
    local c = LP.Character or LP.CharacterAdded:Wait()
    local h = c:WaitForChild("Humanoid")
    local r = c:WaitForChild("HumanoidRootPart")
    pcall(function()
        h:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        h:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        h:SetStateEnabled(Enum.HumanoidStateType.GettingUp, false)
    end)
    local BS = {
        [Enum.HumanoidStateType.Physics] = true,
        [Enum.HumanoidStateType.Ragdoll] = true,
        [Enum.HumanoidStateType.FallingDown] = true,
        [Enum.HumanoidStateType.GettingUp] = true
    }
    local function IsRagState() return BS[h:GetState()] == true end
    local function StartRecovery()
        if ST.AntiRagRC then return end
        ST.AntiRagRC = true
        task.spawn(function()
            local eT = tick() + 0.5
            while tick() < eT do
                if IsRagState() or h:GetState() == Enum.HumanoidStateType.GettingUp then
                    CleanConstraints(c)
                    pcall(function() h:ChangeState(Enum.HumanoidStateType.Running) end)
                    local v = r.Velocity
                    if v.Magnitude > 30 then r.Velocity = Vector3.new(0, math.min(v.Y, 5), 0) end
                    workspace.CurrentCamera.CameraSubject = h
                    ReEnableControls()
                end
                pcall(function()
                    h:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
                    h:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
                end)
                task.wait(0.02)
            end
            ST.AntiRagRC = false
        end)
    end
    table.insert(ST.AntiRagC, h.StateChanged:Connect(function(_, nS) if BS[nS] then StartRecovery() end end))
    table.insert(ST.AntiRagC, S.RS.Heartbeat:Connect(function()
        if IsRagState() then
            StartRecovery()
            local v = r.Velocity
            local vD = (v - ST.AntiRagLastV).Magnitude
            if vD > 50 and v.Magnitude > 20 then r.Velocity = Vector3.new(0, math.min(v.Y, 5), 0) end
        end
        ST.AntiRagLastV = r.Velocity
    end))
    table.insert(ST.AntiRagC, c.DescendantAdded:Connect(function(o)
        if o:IsA("BallSocketConstraint") or o:IsA("NoCollisionConstraint") or o:IsA("HingeConstraint") or o:IsA("BodyVelocity") or o:IsA("BodyPosition") or o:IsA("BodyGyro") or o:IsA("AlignOrientation") then
            task.defer(function() if o and o.Parent then o:Destroy() end end)
        elseif o:IsA("Motor6D") then
            task.defer(function() if o and o.Parent then o.Enabled = true end end)
        end
    end))
    table.insert(ST.AntiRagC, LP.CharacterAdded:Connect(function() DisableAntiRag() EnableAntiRag() end))
    ReEnableControls()
    CleanConstraints(c)
end
