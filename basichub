local function ExitScript()
    PS(SFX.Exit) CoreActive = false _G.ExtRunning = false _G.ExtLagRunning = false LAG_ST.CoreActive = false
    ST.LKA = false ST.LockOn = false ST.SpeedBoostOn = false ST.InfJumpOn = false ST.AutoStealOn = false ST.AutoTPDOn = false ST.AntiRagOn = false
    LAG_ST.LaggerOn = false stopLagger()
    sP() StopSpeed() StopDrop() StopBatCnt() DisableAntiRag() ToggleAutoTPD(false)
    ST.SpoofActive = false ST.IRS_isExecuting = false
    DisAll() if ST.IJC then ST.IJC:Disconnect() end if ST.JHC then ST.JHC:Disconnect() end
    for _, c in pairs(ST.MedConns) do pcall(function() c:Disconnect() end) end ST.MedConns = {}
    local h = gH() if h then h.Velocity = Vector3.new(0, 0, 0) end
    if ESPFolder then pcall(function() ESPFolder:Destroy() end) end
    pcall(function() for _, g in ipairs(S.CG:GetChildren()) do if g:GetAttribute("ExtAuth") then g:Destroy() end end end)
    pcall(function() SFXF:Destroy() end)
end

