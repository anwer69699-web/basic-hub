    Vector3.new(-485.73, -5.15, 95.42),
    Vector3.new(-473.43, -7.30, 95.59),
    Vector3.new(-473.96, -7.30, 19.63)
}

local RIGHT_POINTS = {
    Vector3.new(-474.13, -7.30, 24.17),
    Vector3.new(-485.17, -5.15, 25.08),
    Vector3.new(-474.13, -7.30, 24.17),
    Vector3.new(-474.55, -7.30, 23.52)
}

local CurrentVel = nil
local AutoIdx = 1
local LastTime = 0
