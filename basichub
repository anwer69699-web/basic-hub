    -- Billboard label
    DesyncLabel = Instance.new("BillboardGui")
    DesyncLabel.Name = "FRHUB_DesyncLabel"
    DesyncLabel.Size = UDim2.new(0, 150, 0, 40)
    DesyncLabel.AlwaysOnTop = true
