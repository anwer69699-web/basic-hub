    SettingsBorder.Color = C.border
    SettingsBorder.Transparency = 0.3
    SettingsBorder.Parent = SettingsPanel

    -- Settings Title
    local SettingsTitle = Instance.new("TextLabel")
    SettingsTitle.Size = UDim2.new(1, 0, 0, 35)
    SettingsTitle.BackgroundTransparency = 1
    SettingsTitle.Text = "⚡ Speed Settings"
    SettingsTitle.TextColor3 = C.warning
    SettingsTitle.TextSize = 14
    SettingsTitle.Font = Enum.Font.GothamBold
    SettingsTitle.Parent = SettingsPanel

    -- Normal Speed
    local NormalLabel = Instance.new("TextLabel")
    NormalLabel.Size = UDim2.new(1, -20, 0, 20)
    NormalLabel.Position = UDim2.new(0, 10, 0, 40)
    NormalLabel.BackgroundTransparency = 1
    NormalLabel.Text = "Normal Speed:"
    NormalLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    NormalLabel.TextSize = 11
    NormalLabel.Font = Enum.Font.Gotham
    NormalLabel.TextXAlignment = Enum.TextXAlignment.Left
    NormalLabel.Parent = SettingsPanel

    local NormalBox = Instance.new("TextBox")
    NormalBox.Size = UDim2.new(1, -20, 0, 30)
    NormalBox.Position = UDim2.new(0, 10, 0, 62)
    NormalBox.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
    NormalBox.Text = tostring(Settings.SpeedNormal)
    NormalBox.TextColor3 = C.success
    NormalBox.TextSize = 13
    NormalBox.Font = Enum.Font.GothamBold
    NormalBox.ClearTextOnFocus = false
    NormalBox.Parent = SettingsPanel
    Instance.new("UICorner", NormalBox).CornerRadius = UDim.new(0, 6)

    -- Steal Speed
    local StealLabel = Instance.new("TextLabel")
    StealLabel.Size = UDim2.new(1, -20, 0, 20)
    StealLabel.Position = UDim2.new(0, 10, 0, 100)
    StealLabel.BackgroundTransparency = 1
    StealLabel.Text = "Steal Speed:"
    StealLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    StealLabel.TextSize = 11
    StealLabel.Font = Enum.Font.Gotham
    StealLabel.TextXAlignment = Enum.TextXAlignment.Left
    StealLabel.Parent = SettingsPanel

    local StealBox = Instance.new("TextBox")
    StealBox.Size = UDim2.new(1, -20, 0, 30)
    StealBox.Position = UDim2.new(0, 10, 0, 122)
    StealBox.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
    StealBox.Text = tostring(Settings.SpeedSteal)
    StealBox.TextColor3 = C.warning
    StealBox.TextSize = 13
    StealBox.Font = Enum.Font.GothamBold
    StealBox.ClearTextOnFocus = false
    StealBox.Parent = SettingsPanel
    Instance.new("UICorner", StealBox).CornerRadius = UDim.new(0, 6)

    -- Info
    local InfoLabel = Instance.new("TextLabel")
    InfoLabel.Size = UDim2.new(1, -20, 0, 50)
    InfoLabel.Position = UDim2.new(0, 10, 0, 165)
    InfoLabel.BackgroundTransparency = 1
    InfoLabel.Text = "Press Enter to save\nRange: 1-100"
    InfoLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
    InfoLabel.TextSize = 10
    InfoLabel.Font = Enum.Font.Gotham
    InfoLabel.TextWrapped = true
    InfoLabel.Parent = SettingsPanel

    -- TextBox Events
    NormalBox.FocusLost:Connect(function()
        local num = tonumber(NormalBox.Text)
        if num and num >= 1 and num <= 100 then
            Settings.SpeedNormal = num
            SaveSettings()
            TweenService:Create(NormalBox, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(60, 80, 60)}):Play()
            task.wait(0.2)
            TweenService:Create(NormalBox, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(40, 40, 55)}):Play()
        else
            NormalBox.Text = tostring(Settings.SpeedNormal)
        end
    end)

    StealBox.FocusLost:Connect(function()
        local num = tonumber(StealBox.Text)
        if num and num >= 1 and num <= 100 then
            Settings.SpeedSteal = num
            SaveSettings()
            TweenService:Create(StealBox, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(80, 60, 40)}):Play()
            task.wait(0.2)
            TweenService:Create(StealBox, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(40, 40, 55)}):Play()
        else
            StealBox.Text = tostring(Settings.SpeedSteal)
        end
    end)

    -- Settings Toggle
    local settingsVisible = false
    SettingsBtn.MouseButton1Click:Connect(function()
        settingsVisible = not settingsVisible

        TweenService:Create(SettingsBtn, TweenInfo.new(0.3), {
            Rotation = settingsVisible and 45 or 0
        }):Play()

        if settingsVisible then
            SettingsPanel.Visible = true
            SettingsPanel.Size = UDim2.new(0, 160, 0, 0)
            TweenService:Create(SettingsPanel, TweenInfo.new(0.3, Enum.EasingStyle.Back), {
                Size = UDim2.new(0, 160, 0, 220)
            }):Play()
        else
            TweenService:Create(SettingsPanel, TweenInfo.new(0.2), {
                Size = UDim2.new(0, 160, 0, 0)
            }):Play()
            task.delay(0.2, function() SettingsPanel.Visible = false end)
        end
    end)

    -- Minimize
    local isMinimized = false
    MinBtn.MouseButton1Click:Connect(function()
        isMinimized = not isMinimized
        Settings.Minimized = isMinimized
        SaveSettings()

        if isMinimized then
            Container.Visible = false
            SettingsPanel.Visible = false
            TweenService:Create(Main, TweenInfo.new(0.3), {Size = UDim2.new(0, 320, 0, 50)}):Play()
            MinBtn.Text = "+"
        else
            Container.Visible = true
            TweenService:Create(Main, TweenInfo.new(0.3), {Size = UDim2.new(0, 320, 0, 420)}):Play()
            MinBtn.Text = "−"
        end
    end)

    -- Drag System
    local dragging = false
    local dragStart = nil
    local startPos = nil

    Header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = Main.Position
        end
    end)

    Header.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    Header.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    -- Restore saved states
    if Settings.Minimized then
        Container.Visible = false
        Main.Size = UDim2.new(0, 320, 0, 50)
        MinBtn.Text = "+"
    end

    return SG, updateLeft, updateRight, updateDesync, updateSteal, StatusLabel
end

