local function ToggleDesync()
    DesyncEnabled = not DesyncEnabled
    
    if DesyncEnabled then
        local hrp = GetHRP()
        if hrp then TargetServerPosition = hrp.Position end
        
        SetDesync(true)
        FastRespawn()
        
        if ServerPosPart and TargetServerPosition then
            ServerPosPart.CFrame = CFrame.new(TargetServerPosition)
            ServerPosPart.Transparency = 1
            ServerPosHighlight.Visible = true
        end
        
        Connections.Desync = RunService.RenderStepped:Connect(function()
            pcall(function()
                if TargetServerPosition then
                    SendFakePosition(TargetServerPosition)
                end
                local hrp = GetHRP()
                if hrp and ServerPosPart then
                    ServerPosPart.CFrame = CFrame.new(TargetServerPosition or hrp.Position)
                end
            end)
        end)
    else
        SetDesync(false)
        if Connections.Desync then
            Connections.Desync:Disconnect()
            Connections.Desync = nil
        end
        TargetServerPosition = nil
        if ServerPosHighlight then ServerPosHighlight.Visible = false end
    end
    
    return DesyncEnabled
end

