    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
    
    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 12, 0, 12)
    knob.Position = UDim2.new((default - min) / (max - min), -6, 0.5, -6)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.BorderSizePixel = 0
    knob.Parent = track
    
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)
    
    local dragging = false
    
    local function updateSlider(input)
        local pos = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local value = math.floor(min + (max - min) * pos)
        
        fill.Size = UDim2.new(pos, 0, 1, 0)
        knob.Position = UDim2.new(pos, -6, 0.5, -6)
        valueLabel.Text = tostring(value)
        
        callback(value)
        return value
    end
    
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            updateSlider(input)
        end
    end)
    
    track.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            updateSlider(input)
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
    return function(newValue)
        local pos = (newValue - min) / (max - min)
        fill.Size = UDim2.new(pos, 0, 1, 0)
        knob.Position = UDim2.new(pos, -6, 0.5, -6)
        valueLabel.Text = tostring(newValue)
    end
end

--// ==================== [8] SMART CACHE SYSTEM ====================

local CachedPrompts = {}
local LastCacheTime = 0
local CacheInterval = 3

local function UpdatePromptCache()
    local currentTime = tick()
    if currentTime - LastCacheTime < CacheInterval then return end
    LastCacheTime = currentTime
    
    CachedPrompts = {}
    SafeCall(function()
        local plots = Workspace:FindFirstChild("Plots")
        if not plots then return end
        
        for _, plot in pairs(plots:GetChildren()) do
            local podiums = plot:FindFirstChild("AnimalPodiums")
            if podiums then
                for _, podium in pairs(podiums:GetChildren()) do
                    local base = podium:FindFirstChild("Base")
                    local spawn = base and base:FindFirstChild("Spawn")
                    local att = spawn and spawn:FindFirstChild("PromptAttachment")
                    
                    if att then
                        for _, prompt in pairs(att:GetChildren()) do
                            if prompt:IsA("ProximityPrompt") then
                                table.insert(CachedPrompts, prompt)
                            end
                        end
                    end
                end
            end
        end
    end)
end

--// ==================== [9] GALAXY SYSTEM (CACHED MASS) ====================

local galaxyVectorForce = nil
local galaxyAttachment = nil
local spaceHeld = false
local lastHopTime = 0
local cachedMass = 0
local massCalculated = false

local function CalculateMass()
    SafeCall(function()
        local c = LocalPlayer.Character
        if not c then return end
        
        cachedMass = 0
        for _, p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") then
                cachedMass = cachedMass + p:GetMass()
            end
        end
        massCalculated = true
    end)
end

local function SetupGalaxy()
    SafeCall(function()
        local c = LocalPlayer.Character
        if not c then return end
        local h = c:FindFirstChild("HumanoidRootPart")
        if not h then return end
        
        if galaxyVectorForce then galaxyVectorForce:Destroy() end
        if galaxyAttachment then galaxyAttachment:Destroy() end
        
        galaxyAttachment = Instance.new("Attachment")
        galaxyAttachment.Parent = h
        
        galaxyVectorForce = Instance.new("VectorForce")
        galaxyVectorForce.Attachment0 = galaxyAttachment
        galaxyVectorForce.ApplyAtCenterOfMass = true
        galaxyVectorForce.RelativeTo = Enum.ActuatorRelativeTo.World
        galaxyVectorForce.Force = Vector3.new(0, 0, 0)
        galaxyVectorForce.Parent = h
        
        CalculateMass()
    end)
end

local function UpdateGalaxy()
    if not Settings.Galaxy or not galaxyVectorForce or not massCalculated then return end
    
    local targetGravity = workspace.Gravity * (Settings.GalaxyGravityPercent / 100)
    galaxyVectorForce.Force = Vector3.new(0, cachedMass * (workspace.Gravity - targetGravity) * 0.98, 0)
end

local function DoMiniHop()
    if not Settings.Galaxy then return end
    
    SafeCall(function()
        local c = LocalPlayer.Character
        if not c then return end
        local h = c:FindFirstChild("HumanoidRootPart")
        local hum = c:FindFirstChildOfClass("Humanoid")
        if not h or not hum then return end
        
        if tick() - lastHopTime < Settings.GalaxyHopCooldown then return end
        lastHopTime = tick()
        
        if spaceHeld and hum.FloorMaterial == Enum.Material.Air then
            h.AssemblyLinearVelocity = Vector3.new(
                h.AssemblyLinearVelocity.X,
                Settings.GalaxyHopPower,
                h.AssemblyLinearVelocity.Z
            )
        end
    end)
end

--// ==================== [10] ANTI-RUBBERBAND SPEED SYSTEM ====================

local LastPosition = nil
local LastSpeedTime = 0
local VelocitySmooth = Vector3.new(0, 0, 0)
local PositionHistory = {}

local function GetDynamicInterval()
    return math.clamp(1 / (Settings.NormalSpeed / 25), 0.03, 0.15)
end

local function UpdateSpeed()
    if not Settings.SpeedBoost then return end
    
    SafeCall(function()
        local c = LocalPlayer.Character
        if not c then return end
        local h = c:FindFirstChild("HumanoidRootPart")
        local hum = c:FindFirstChildOfClass("Humanoid")
        if not h or not hum then return end
        
        local isStealing = LocalPlayer:GetAttribute("Stealing")
        if isStealing then return end
        
        local md = hum.MoveDirection
        if md.Magnitude < 0.1 then return end
        
        -- Anti-rubberband: Check position jump
        if LastPosition then
            local dist = (h.Position - LastPosition).Magnitude
            if dist > 15 then
                -- Possible rubberband, reduce speed temporarily
                VelocitySmooth = VelocitySmooth * 0.5
            end
        end
        
        -- Calculate target velocity
        local targetSpeed = Settings.NormalSpeed
        local targetVel = Vector3.new(md.X * targetSpeed, h.AssemblyLinearVelocity.Y, md.Z * targetSpeed)
        
        -- Smooth interpolation (Lerp)
        local smoothFactor = Settings.AntiLag and 0.75 or 0.9
        VelocitySmooth = VelocitySmooth:Lerp(targetVel, smoothFactor)
        
        -- Apply with small randomization to avoid pattern detection
        local randomOffset = Vector3.new(
            math.random(-5, 5) * 0.01,
            0,
            math.random(-5, 5) * 0.01
        )
        
        h.AssemblyLinearVelocity = VelocitySmooth + randomOffset
        
        -- Update position history
        local currentTime = tick()
        if currentTime - LastSpeedTime > GetDynamicInterval() then
            LastSpeedTime = currentTime
            LastPosition = h.Position
        end
    end)
end

--// ==================== [11] SMART INVISIBILITY SYSTEM ====================

local InvisibilityConnection = nil
local LastInvisUpdate = 0
local FakePosition = nil
local InvisOffset = Vector3.new(0, 0, 0)

local function SendFakePosition(position)
    SafeCall(function()
        local cf = CFrame.new(position)
        
        -- Try rnet (optional)
        if typeof(rnet) == "table" then
            if rnet.sendphysics then rnet.sendphysics(cf) end
            if rnet.sendposition then rnet.sendposition(position) end
        end
        
        -- Try delta (optional)
        if typeof(delta) == "table" then
            if delta.sendphysics then delta.sendphysics(cf) end
            if delta.sendposition then delta.sendposition(position) end
        end
        
        -- Fallback: Visual only
        if sethiddenproperty then
            sethiddenproperty(LocalPlayer, "SimulationRadius", 0)
        end
    end)
end

local function SetDesync(state)
    SafeCall(function()
        if typeof(rnet) == "table" then
            if rnet.setdesync then rnet.setdesync(state) end
            if rnet.desync then rnet.desync(state) end
        end
        if typeof(delta) == "table" then
            if delta.raknet_desync then delta.raknet_desync(state) end
            if delta.desync then delta.desync(state) end
        end
    end)
end

local function UpdateInvisibility()
    if not Settings.Invisibility then return end
    
    local currentTime = tick()
    if currentTime - LastInvisUpdate < Settings.InvisUpdateRate then return end
    LastInvisUpdate = currentTime
    
    SafeCall(function()
        local c = LocalPlayer.Character
        if not c then return end
        local h = c:FindFirstChild("HumanoidRootPart")
        if not h then return end
        
        -- Dynamic offset for natural movement
        InvisOffset = Vector3.new(
            math.sin(tick() * 1.5) * 1.2,
            math.sin(tick() * 2.3) * 0.5,
            math.cos(tick() * 1.8) * 1.2
        )
        
        FakePosition = h.Position + InvisOffset
        SendFakePosition(FakePosition)
    end)
end

local function StartInvisibility()
    SetDesync(true)
    
    SafeCall(function()
        local c = LocalPlayer.Character
        if c then
            local h = c:FindFirstChild("HumanoidRootPart")
            if h then
                FakePosition = h.Position
                SendFakePosition(FakePosition)
            end
        end
    end)
    
    Notify("FR HUB", "الاختفاء مفعل! 🌫", 3)
end

local function StopInvisibility()
    SetDesync(false)
    FakePosition = nil
    Notify("FR HUB", "الاختفاء متوقف", 2)
end

--// ==================== [12] INSTA STEAL (CACHED) ====================

local function UpdateInstaSteal()
    if not Settings.InstaSteal then return end
    
    UpdatePromptCache()
    
    SafeCall(function()
        for _, prompt in pairs(CachedPrompts) do
            if prompt and prompt.Parent then
                prompt.HoldDuration = 0.01
                prompt.MaxActivationDistance = 12
            end
        end
    end)
end

--// ==================== [13] UNIFIED MAIN LOOP ====================

local MainLoopConnection = nil
local LoopCounter = 0

local function StartMainLoop()
    if MainLoopConnection then return end
    
    MainLoopConnection = RunService.Heartbeat:Connect(function()
        LoopCounter = LoopCounter + 1
        
        -- Speed: Every frame
        if Settings.SpeedBoost then
            UpdateSpeed()
        end
        
        -- Galaxy: Every frame
        if Settings.Galaxy then
            UpdateGalaxy()
            DoMiniHop()
        end
        
        -- Invisibility: Every 2.5 seconds (controlled by UpdateInvisibility)
        if Settings.Invisibility then
            UpdateInvisibility()
        end
        
        -- InstaSteal: Every 10 frames (0.16s at 60fps)
        if LoopCounter % 10 == 0 and Settings.InstaSteal then
            UpdateInstaSteal()
        end
    end)
end

--// ==================== [14] FAILSAFE SYSTEM ====================

local function ResetSystems()
    -- Cleanup Galaxy
    if galaxyVectorForce then
        galaxyVectorForce:Destroy()
        galaxyVectorForce = nil
    end
    if galaxyAttachment then
        galaxyAttachment:Destroy()
        galaxyAttachment = nil
    end
    
    -- Cleanup Invisibility
    SetDesync(false)
    
    -- Reset variables
    massCalculated = false
    cachedMass = 0
    VelocitySmooth = Vector3.new(0, 0, 0)
    LastPosition = nil
    CachedPrompts = {}
end

local function OnCharacterAdded()
    task.wait(0.5)
    
    ResetSystems()
    
    -- Re-initialize active systems
    if Settings.Galaxy then
        SetupGalaxy()
    end
    
    if Settings.Invisibility then
        task.delay(1, StartInvisibility)
    end
end

