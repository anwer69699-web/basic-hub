local function UpdateMode()
    if ModeLabel then ModeLabel.Text = L("mode") .. ": " .. L(ST.SpdMode:lower()) end
    if bModeF then bModeF.Text = L("mode_toggle") .. ": " .. L(ST.SpdMode:lower()) end
end

local PrevSpdMode = "NORMAL"

local function toggleLagger()
    if LAG_ST.LaggerOn then
        stopLagger()
        if ST.SpdMode == "LAGGER" then
            ST.SpdMode = PrevSpdMode
            BX.J.Text = tostring(PrevSpdMode == "LAGGER" and LIMITS.LAGGER_JUMP or LIMITS.NORMAL_JUMP)
            UpdateMode()
        end
        Notify("EXTERNAL HUB", L("lagger_off"), 2, C.RED)
    else
        PrevSpdMode = ST.SpdMode
        ST.SpdMode = "LAGGER"
        BX.J.Text = tostring(LIMITS.LAGGER_JUMP)
        UpdateMode()
        startLagger()
        Notify("EXTERNAL HUB", L("lagger_on"), 2, C.GRN)
    end
    setToggleVisual(LAG_ST.LaggerOn)
end

