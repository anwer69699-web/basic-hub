--// ================= SPEED SYSTEM =================
RunService.Heartbeat:Connect(function()
if not Settings.SpeedBoost then return end

```
local c = LocalPlayer.Character
if not c then return end

local h = c:FindFirstChild("HumanoidRootPart")
local hum = c:FindFirstChildOfClass("Humanoid")
if not h or not hum then return end

local dir = hum.MoveDirection
if dir.Magnitude <= 0 then return end

local isStealing = LocalPlayer:GetAttribute("Stealing")
local speed = isStealing and Settings.StealSpeed or Settings.NormalSpeed

local current = h.AssemblyLinearVelocity

local target = Vector3.new(
    dir.X * speed,
    current.Y,
    dir.Z * speed
)

h.AssemblyLinearVelocity = current:Lerp(target, 0.25)
```

end)

